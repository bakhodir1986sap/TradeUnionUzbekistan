{
  "RateLimiting": {
    "AuthPermitLimit": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
