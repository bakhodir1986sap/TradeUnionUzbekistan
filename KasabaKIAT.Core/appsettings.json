{
  "ConnectionStrings": {
    "DefaultConnection": "Server=REPLACE_SERVER;Database=KasabaKIAT;User Id=REPLACE_USER;Password=REPLACE_PASSWORD;TrustServerCertificate=False;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "KasabaKIAT",
    "Audience": "KasabaKIATApp",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kasaba-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedOrigins": [ "https://REPLACE_WITH_FRONTEND_ORIGIN" ],
  "AllowedHosts": "*"
}
