meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "admin",
    "password": "admin"
  }
}

vars:pre-request {
  baseUrl: http://localhost:5166
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("bearerToken", res.body.token);
  }
}
