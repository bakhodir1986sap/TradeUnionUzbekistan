  <DataSets>
    <DataSet Name="PravsoyuzList">
      <Fields>
        <Field Name="MATCH_DEPARTMENTBASE">
          <DataField>MATCH_DEPARTMENTBASE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProfsoyzNaimenovanie">
          <DataField>ProfsoyzNaimenovanie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>KasabaKIAT</DataSourceName>
        <CommandText>select Prv.MATCH_DEPARTMENTBASE , Prv.ProfsoyzNaimenovanie
from KasabaKIAT_N1.dbo.tbku_StrokaProfsoyza Prv
where Prv.MATCH_DEPARTMENTBASE IS NOT NULL</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="OrganizasiyaList">
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name_Org">
          <DataField>Name_Org</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>KasabaKIAT</DataSourceName>
        <CommandText>SELECT Org.ID, Org.Name_Org 
FROM KasabaKIAT_N1.dbo.tblSprav_Org Org
WHERE Org.DepartmentBase = @departmentBase

UNION

SELECT 0 AS ID, 'Все' Name_Org</CommandText>
        <QueryParameters>
          <QueryParameter Name="@departmentBase">
            <Value>=Parameters!departmentBase.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="SanatoryList">
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name_San">
          <DataField>Name_San</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>KasabaKIAT</DataSourceName>
        <CommandText>SELECT 0 as ID , 'Все' as Name_San

UNION


select ID, Name_San from KasabaKIAT_N1.dbo.tblSprav_San</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
