      <Query>
        <DataSourceName>KasabaKIAT</DataSourceName>
        <CommandText>select 2014 as ID, '2014' as Decode 

UNION

select 2015 as ID, '2015' as Decode 

UNION    

select 2016 as ID, '2016' as Decode 

UNION

select 2017 as ID, '2017' as Decode 

UNION

select 2018 as ID, '2018' as Decode 

UNION

select 2019 as ID, '2019' as Decode 

UNION


select 2020 as ID, '2020' as Decode 
</CommandText>
