    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@departmentBase">
            <Value>=Parameters!departmentBase.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Org.ID, Org.Name_Org 
FROM KasabaKIAT_N1.dbo.tblSprav_Org Org
WHERE Org.DepartmentBase = @departmentBase

UNION

SELECT 0 AS ID, 'Все' Name_Org</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name_Org">
          <DataField>Name_Org</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
