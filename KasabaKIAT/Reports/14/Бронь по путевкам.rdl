  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=HP\SQLEXPRESS; Initial Catalog=KasabaKIAT_N1</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>fcad5f18-ee98-4d80-996e-9af1fa42d67e</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="Name_San">
          <DataField>Name_San</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Num_Put">
          <DataField>Num_Put</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STATUS_BRON">
          <DataField>STATUS_BRON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT   
      San.Name_San
     ,[Num_Put] 
     , CASE WHEN [Uchet] = 1 THEN 'Активна' ELSE 'Возвращена' END AS STATUS_BRON
  FROM [KasabaKIAT_N1].[dbo].[tblBron] bron
  inner join [KasabaKIAT_N1].dbo.tblSprav_San San on bron.[ID_San] = San.ID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
