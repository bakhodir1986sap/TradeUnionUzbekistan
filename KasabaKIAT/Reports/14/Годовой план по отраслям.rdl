          <DataField>QUANTITY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="STATUS">
          <DataField>STATUS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="USER_ID">
          <DataField>USER_ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ProfsoyzNaimenovanie">
          <DataField>ProfsoyzNaimenovanie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MODIFY_DATE">
          <DataField>MODIFY_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT y.[YEAR]
      ,y.[KVARTAL]
      ,s.Name_San 
      ,y.[CAMP_ID]
      ,b.name_ru
      ,y.[REGION_ID]
      ,y.[PRICE]
      ,y.[QUANTITY]
      ,y.[STATUS]
      ,y.[USER_ID]
      ,p.ProfsoyzNaimenovanie
      ,y.[MODIFY_DATE]
  FROM [KasabaKIAT_N1].[dbo].[tbpt_yearlyplanotrasl] y
  inner join [KasabaKIAT_N1].dbo.tblSprav_San s  on y.SANATORIUM_ID = s.id
  inner join [KasabaKIAT_N1].dbo.tbku_StrokaProfsoyza p on y.DEPARTMANT_BASE = p.MATCH_DEPARTMENTBASE
  inner join [KasabaKIAT_N1].dbo.sp_branch b on y.OTRASL_ID = b.id
  where p.MATCH_DEPARTMENTBASE IS NOT NULL AND y.[YEAR] = @GodPlanirovaniya</CommandText>
        <QueryParameters>
          <QueryParameter Name="@GodPlanirovaniya">
            <Value>=Parameters!GodPlanirovaniya.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
