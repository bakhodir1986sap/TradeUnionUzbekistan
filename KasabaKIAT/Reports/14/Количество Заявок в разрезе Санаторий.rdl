    <DataSource Name="KIAT_N1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=HP\SQLEXPRESS; Initial Catalog=KasabaKIAT_N1</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>992465a4-53e7-4193-b6dc-528bd14d178d</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="oblastName">
          <DataField>oblastName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RayonName">
          <DataField>RayonName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FullName">
          <DataField>FullName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PlaceAndPos">
          <DataField>PlaceAndPos</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MedSprevDate">
          <DataField>MedSprevDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ZayavkaDate">
          <DataField>ZayavkaDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SanName">
          <DataField>SanName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="zaezdBegin">
          <DataField>zaezdBegin</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>KIAT_N1</DataSourceName>
        <CommandText>SELECT s.name_ru as oblastName,
	s2.name_ru as RayonName,
	   	   a.FULL_NAME as FullName,
	   a.POSITION as PlaceAndPos,
	   a.MEDICAL_ORDER as MedSprevDate,
	   a.[TIMESTAMP] as ZayavkaDate,
	   c.[Name_San] as SanName ,
	   a.ZAEZD_BEGIN as zaezdBegin
	FROM KasabaKIAT_N1.dbo.tbpt_zayavki a
	LEFT OUTER JOIN KasabaKIAT_N1.dbo.t_departmentbase b 
	on a.DEPARTMENT_CODE = b.CODE
	LEFT OUTER JOIN KasabaKIAT_N1.[dbo].[tblSprav_San] c
	on a.SANATORY_ID = c.id
	LEFT OUTER JOIN KasabaKIAT_N1.dbo.sp_okonx d
	on b.okonx = d.code
	LEFT OUTER JOIN  KasabaKIAT_N1.dbo.sp_branch e
	on d.branch_code = e.[code]
    LEFT OUTER JOIN  KasabaKIAT_N1.dbo.sp_soato s
	on SUBSTRING(b.soato_code, 1 , 4) = s.[code]
	    LEFT OUTER JOIN  KasabaKIAT_N1.dbo.sp_soato s2
	on SUBSTRING(b.soato_code, 1 , 7) = s2.[code]
	WHERE CONVERT(DATE,a.[TIMESTAMP]) BETWEEN CONVERT(DATE,@beginDate)  AND CONVERT(DATE,@endDate)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@beginDate">
            <Value>=Parameters!beginDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endDate">
            <Value>=Parameters!endDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
