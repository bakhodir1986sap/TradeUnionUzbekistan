    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=HP\SQLEXPRESS;Initial Catalog=KasabaKIAT_N1</ConnectString>
        <Prompt>Specify a user name and password for data source DataSource1.</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>ad4c7c4a-e65b-49b4-889b-95ab8cb30dce</rd:DataSourceID>
      <rd:SecurityType>DataBase</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="OblastRayonOtrasl">
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="PAYMENT_ID">
          <DataField>PAYMENT_ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="PROFSOUZ_AMT">
          <DataField>PROFSOUZ_AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="FEDERATION_AMT">
          <DataField>FEDERATION_AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OBLSOVPROF_AMT">
          <DataField>OBLSOVPROF_AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OBL_DEPARTMENT_BASE">
          <DataField>OBL_DEPARTMENT_BASE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PROVODKA_ID">
          <DataField>PROVODKA_ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="REMARK">
          <DataField>REMARK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INN">
          <DataField>INN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="KODI">
          <DataField>KODI</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="otraslName">
          <DataField>otraslName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OBLAST_NAME">
          <DataField>OBLAST_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TUMAN_NAME">
          <DataField>TUMAN_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select AA1.[ID]
	   ,AA1.[PAYMENT_ID]
	   ,AA1.[PROFSOUZ_AMT]
	   ,AA1.[FEDERATION_AMT]
	   ,AA1.[OBLSOVPROF_AMT]
	   ,AA1.[OBL_DEPARTMENT_BASE]
	   ,AA1.[PROVODKA_ID]
	   ,AA1.[REMARK]   
	   ,AA1.INN  
	   ,AA1.KODI
       ,AA1.otraslName
       ,AA1.OBLAST_NAME
       ,AA1.TUMAN_NAME
 from (
select AA.[ID]
      ,AA.[PAYMENT_ID]
      ,AA.[PROFSOUZ_AMT]
      ,AA.[FEDERATION_AMT]
      ,AA.[OBLSOVPROF_AMT]
      ,AA.[OBL_DEPARTMENT_BASE]
      ,AA.[PROVODKA_ID]
      ,AA.[REMARK]   
      ,AA.INN  
      ,ss.KODI
      , CASE WHEN bb.name_ru  IS NULL THEN 'Ne Opredelen' ELSE bb.name_ru END  as otraslName
      , CASE WHEN ss.KODI IS NULL THEN ss1.NAME_LN ELSE ss2.NAME_LN END AS OBLAST_NAME
      , CASE WHEN ss.KODI IS NULL THEN ss1.CENTRE_NAME_LN ELSE ss.NAME_LN END AS TUMAN_NAME
  from 
(select CASE WHEN REMARK like '%SOATO%' THEN 
                                       CASE WHEN REMARK like '%PROBLEM%' THEN SUBSTRING(REMARK, 19, 7)
                                           WHEN REMARK not like '%PROBLEM%' THEN SUBSTRING(REMARK, 21, 7) END 
            ELSE CASE WHEN OBL_DEPARTMENT_BASE = '' then '17' else OBL_DEPARTMENT_BASE end END   AS SOATO_CODE,
        CASE WHEN REMARK like '%INN%' THEN CASE WHEN REMARK like '%INN:PROBLEM%' THEN '000000000'
                                           WHEN REMARK not like '%PROBLEM%' THEN SUBSTRING(REMARK, 5, 9) END  
             ELSE '000000000' END INN  ,                                
            [ID]
      ,[PAYMENT_ID]
      ,[PROFSOUZ_AMT]
      ,ABS([FEDERATION_AMT]) AS FEDERATION_AMT
      ,ABS([OBLSOVPROF_AMT]) AS OBLSOVPROF_AMT
      ,[OBL_DEPARTMENT_BASE]
      ,[PROVODKA_ID]
      ,[REMARK]                          
from dbo.tbbu_ecp_calc 
) AA
left outer  join dbo.tbsp_soato_new ss on aa.SOATO_CODE = ss.KODI
left outer  join dbo.tbsp_soato_new ss1 on substring(aa.SOATO_CODE, 1 ,2) + substring(aa.SOATO_CODE, 4 ,2) = ss1.KODI
left outer  join dbo.tbsp_soato_new ss2 on substring(ss.KODI, 1 ,4)  = ss2.KODI
LEFT OUTER JOIN (select EE1.INN ,  MAX(EE1.OKONX_ID) AS OKONX
					from dbo.t_egrpo EE1
					GROUP BY EE1.INN ) EE on EE.INN = AA.[INN]
LEFT OUTER JOIN dbo.sp_okonx oo on oo.code = EE.OKONX
LEFT OUTER JOIN dbo.sp_branch bb  on bb.code = oo.branch_code ) aa1
inner join dbo.KaznaPaymentFile kk on kk.ID  = aa1.PAYMENT_ID 
where 
CONVERT(DATE,kk.[OPERDAY]) BETWEEN CONVERT(DATE,@BEGIN_DATE)  AND CONVERT(DATE,@END_DATE)

</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BEGIN_DATE">
            <Value>=Parameters!BEGIN_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
