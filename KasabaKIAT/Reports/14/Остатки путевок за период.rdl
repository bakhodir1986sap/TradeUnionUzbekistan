  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="ProfsoyzNaimenovanie">
          <DataField>ProfsoyzNaimenovanie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name_San">
          <DataField>Name_San</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Num_Put">
          <DataField>Num_Put</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Symma_Put">
          <DataField>Symma_Put</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT prav.[ProfsoyzNaimenovanie]
      , San.Name_San
      ,post.Num_Put
      ,post.[Symma_Put]
  FROM [KasabaKIAT_N1].[dbo].[tblPos_Put] post
  inner join [KasabaKIAT_N1].[dbo].[tbku_StrokaProfsoyza]  prav
  on post.Departmentbase = prav.[MATCH_DEPARTMENTBASE]
  inner join [KasabaKIAT_N1].dbo.tblSprav_San San on post.[ID_Sanat] = San.ID
  WHERE [ID_PolVoz] = 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
