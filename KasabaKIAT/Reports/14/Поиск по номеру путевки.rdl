<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=HP\SQLEXPRESS; Initial Catalog=KasabaKIAT_N1</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>b10c837f-69e7-4fb4-8571-a9124b54c37c</rd:DataSourceID>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="ProfsoyzNaimenovanie">
          <DataField>ProfsoyzNaimenovanie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name_San">
          <DataField>Name_San</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Num_Put">
          <DataField>Num_Put</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Symma_Put">
          <DataField>Symma_Put</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Operasiya">
          <DataField>Operasiya</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT prav.[ProfsoyzNaimenovanie]
      , San.Name_San
      ,post.Num_Put
      ,post.[Symma_Put]
      , 'Приход' as Operasiya
  FROM [KasabaKIAT_N1].[dbo].[tblPos_Put] post
  inner join [KasabaKIAT_N1].[dbo].[tbku_StrokaProfsoyza]  prav
  on post.Departmentbase = prav.[MATCH_DEPARTMENTBASE]
  inner join [KasabaKIAT_N1].dbo.tblSprav_San San on post.[ID_Sanat] = San.ID
  WHERE post.Num_Put = @Num_Put
  
  UNION 
  
  
        select 
      prav.[ProfsoyzNaimenovanie]
      , San.Name_San
      ,post.[SERAIL_NUMBER]
      ,post.[PRICE]
      , 'Реализация' as Operasiya
  FROM [KasabaKIAT_N1].[dbo].[tbpt_putyovkarealizasiya] post
    inner join [KasabaKIAT_N1].[dbo].[tbku_StrokaProfsoyza]  prav
  on post.[DEPARTMENT_CODE] = prav.[MATCH_DEPARTMENTBASE]
  inner join [KasabaKIAT_N1].dbo.tblSprav_San San on post.[SANATORIUM_ID] = San.ID
  WHERE post.[SERAIL_NUMBER] = @Num_Put
  
  
  UNION
  
     SELECT   
      ''  as ProfsoyzNaimenovanie
     , San.Name_San
     ,[Num_Put] 
     , 0 as SUMMA
     , 'Брон' as Operasiya
  FROM [KasabaKIAT_N1].[dbo].[tblBron] bron
  inner join [KasabaKIAT_N1].dbo.tblSprav_San San on bron.[ID_San] = San.ID
  WHERE bron.Num_Put = @Num_Put</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Num_Put">
            <Value>=Parameters!Num_Put.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
