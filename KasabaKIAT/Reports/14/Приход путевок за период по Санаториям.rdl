      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT s.[SchetFactura_ID]
      ,s.[SanatoryKod]
      ,s.[SanatoryNaimenovanie]
      ,s.[SanatoryRazmeshenieKod]
      ,s.[SanatoryRazmeshenieNaimenovanie]
      ,s.[SanatoryType]
      ,s.[DataZaezda]
      ,s.[Blank1]
      ,s.[Blank2]
      ,s.[Kolichestvo]
      ,s.[Sebestoimost]
      ,s.[SummaSebestoimosti]
      ,s.[ProcentNacenki]
      ,s.[Cena]
      ,s.[Summa]
      ,p.ProfsoyzNaimenovanie
  FROM [KasabaKIAT_N1].[dbo].[tbku_DocumentSchetFaktura] d
  inner join [KasabaKIAT_N1].dbo.tbku_StrokaSchetFakturi s on d.ID = s.SchetFactura_ID
  inner join [KasabaKIAT_N1].dbo.tbku_StrokaProfsoyza p    on p.ProfsoyzKod = d.ProfsoyzKod
  WHERE p.MATCH_DEPARTMENTBASE IS NOT NULL AND 
  CONVERT(DATE,d.[DocData]) BETWEEN CONVERT(DATE,@beginDate)  AND CONVERT(DATE,@endDate)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@beginDate">
            <Value>=Parameters!beginDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endDate">
            <Value>=Parameters!endDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
