  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="ProfsoyzNaimenovanie">
          <DataField>ProfsoyzNaimenovanie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PLATELRSCH">
          <DataField>PLATELRSCH</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLUCHRSCH">
          <DataField>POLUCHRSCH</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUMMA">
          <DataField>SUMMA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 
      prav.[ProfsoyzNaimenovanie]
     ,pp.[PLATELRSCH] 
      ,pp.[POLUCHRSCH]
      ,pp.[SUMMA]
  FROM [KasabaKIAT_N1].[dbo].[tbbu_provodki] pp
  inner join [KasabaKIAT_N1].[dbo].[tbku_StrokaProfsoyza]  prav
  on pp.[DEPARTMENT_BASE] = prav.[MATCH_DEPARTMENTBASE]
  WHERE CONVERT(DATE,pp.[TRDT]) BETWEEN CONVERT(DATE,@beginDate)  AND CONVERT(DATE,@endDate)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@beginDate">
            <Value>=Parameters!beginDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endDate">
            <Value>=Parameters!endDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
