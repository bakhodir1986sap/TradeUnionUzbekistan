@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Администрирование";
}
  <section class="content__block container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Администрирование</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="list-group r-list-group mb-4 box-shadow">
                @if (List.SozdaniyaUchetnixZapisey)
                {
                    <a href="/Administirirovaniye/UchetniyZapis" class="list-group-item list-group-item-action load">Пользователи</a>
                }
                @if (List.SozdaniyaRoley)
                {
                    <a href="/Administirirovaniye/SozdaniyeRoley" class="list-group-item list-group-item-action load">Ролей</a>
                }
                @if (List.SozdaniyaProvodok)
                {
                    <a href="/Administirirovaniye/SozdaniyeProvodok" class="list-group-item list-group-item-action load">Создание проводок</a>
                }
                @if (List.PrivyazkaProvodokkJO)
                {
                    <a href="/Administirirovaniye/PrivyazkaProvodok" class="list-group-item list-group-item-action load">Привязка проводок к ЖО</a>
                }
                @if (List.UpravleniyaSpravochnikami)
                {
                    <a href="/Administirirovaniye/Spravichniki" class="list-group-item list-group-item-action load">Справочники СКУ</a>
                    <a href="/Administirirovaniye/SpravichnikiKurortnovoUpravleniya" class="list-group-item list-group-item-action load">Справочник с курортного управления</a>
                }
            </div>
        </div>
    </div>
</section>
