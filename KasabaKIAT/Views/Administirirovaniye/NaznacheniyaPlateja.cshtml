
@{
    ViewBag.Title = "Справочники назначения платежа";
}
<script src="~/Scripts/MyJavaScript/SNPController.js"></script>
<h2>Справочники назначения платежа</h2>
<div ng-controller="SNPController">
    <div class="container one">
        <div class="row" style="margin-left:400px;">
            <div class="col-xs-3 col-xs-offset-5">
                <button ng-click="AddSNPDiv()" style="background: #24C0DB;margin-right:10px" type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal"><i class="fa fa-plus-square" aria-hidden="true"></i>  добавить</button>
            </div>
        </div>
    </div>
    <div class="container two">
        <div class="row" style="margin-top:30px;">
            <table class="table table-hover" style="width:30%">
                <thead>
                    <tr>
                        <th>тип мест</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in SNP" ng-click="editSNP(item)" data-toggle="modal" data-target="#myModal" class="poin">
                        <td>{{item.NAME_UZ}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title text-center" id="myModalLabel">{{Action}}</h4>
                </div>
                <form class="modal-body" name="myForm" novalidate>
                    <input type="hidden" style="position:absolute" ng-model="ID;" />
                    <br />
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Тип размещения:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" class="form-control" required placeholder="" name="PTI" ng-model="PTI" value="">
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.PTI.$error.required">заполнить поля</span>
                        </div>
                    </div>
                    <br>
                    <div class="modal-footer">
                        <div class="col-xs-offset-5">
                            <button type="button" ng-click="AddUpdateSNP()" ng-disabled="myForm.PTI.$error.required" data-dismiss="modal" class="btn btn-info"><i class="fa fa-save" aria-hidden="true"></i> сохранить</button>
                            <button type="button" ng-click="deleteSNP(ID)" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-remove" aria-hidden="true"></i> Удалить</button>
                            <button type="button" class="btn btn-default" data-dismiss="modal">отмена</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div> <!-- modal fade -->
</div>
