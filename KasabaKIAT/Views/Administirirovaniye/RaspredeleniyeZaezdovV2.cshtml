@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using KasabaKIAT.BusinessLogic.Utils.References
@using KasabaKIAT.BusinessLogic.Utils
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Распределение Заездов";
}
<script type="text/javascript">
    function yearChange() {
        var state = document.getElementById('sanatory').ej2_instances[0];

        var country = document.getElementById('year').ej2_instances[0];
        // disable the state DropDownList
        state.enabled = true;

        // frame the query based on selected value in country DropDownList.
        var tempQuery = new ej.data.Query().where('searchParam1', 'equal', country.value);
        // set the framed query based on selected value in country DropDownList.
        state.query = tempQuery;
        // set null value to state DropDownList text property
        state.text = null;
        state.data = null;
        // bind the property changes to state DropDownList
        state.dataBind();
    }
</script>
@*<script src="~/Scripts/MyJavaScript/RaspredeleniyeZaezdov.js"></script>*@
@if (List.UpravleniyaSpravochnikami)
{
<section class="content__block container-fluid">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Годовой план</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Годовой план</li>
                </ol>
            </nav>
        </div>
    </div>
    @using (Html.BeginForm("GetRaspredeleniyeData", "Administirirovaniye", FormMethod.Get))
    {
    <div class="row mb-4 align-items-center">
        <div class="custom-control-inline" style="margin-left:20px">
            <div>
                <p>Период:</p>
                @Html.EJS().ComboBox("year").Placeholder("Выберите год").PopupHeight("230px").Index(0).Change("yearChange").DataSource((IEnumerable<Years>
                  )ViewBag.YearsList).Fields(new ComboBoxFieldSettings { Text = "year_id", Value = "year_str" }).Render()
            </div>
        </div>
        <div style="margin-left:100px">
            <p>Санаторий:</p>
            @Html.EJS().ComboBox("sanatory").Placeholder("Выберите санаторий").Enabled(false).AllowCustom(false).PopupHeight("auto").DataSource((IEnumerable<CodeDecode>)ViewBag.SanatoryList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).Render()
        </div>
        <div style="margin-left:160px">
            <p></p>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
        </div>
       
    </div>
    }
        <div class="row mb-5 pb-md-5">
            <div class="col-md-12">
                @Html.EJS().Grid("raspredeleniyeMain").DataSource((IEnumerable<object>)ViewBag.RaspredeleniyeMainList).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=> {
                col.Field("SanatoryNaimenovanie").HeaderText("Наименование санатория").Width("50").AllowEditing(false).Add();
                col.Field("SanatoryProfil").HeaderText("Профиль").Width("50").Add();
                col.Field("SanatoryOblast").HeaderText("Область").Width("30").Add();
                col.Field("SanatoryKoekVsego").HeaderText("Коек Всего").Width("10").Add();
                col.Field("SanatoryKoekLetom").HeaderText("Коек Летом").Width("10").Add();
                col.Field("SanatoryKoekZimoy").HeaderText("Коек Зимой").Width("10").Add();
                col.Field("SanatoryRazmeshenieNaimenovanie").HeaderText("Наименование размешения").Width("50").Add();
                col.Field("Putevok1kv").HeaderText("1 кв").Width("10").Add();
                col.Field("Putevok2kv").HeaderText("2 кв").Width("10").Add();
                col.Field("Putevok3kv").HeaderText("3 кв").Width("10").Add();
                col.Field("Putevok4kv").HeaderText("4 кв").Width("10").Add();
                }).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
                    () { "ExcelExport" }).Render()
                <script>
                    function toolbarClick(args) {
                        var gridObj = document.getElementById("raspredeleniyeMain").ej2_instances[0];
                        if (args.item.id === 'raspredeleniyeMain_excelexport') {
                            gridObj.excelExport();
                        }
                    }
                </script>
            </div>
            <div class="col-md-12">
                @Html.EJS().Grid("raspredeleniyeDetail").DataSource((IEnumerable<object>)ViewBag.RaspredeleniyeDetailList).AllowExcelExport().ToolbarClick("toolbarClick2").Columns(col=> {
               col.Field("ID").HeaderText("ИД").IsPrimaryKey(true).AllowEditing(false).Width("5").AllowEditing(false).Add();
               col.Field("GodZaezdov").HeaderText("Год").Width("4").Add();
               col.Field("SanatoryKod").HeaderText("Код Санатория").Width("10").Add();
               col.Field("ProfsoyzKod").HeaderText("Код Профсоюз").Width("10").Add();
               col.Field("ProfsoyzNaimenovanie").HeaderText("Наименование Профосюз").Width("15").Add();
               col.Field("SanatoryRazmeshenieKod").HeaderText("Код Размещения").Width("10").Add();
               col.Field("SanatoryRazmeshenieNaimenovanie").HeaderText("Наименование Размещения").Width("10").Add();
               col.Field("Putevok1kv").HeaderText("1 кв").Width("10").Add();
               col.Field("Putevok2kv").HeaderText("2 кв").Width("10").Add();
               col.Field("Putevok3kv").HeaderText("3 кв").Width("10").Add();
               col.Field("Putevok4kv").HeaderText("4 кв").Width("10").Add();
           }).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).EditSettings(edit => { edit.AllowAdding(true).AllowEditing(true).AllowDeleting(true).ShowDeleteConfirmDialog(true).Mode(Syncfusion.EJ2.Grids.EditMode.Dialog); }).Toolbar(new List<string>
            () { "Add", "Edit", "Delete", "ExcelExport" }).Render()
                <script>
                    function toolbarClick2(args) {
                        var gridObj = document.getElementById("raspredeleniyeDetail").ej2_instances[0];
                        if (args.item.id === 'raspredeleniyeDetail_excelexport') {
                            gridObj.excelExport();
                        }
                    }
                </script>
            </div>
        </div>
</section>
}

