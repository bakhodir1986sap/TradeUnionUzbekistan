@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    ViewBag.Title = "Администрирование";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/SchetFaktura.js"></script>
@if (List.UpravleniyaSpravochnikami)
{
    <section class="content__block container" ng-controller="SchetFaktura">
        <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
            <img src="~/Content/Login/buffering.gif" />
        </div>
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Накладные счет-фактуры</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        @*<li class="breadcrumb-item load"><a href="/Home/Admin">Администрирование</a></li>*@
                        <li class="breadcrumb-item load"><a href="/Administirirovaniye/index">Администрирование</a></li>
                        <li class="breadcrumb-item load"><a href="/Administirirovaniye/SpravichnikiKurortnovoUpravleniya">Накладные счет-фактуры</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Счет фактура</li>
                    </ol>
                </nav>
            </div>
        </div>
        <form class="row mb-4 align-items-center" name="myForm1" novalidate>
            <div class="custom-control-inline" style="margin-left:20px">
                <div>
                    <p>Список профсоюзов:</p>
                    <select style="width:200px" ng-model="SP" name="SP" required ng-options="d as d.d2 for d in R track by d.d1" class="custom-select form-control"></select>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.SP.$error.required">Выберите поле</span>
                </div>
            </div>
            <div style="margin-left:100px">
                <p>Период с:</p>
                <input class="form-control" style="width:200px;" required type="date" ng-model="ZB" id="ZAEZD_BEGIN" name="ZAEZD_BEGIN" />
                <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.ZAEZD_BEGIN.$error.required">Выберите поле</span>
            </div>
            <div style="margin-left:100px">
                <p>Период по:</p>
                <input class="form-control" style="width:200px;" required type="date" ng-model="ZE" id="ZAEZD_END" name="ZAEZD_END" />
                <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.ZAEZD_END.$error.required">Выберите поле</span>
            </div>
            <div style="margin-left:20px">
                <button ng-click="LoadDATA()" ng-disabled="myForm1.SP.$error.required||myForm1.ZAEZD_BEGIN.$error.required||myForm1.ZAEZD_END.$error.required" class="btn btn-blue d-block d-md-inline-block mb-2" style="margin-top:45px"> Получить</button>
            </div>
            <div style="margin-left:20px">
                <button ng-show="showdata" ng-click="OPRIXDATA()" ng-disabled="myForm1.SP.$error.required||myForm1.ZAEZD_BEGIN.$error.required||myForm1.ZAEZD_END.$error.required" class="btn btn-blue d-block d-md-inline-block mb-2" style="margin-top:45px"> Оприходовать</button>
            </div>
        </form>
        <div class="row mb-5 pb-md-5" ng-show="showdata">
            <div class="col-md-12">
                <div class="table__title mb-3">
                    <div class="row mb-4 align-items-center">
                        <div style="margin-left:50px">
                            <h6>Документ Счет фактуры</h6>
                        </div>
                        <div style="margin-left:690px;">
                            <button class="btn btn-green d-block d-md-inline-block mb-2" ng-click="exportData1()">
                                <i class="fas fa-file-excel"></i>  ЭКСПОРТ
                            </button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive box-shadow mb-4" id="export1">
                    <table class="table table__block t-hover">
                        <thead>
                            <tr>
                                <th class="dropdown dropdown__table">Номер документа</th>
                                <th class="dropdown dropdown__table">Дата документа</th>
                                <th class="dropdown dropdown__table">Флаг</th>
                                <th class="dropdown dropdown__table">Договор</th>
                                <th class="dropdown dropdown__table">Дата путевок</th>
                                <th class="dropdown dropdown__table">Доверенность</th>
                                <th class="dropdown dropdown__table">Дата Доверенности</th>
                                <th class="dropdown dropdown__table">Кому выдан дов</th>
                                <th class="dropdown dropdown__table">Сумма Документа</th>
                                <th class="dropdown dropdown__table">Процент Наценки</th>
                                <th class="dropdown dropdown__table">Сумма Наценки</th>
                                <th class="dropdown dropdown__table">Количество Путевок</th>
                                <th class="dropdown dropdown__table">Товар отпустил</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in DATA" ng-click="LoadStrokaSchetFakturi(item.d0)">
                                <td>{{item.d1}}</td>
                                <td>{{item.d2 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d3}}</td>
                                <td>{{item.d4}}</td>
                                <td>{{item.d5 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d6}}</td>
                                <td>{{item.d7 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d8}}</td>
                                <td>{{item.d9}}</td>
                                <td>{{item.d10}}</td>
                                <td>{{item.d11}}</td>
                                <td>{{item.d12}}</td>
                                <td>{{item.d13}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12" ng-show="showdata2">
                <div class="table__title mb-3">
                    <div class="row mb-4 align-items-center">
                        <div style="margin-left:50px">
                            <h6>Детали счет фактуры</h6>
                        </div>
                        <div style="margin-left:710px;">
                            <button class="btn btn-green d-block d-md-inline-block mb-2" ng-click="exportData2()">
                                <i class="fas fa-file-excel"></i>  ЭКСПОРТ
                            </button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive box-shadow mb-4" id="export2">
                    <table class="table table__block t-hover">
                        <thead>
                            <tr>
                                <th class="dropdown dropdown__table">Санаторий</th>
                                <th class="dropdown dropdown__table">Размещение</th>
                                <th class="dropdown dropdown__table">Тип Санатория</th>
                                <th class="dropdown dropdown__table">Дата заезда</th>
                                <th class="dropdown dropdown__table">Номер с</th>
                                <th class="dropdown dropdown__table">Номер по</th>
                                <th class="dropdown dropdown__table">Количество</th>
                                <th class="dropdown dropdown__table">Себестоимость</th>
                                <th class="dropdown dropdown__table">Сумма Себестоимоси</th>
                                <th class="dropdown dropdown__table">Процент Наценки</th>
                                <th class="dropdown dropdown__table">Цена</th>
                                <th class="dropdown dropdown__table">Сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in DATA2">
                                <td>{{item.d2}}</td>
                                <td>{{item.d3}}</td>
                                <td>{{item.d4}}</td>
                                <td>{{item.d5 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d6}}</td>
                                <td>{{item.d7}}</td>
                                <td>{{item.d8}}</td>
                                <td>{{item.d9}}</td>
                                <td>{{item.d10}}</td>
                                <td>{{item.d11}}</td>
                                <td>{{item.d12}}</td>
                                <td>{{item.d13}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
}

