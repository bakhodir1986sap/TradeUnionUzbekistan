@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Администрирование";
}
<script src="~/Scripts/MyJavaScript/SPController.js"></script>
@if (List.SozdaniyaProvodok)
{
    <div ng-controller="SPController">
        <section class="content__block container">
            <div class="row mb-4 align-items-center">
                <div class="col-sm-6 title__block">
                    <h4>Создание проводок</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item load"><a href="/Home/Admin">Администрирование</a></li>
                            <li class="breadcrumb-item load"><a href="/Administirirovaniye/index">Администрирование</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Создание проводок</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-sm-6 text-md-right">
                    <a href="#" ng-click="AddSPDiv()" class="btn btn-blue d-block d-md-inline-block mb-3 mb-md-0" data-toggle="modal" data-target="#dobavit"><i class="fas fa-plus"></i> Добавить</a>
                    <button ng-show="showdata" ng-click="exportData()" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0"><i class="fas fa-file-excel"></i> Экспорт</button>
                </div>
            </div>
            <div ng-show="showdata" class="table-responsive box-shadow mb-4" id="export">
                <table class="table table__block t-hover">
                    <thead>
                        <tr>
                            @*<th class="dropdown dropdown__table" style="width:200px;text-align:center"><input type="text" style="text-align:center" class="form-control" ng-model="s1" placeholder="Организация" /></th>*@
                            <th class="dropdown dropdown__table" style="width:200px;text-align:center"><input type="text" style="text-align:center" class="form-control" ng-model="s2" placeholder="Счет д-т" /></th>
                            <th class="dropdown dropdown__table" style="width:200px;text-align:center"><input type="text" style="text-align:center" class="form-control" ng-model="s3" placeholder="Счет к-т" /></th>
                            <th class="dropdown dropdown__table" style="width:200px;text-align:center"><input type="text" style="text-align:center" class="form-control" ng-model="s4" placeholder="Описание" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in SP | filter:s1 | filter:s2 | filter:s3 | filter:s4" ng-click="editSP(item)" data-toggle="modal" data-target="#dobavit">
                            @*<td style="width:200px;text-align:center">{{item.O}}</td>*@
                            <td style="width:200px;text-align:center">{{item.SB}}</td>
                            <td style="width:200px;text-align:center">{{item.SE}}</td>
                            <td style="width:200px;text-align:center">{{item.D}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="modal-title">
                            <h4 class="text-center mt-4 mb-4">{{Action}}</h4>
                        </div>
                        <div class="row justify-content-center">
                            <form class="col-md-8" name="myForm" novalidate>
                                <input type="hidden" style="position:absolute" ng-model="ID;" />
                                @*<div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Инн:</label>
                                    <div class="col-md-7">
                                        <input type="text" required class="form-control" name="INN" ng-minlength="9" ng-maxlength="9" ng-model="INN" ng-change="LoadINN()" />
                                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm.INN.$error.required">заполнить поле</span>
                                        <span class="alert alert-warning" style="padding:0px" ng-show="!myForm.INN.$error.required&&!myForm.INN.$valid">9 шт. номер</span>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Организация:</label>
                                    <div class="col-md-7">
                                        <label name="O" ng-model="O">{{O}}</label>
                                    </div>
                                </div>*@
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Счет д-т:</label>
                                    <div class="col-md-7">
                                        <input type="text" class="form-control" required placeholder="" name="SB" ng-model="SB" value="">
                                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm.SB.$error.required">заполнить поле</span>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Счет к-т:</label>
                                    <div class="col-md-7">
                                        <input type="text" class="form-control" required placeholder="" name="SE" ng-model="SE" value="">
                                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm.SE.$error.required">заполнить поле</span>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Описание:</label>
                                    <div class="col-md-7">
                                        <input type="text" class="form-control" required placeholder="" name="D" ng-model="D" value="">
                                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm.D.$error.required">заполнить поле</span>
                                    </div>
                                </div>
                                <div class="mb-4 text-right">
                                    <button data-dismiss="modal" ng-click="AddUpdateSP()" ng-disabled="myForm.SB.$error.required||myForm.SE.$error.required||myForm.D.$error.required" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                    <button ng-click="deleteSP(ID)" ng-show="showdelete" data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</button>
                                    <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


