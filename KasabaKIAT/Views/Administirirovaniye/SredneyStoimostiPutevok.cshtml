@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Администрирование";
}
<script src="~/Scripts/MyJavaScript/SSSPController.js"></script>
@if (List.UpravleniyaSpravochnikami)
{
    <div ng-controller="SSSPController">
        <section class="content__block container-fluid">
            <div class="row mb-4 align-items-center">
                <div class="col-sm-6 title__block">
                    <h4>Средняя стоимость путевок</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb" style="width:1000px">
                            <li class="breadcrumb-item load"><a href="/Administirirovaniye/index">Администрирование</a></li>
                            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">справочники</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Средняя стоимость путевок</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-sm-6 text-md-right">
                    <a href="#" ng-click="AddSSSPDiv()" class="btn btn-blue d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#dobavit"><i class="fas fa-plus"></i> Добавить</a>
                </div>
            </div>
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover">
                    <thead>
                        <tr>
                            <th class="dropdown dropdown__table">Стоимость</th>
                            <th class="dropdown dropdown__table">Дата</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in SSSP" ng-click="editSSSP(item)" data-toggle="modal" data-target="#dobavit">
                            <td>{{item.A}}</td>
                            <td>{{item.ST | jsonDate: 'dd.MM.yyyy'}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="modal-title">
                            <h4 class="text-center mt-4 mb-4">{{Action}}</h4>
                        </div>
                        <div class="row justify-content-center">
                            <form class="col-md-8" name="myForm" novalidate>
                                <input type="hidden" style="position:absolute" ng-model="ID;" />
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Стоимость:</label>
                                    <div class="col-md-7">
                                        <input type="text" class="form-control" required placeholder="" name="A" ng-model="A" value="">
                                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm.A.$error.required">заполнить поле</span>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label text-md-right py-0">Дата:</label>
                                    <div class="col-md-7">
                                        <input class="form-control" type="date" ng-model="ST" id="ST" name="ST" />
                                    </div>
                                </div>
                                <div class="mb-4 text-right">
                                    <button data-dismiss="modal" ng-click="AddUpdateSSSP()" ng-disabled="myForm.A.$error.required" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                    <button ng-click="deleteSSSP(ID)" ng-show="showdelete" data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</button>
                                    <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

