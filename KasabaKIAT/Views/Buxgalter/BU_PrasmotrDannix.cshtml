@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    ViewBag.Title = "Бухгалтерия";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/BU_PrasmotrDannix.js"></script>
@if (List.PrasmotrDannix)
{
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid" ng-controller="BU_PrasmotrDannix">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Просмотр данных</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Buxgalter/Index">Бухгалтерия</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Просмотр данных</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="mb-5">
            <div class="row align-items-center mb-5">
                <div class="col-md-6 form-group">
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Год</label>
                            <select class="custom-select form-control" ng-model="SelectedYear" ng-options="item as item.Year for item in Years track by item.Id" ng-change="FiltersChanged()"></select>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Квартал</label>
                            <select class="custom-select form-control" ng-model="SelectedKvartal" ng-options="item as item.Name_Kv for item in Kvartals track by item.ID" ng-change="FiltersChanged()"></select>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 form-group">
                    <div class="row">
                    </div>
                </div>
            </div>
            <div class="row mb-5">
                <div class="col-md-3 form-group">
                    <label>Плательщик ИНН:</label>
                        <input type="text" class="form-control" ng-model="Inn"/>
                    <div class="text__block">
                    </div>
                </div>
                <div class="col-md-3 form-group">
                    <label>Номер счета:</label>
                        <input type="text" class="form-control" ng-model="Account"/>
                    <div class="text__block">
                    </div>
                </div>
            </div>
            <div class="mb-5">
                <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#dobavit" ng-click="GetData()">Показать</a>
                <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2">Очистить фильтр</a>
            </div>
        </div>
        <div class="table-responsive box-shadow mb-5">
            <table class="table table__block va-top t-scroll">
                <thead>
                    <tr>
                        <th>№ док.</th>
                        <th>Информация плательщика</th>
                        <th>Дата п-жа</th>
                        <th>Название </th>
                        <th>Сумма п-жа</th>
                        <th>Инофрмация получателя</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in DATA">
                        <td>{{item.d1}}</td>
                        <td>{{item.d2}}<br /> ИНН: {{item.d3}} <br /> МФО: {{item.d4}}<br /> Рас. счет: {{item.d5}}</td>
                        <td>{{item.d6 | jsonDate: 'dd.MM.yyyy'}}</td>
                        <td>{{item.d12}}</td>
                        <td>{{item.d8}}</td>
                        <td>{{item.d9}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
}

