@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
    ViewBag.Title = "Бухгалтерия";
}
<section class="main__block container-fluid">
    <div class="row no-gutters">
        @if (List.RuchniyeProvodki)
        {
            <div class="col-6 col-sm-3">
                <a href="/Buxgalter/BU_RuchnayaPravodka" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_11.png" alt="" title="" />
                    <span class="d-block">БУ: Ручная проводка</span>
                </a>
            </div>
        }
        @if (List.PrasmotrDannix)
        {
            <div class="col-6 col-sm-3">
                <a href="/Buxgalter/BU_PrasmotrDannix" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_12.png" alt="" title="" />
                    <span class="d-block">БУ: Просмотр данных</span>
                </a>
            </div>
        }
        @if (List.BuxUchetVvodDannix)
        {
            <div class="col-6 col-sm-3">
                <a href="/Buxgalter/VvodDannix" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_13.png" alt="" title="" />
                    <span class="d-block">БУ: Ввод данных</span>
                </a>
            </div>
        }
        @if (List.PlanByudjeta)
        {
            <div class="col-6 col-sm-3">
                <a href="/PlatejnoyePorucheniye/Index" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_14.png" alt="" title="" />
                    <span class="d-block">БУ: План бюджета регионов</span>
                </a>
            </div>
        }
        @if (List.RaznoskaDannixPoOtraslyam)
        {
            <div class="col-6 col-sm-3">
                <a href="/Buxgalter/RaspredleniyeByudjeta" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_15.png" alt="" title="" />
                    <span class="d-block">Распределение бюджета по отраслям</span>
                </a>
            </div>
        }
        @if (List.PlatejniyePorucheniya)
        {
            <div class="col-6 col-sm-3">
                <a href="/PlatejnoyePorucheniye/Index" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_2.png" alt="" title="" />
                    <span class="d-block">Платежное поручение</span>
                </a>
            </div>
        }
      
       
    </div>
</section>

