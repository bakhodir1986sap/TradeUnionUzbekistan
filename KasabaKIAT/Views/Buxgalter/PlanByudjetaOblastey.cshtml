
@{
    ViewBag.Title = "Бухгалтерия";
}

<script src="~/Scripts/MyJavaScript/PlanirovaniyeByudjeta.js"></script>

<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
<section class="content__block container-fluid" ng-controller="planByudjet">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>План бюджета областей</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Buxgalter/Index">Бухгалтерия</a></li>
                    <li class="breadcrumb-item active" aria-current="page">План бюджета областей</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="r-title mb-4 row">
                <div class="col-md-6">
                </div>
                <div class="col-md-6 text-right">
                    <span><img src="~/Content/images/s-gr.png" alt="" title="" /> - незавершеный план</span>
                </div>
            </div>
            <div class="accordion mb-4 box-shadow" id="accordion">
                <div class="card r-card" ng-repeat="year in Years">
                    <div class="card-header r-card-header text-right" id="headingOne{{year}}">
                        <span class="r-header-t red float-left"><strong>{{year}}</strong></span>
                        <span class="r-header-c">1</span>
                        <span ng-click="GetRegionListByYear(year)" class="r-header-a float-right collapsed" data-toggle="collapse" data-target="#collapse{{year}}" aria-expanded="true" aria-controls="collapseOne"></span>
                    </div>
                    <div id="collapse{{year}}" class="collapse" aria-labelledby="headingOne{{year}}" data-parent="#accordion">
                        <div class="card-body r-card-body" ng-repeat="region in Regions">
                            <div class="list-group r-list-group">
                                <a href="/Buxgalter/PlanByudjetaOblasteyNoviy" class="list-group-item list-group-item-action">{{region.RegionName}}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mb-4">
                <a href="/Buxgalter/PlanByudjetaOblasteyNoviy" class="btn btn-blue d-block d-md-inline-block mb-2">Составить новый</a>
                <a href="/Buxgalter/PlanByudjetaOblasteyIzmenit" class="btn btn-blue d-block d-md-inline-block mb-2">Изменить</a>
            </div>
        </div>
    </div>
</section>
