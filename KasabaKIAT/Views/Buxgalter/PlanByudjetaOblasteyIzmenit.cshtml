
@{
    ViewBag.Title = "Бухгалтерия";
}

<script src="~/Scripts/MyJavaScript/PlanByudjetNew.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
<section class="content__block container" ng-controller="planByudjetNew">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Планирование бюджета регионов</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Buxgalter/Index">Бухгалтерия</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Планирование бюджета регионов</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="row">
                <div class="col-md-4 form-group">
                    <select class="custom-select form-control" ng-model="selectedyear">
                        <option>2018</option>
                        <option>2019</option>
                        <option>2020</option>
                        <option>2021</option>
                        <option>2022</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <select class="custom-select form-control" ng-model="selectedRegion" ng-options="prav as prav.Name for prav in Pravsoyuz track by prav.Kod"></select>
                </div>
                <div class="col-md-4 form-group">
                    <a href="#" ng-click="GetPlanContent()" class="btn btn-blue d-block">Показать план</a>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive box-shadow mb-4">
        <table class="table table__block">
            <thead>
                <tr>
                    <th>Тартиб раками</th>
                    <th>Моддалар номи</th>
                    <th>Йиллик</th>
                    <th>1-чорак</th>
                    <th>1-ярим йил.</th>
                    <th>9ойлик</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in PlanList">
                    <td>{{row.item_code}}</td>
                    <td>{{row.item_name}}</td>
                    <td>
                        <div class="form-group">
                            <input id="Yearly_{{row.item_code}}" type="text" ng-model="row.godovoy" value="{{row.godovoy}}"  class="form-control" placeholder="" ng-readonly="row.IsModValueYearly"/>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <input id="Quoter_{{row.item_code}}" type="text" ng-model="row.quarter1" value="{{row.quarter1}}" class="form-control" placeholder="" ng-readonly="row.IsModValue1Quater"/>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <input id="Half_{{row.item_code}}" type="text" ng-model="row.halfyear" value="{{row.halfyear}}" class="form-control" placeholder="" ng-readonly="row.IsModValue1Half"/>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <input id="month9_{{row.item_code}}" type="text" ng-model="row.month9" value="{{row.month9}}" class="form-control" placeholder="" ng-readonly="row.IsModValue9Month"/>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-blue d-block" ng-click="update(row)">Изменить</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="mb-4">
        <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2">Изменить</a>
        <a href="#" class="btn btn-red d-block d-md-inline-block mb-2" ng-click="delete()">Удалить</a>
    </div>
</section>
