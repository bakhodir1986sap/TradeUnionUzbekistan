@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    ViewBag.Title = "Отчет по лагерям";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/Ilxom/CampOtcheti.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.VvodZayavok)
{
<div ng-controller="CampOtcheti">
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col-sm-6 title__block">
                <h4>Отчет по лагерям</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Home/Zayavok">Заявки</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Отчет по лагерям</li>
                    </ol>
                </nav>
            </div>
            <div class="col-sm-6 text-md-right">
                <a href="#" ng-click="AddZayavku()" class="btn btn-blue d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#dobavit"><i class="fas fa-plus"></i> Добавить</a>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label>ИНН предприятия</label>
                        <select class="custom-select form-control" ng-model="SelectedOrganization" ng-options="item as item.Name_Org for item in OrganizationsL track by item.ID"></select>
                        <b><span>{{SelectedOrganization.Name_Org}}</span></b>
                        <div class="col-md-4 text-right">
                            &nbsp&nbsp<a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#organization">Выбрать Организацию</a>&nbsp
                            <a href="#" class="btn btn-green d-block d-md-inline-block mb-2" ng-click="ShowClicked()">Показать</a>
                        </div>
                    </div>
                    @*<div class="col-md-3 form-group">
                            <label>Отрасль</label>
                            <select class="custom-select" required name="Otrasl" ng-model="FilterSelectedOtrasl" ng-options="item as item.Name_Ot for item in Otrasl track by item.ID_Ot"></select>
                        </div>
                        <div class="col-md-3 form-group">
                            <label>Лагерь</label>
                            <select class="custom-select" required name="Otrasl" ng-model="FilterSelectedCamp" ng-options="item as item.value for item in Camps track by item.id"></select>
                        </div>*@
                </div>
            </div>
        </div>
        <div class="table-responsive box-shadow mb-4">
            <table class="table table__block t-hover">
                <thead>
                    <tr>
                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">Организация</th>
                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">Количество</th>
                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">Сумма</th>
                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">Дата/Время подачи</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="lager in LagerNewZayavkas" ng-click="edit(lager)" data-toggle="modal" data-target="#redaktirovat">
                        <td style="width:200px;text-align:center">{{lager.orgName}}</td>
                        <td style="width:200px;text-align:center">{{lager.quantuty}}</td>
                        <td style="width:200px;text-align:center">{{lager.totalamount}}</td>
                        <td style="width:200px;text-align:center">{{lager.timestamp | jsonDate: 'dd.MM.yyyy'}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-title">
                        <h4 class="text-center mt-4 mb-4">{{ActionType}} заявки</h4>
                    </div>
                    <div class="row justify-content-center">
                        <form class="col-md-8" name="myForm" novalidate>
                            <input type="hidden" style="position:absolute" ng-model="REC_ID;" />
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Покупатель:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" ng-model="SelectedOrganization" ng-options="item as item.Name_Org for item in OrganizationsL track by item.ID"></select>
                                    <span>{{SelectedOrganization.Name_Org}}</span>
                                </div>

                            </div>
                            <div class="mb-4 row text-right align-items-baseline" style="justify-content:flex-end">
                                <a href="#" style="margin-right: 15px" class="btn btn-grey d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#organization">Выбрать</a>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Количество:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="QUANTUTY" class="form-control" required name="Quantity" />
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Quantity.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Сумма:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="TOTALAMOUNT" class="form-control" required name="TotalAmount" />
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.TotalAmount.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="mb-4 text-right">
                                <button data-dismiss="modal" ng-click="AddZayavkuClicked()" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal__block modal fade" id="redaktirovat" tabindex="-1" role="dialog" aria-labelledby="redaktirovatLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-title">
                        <h4 class="text-center mt-4 mb-4">{{ActionType}} заявки</h4>
                    </div>
                    <div class="row justify-content-center">
                        <form class="col-md-8" name="myForm" novalidate>
                            <input type="hidden" style="position:absolute" ng-model="REC_ID;" />
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Покупатель:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" ng-model="SelectedOrganization" ng-options="item as item.Name_Org for item in OrganizationsL track by item.ID"></select>
                                    <span>{{SelectedOrganization.Name_Org}}</span>
                                </div>

                            </div>
                            <div class="mb-4 row text-right align-items-baseline" style="justify-content:flex-end">
                                <a href="#" style="margin-right: 15px" class="btn btn-grey d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#organization">Выбрать</a>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Количество:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="QUANTUTY" class="form-control" required name="Quantity" />
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Quantity.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Сумма:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="TOTALAMOUNT" class="form-control" required name="TotalAmount" />
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.TotalAmount.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="mb-4 text-right">
                                <button data-dismiss="modal" ng-click="ModifyZayavku()" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                <button ng-click="DeleteZayavku()" data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</button>
                                <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal__block modal fade" id="organization" tabindex="-1" role="dialog" aria-labelledby="organizationLabel" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document" style="max-width: 80%">
            <div class="modal-content">
                <div class="modal-body" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                    <div class="row mb-4 align-items-center">
                        <div class="col-sm-6 title__block">
                            <h4>Справочник Организаций</h4>
                            <nav aria-label="breadcrumb" class="breadcrumb__block">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item active" aria-current="page">Справочник Организаций</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                    <div>
                        <div class="row">
                            <div class="col-md-3">
                                <input class="form-control" type="text" style="margin-bottom:5px" placeholder="Наименование" ng-model="FilterName" />
                                <br />
                            </div>
                            <div class="col-md-3">
                                <input class="form-control" type="text" style="margin-bottom:5px" placeholder="ИНН" ng-model="FilterInn" /><br />
                            </div>
                        </div>
                        <select class="custom-select" required name="Otrasl" ng-model="FilterSelectedOtrasl" ng-options="item as item.Name_Ot for item in Otrasl track by item.ID_Ot"></select>
                        <br /><br /><button class="btn btn-green" style="float:right;margin-bottom:10px" ng-click="GetOrganizationsFilter()"><i class="btn-green"></i> Поиск</button>
                    </div>
                    <div class="table-responsive box-shadow mb-4" id="export">
                        <table class="table table__block t-hover">
                            <thead>
                                <tr>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Выбор
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Отрасль
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:200px;text-align:center">
                                        Название организации
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        ИНН
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:100px;text-align:center">
                                        Расчетный счет
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        МФО
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Банк
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        ОКОНХ
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Адрес
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Телефон
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Район
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="poin" ng-repeat="org in Organizations" ng-click="editOrg(org)">
                                    <td class="custom-control custom-checkbox r-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="customCheck{{org.ID}}"
                                               ng-model="selectedObjs"
                                               ng-checked="obj.selected"
                                               ng-click="toggleObjSelectionOrg($event, org.ID, org.Name_Org)">
                                        <label class="custom-control-label r-label" for="customCheck{{org.ID}}">{{org.ID}}</label>
                                    </td>
                                    <td style="text-align:center">{{org.OtraslName}}</td>
                                    <td style="text-align:center">{{org.Name_Org}}</td>
                                    <td style="text-align:center">{{org.INN     }}</td>
                                    <td style="text-align:center">{{org.RS      }}</td>
                                    <td style="text-align:center">{{org.MFO     }}</td>
                                    <td style="text-align:center">{{org.Bank    }}</td>
                                    <td style="text-align:center">{{org.OKONX   }}</td>
                                    <td style="text-align:center">{{org.Adress  }}</td>
                                    <td style="text-align:center">{{org.Telefon }}</td>
                                    <td style="text-align:center">{{org.RegionName}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mb-4 text-right" style="position:fixed; bottom:-1%; right: 40px">
                        @*<a href="#" ng-click="SelectOrganization()" class="btn btn-blue d-block d-md-inline-block mb-2" data-dismiss="modal"><i class="fas fa-plus"></i> Выбрать</a>*@
                        <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}


