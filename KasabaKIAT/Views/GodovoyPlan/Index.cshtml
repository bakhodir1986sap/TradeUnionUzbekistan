
@{
    ViewBag.Title = "Путевки";
}
<script src="~/Scripts/MyJavaScript/GPController.js"></script>
@*<h2 style="color:#428bca">Годовой план распределения путевок по отраслям</h2>*@
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px">
    <img src="~/Content/Login/buffering.gif" />
</div>
<div ng-controller="GPController">
    <section class="content__block container">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Годовой план</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Putyovki">Путевки</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Годовой план</li>
                    </ol>
                </nav>
            </div>
        </div>
        <form class="form-group  justify-content-end" name="myForm1" novalidate>
            <div class="col-md-7">
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" ng-model="s" required ng-change="LoadSC()" name="RadioOptions" id="inlineRadios1" value="option1" class="custom-control-input" checked="" />
                    <label for="inlineRadios1" class="custom-control-label">Санаторий</label>
                </div>
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" ng-model="s" required ng-change="LoadSC()" name="RadioOptions" id="inlineRadios2" value="option2" class="custom-control-input" />
                    <label for="inlineRadios2" class="custom-control-label">Дет. лагер</label>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.RadioOptions.$error.required">Выберите поле</span>
                </div>
            </div>
        </form>
        <div class="row mb-4 align-items-center">
            <div class="col-md-7 text__block my-3">
                <p>Доход по региону <strong>20 349 000</strong> | доступно путевок: <strong>200</strong></p>
            </div>
            <div class="col-md-5 text-md-right">
                <a href="#" ng-click="AddGPDiv()" class="btn btn-blue d-block d-md-inline-block mb-3 mb-md-0" data-toggle="modal" data-target="#dobavit"><i class="fas fa-plus"></i> Добавить</a>
                <a href="#" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0"><i class="fas fa-file-excel"></i> Загрузить</a>
            </div>
        </div>
        <div class="table-responsive box-shadow mb-4"  ng-show="GPdiv">
            <table class="table table__block t-hover">
                <thead>
                    @*<tr>
                        <th style="text-align:center;width:200px">
                            <select ng-model="RegionFilter" ng-change="LoadGPData()" class="custom-select form-control" required name="RFilter" ng-options="item as item.value for item in R track by item.id"></select>
                        </th>
                        <th style="text-align:center;width:200px">
                            <select class="custom-select form-control" required ng-change="LoadGPData()" name="CSFilter" ng-model="SCFilter" ng-options="item as item.value for item in CS track by item.id"></select>
                        </th>
                        <th style="text-align:center;width:100px;width:@ViewBag.px200"><input type="text" ng-model="KFilter" class="form-control" style="text-align:center" placeholder="Период" /></th>
                        <th style="text-align:center;width:100px;@ViewBag.TR"><select ng-model="PlaceTypeFilter" name="PlaceTypeFilter" required ng-options="d as d.NAME_UZ for d in D track by d.REC_ID" class="custom-select form-control"></select></th>
                        <th style="text-align:center;width:100px;width:@ViewBag.px200"><input type="text" ng-model="PFilter" class="form-control" placeholder="Цена" style="text-align:center" /></th>
                        <th style="text-align:center;width:90px;width:@ViewBag.px200"><input type="text" ng-model="QFilter" class="form-control" style="text-align:center" placeholder="Кол-во" /></th>
                        <th style="width:240px"></th>
                    </tr>*@
                    <tr>
                        <th style="text-align:center;width:200px" class="dropdown dropdown__table">
                            <select ng-model="RegionFilter" ng-change="LoadGPData()" class="custom-select form-control" required name="RFilter" ng-options="item as item.value for item in R track by item.id"></select>
                        </th>
                        <th style="text-align:center;width:200px" class="dropdown dropdown__table">
                            <select class="custom-select form-control" required ng-change="LoadGPData()" name="CSFilter" ng-model="SCFilter" ng-options="item as item.value for item in CS track by item.id"></select>
                        </th>
                        <th style="text-align:center;width:100px;width:@ViewBag.px200" class="dropdown dropdown__table">
                            <input type="text" ng-model="KFilter" class="form-control" style="text-align:center" placeholder="Период" />
                        </th>
                        <th style="text-align:center;width:100px;@ViewBag.TR" class="dropdown dropdown__table">
                            <select ng-model="PlaceTypeFilter" name="PlaceTypeFilter" required ng-options="d as d.NAME_UZ for d in D track by d.REC_ID" class="custom-select form-control"></select>
                        </th>
                        <th style="text-align:center;width:100px;width:@ViewBag.px200" class="dropdown dropdown__table">
                            <input type="text" ng-model="PFilter" class="form-control" placeholder="Цена" style="text-align:center" />
                        </th>
                        <th style="text-align:center;width:90px;width:@ViewBag.px200" class="dropdown dropdown__table">
                            <input type="text" ng-model="QFilter" class="form-control" style="text-align:center" placeholder="Кол-во" />
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="poin" ng-repeat="gp in GP | filter:KFilter | filter:PFilter | filter:QFilter" ng-click="editGP(gp)" data-toggle="modal" data-target="#dobavit">
                        <td style="text-align:center">{{gp.R}}</td>
                        <td style="text-align:center">{{gp.SC}}</td>
                        <td style="text-align:center">{{gp.K}} kv</td>
                        <td style="text-align:center;@ViewBag.TR">{{gp.TM}}</td>
                        <td style="text-align:center">{{gp.P}}</td>
                        <td style="text-align:center">{{gp.Q}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
   
    <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-title">
                        <h4 class="text-center mt-4 mb-4">Добавить</h4>
                    </div>
                    <div class="row justify-content-center">
                        <form class="col-md-8"  name="myForm" novalidate>
                            <input type="hidden" style="position:absolute" ng-model="ID;" />
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">@ViewBag.R:</label>
                                <div class="col-md-7">
                                    <select ng-model="Region" class="custom-select form-control" required name="R" ng-options="item as item.value for item in R track by item.id"></select>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.R.$error.required">Выберите поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">{{scname}}:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" required name="CS" ng-model="SC" ng-options="item as item.value for item in CS track by item.id"></select>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="s&&myForm.CS.$error.required">Выберите поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center" style=";@ViewBag.TR;padding-bottom:20px">
                                <label class="col-md-5 col-form-label text-md-right py-0">Тип размещения:</label>
                                <div class="col-md-7">
                                    <select ng-model="PlaceType" name="PlaceType" required ng-options="d as d.NAME_UZ for d in D track by d.REC_ID" class="form-control"></select>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.PlaceType.$error.required">Выберите поле</span>
                                </div>
                            </div>
                           
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Квартал:</label>
                                <div class="col-md-7">
                                    <input type="text" name="K" required ng-minlength="1" ng-maxlength="1" ng-model="K" class="form-control" value="1" placeholder="">
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.K.$error.required">заполнить поле</span>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="!myForm.K.$error.required&&!myForm.K.$valid">1 шт. номер</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Цена:</label>
                                <div class="col-md-7">
                                    <input type="text" name="P" required ng-model="P" class="form-control" placeholder="">
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.P.$error.required">
                                        заполнить поля
                                    </span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-md-right py-0">Кол-во:</label>
                                <div class="col-md-7">
                                    <input type="text" required name="Q" ng-model="Q" class="form-control" placeholder="">
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Q.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="mb-4 text-right">
                                <a href="#" ng-disabled="myForm.R.$error.required||myForm.O.$error.required||s&&myForm.CS.$error.required||myForm.PlaceType.$error.required||myForm.K.$error.required||(!myForm.K.$error.required&&!myForm.K.$valid)||myForm.P.$error.required||myForm.Q.$error.required" ng-click="AddUpdateGP()" data-dismiss="modal" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</a>
                                <a href="#" ng-click="deleteGP(ID)" data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</a>
                                <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


