    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title text-center" id="myModalLabel">{{Action}}</h4>
                </div>
                <form class="modal-body" name="myForm" novalidate>
                    <input type="hidden" style="position:absolute" ng-model="ID;" />
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>@ViewBag.R</p>
                        </div>
                        <div class="col-xs-6">
                            <select ng-model="Region" class="form-control" required name="R" ng-options="item as item.value for item in R track by item.id"></select>
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.R.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>{{scname}}</p>
                        </div>
                        <div class="col-xs-6">
                            <select class="form-control" required name="CS" ng-model="SC" ng-options="item as item.value for item in CS track by item.id"></select>
