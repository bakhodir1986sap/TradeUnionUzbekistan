
@{
    ViewBag.Title = "INN";
    Layout = "/Views/Shared/_Layout0.cshtml";
}
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link href="https://use.fontawesome.com/releases/v5.0.2/css/all.css" rel="stylesheet">
<link rel="stylesheet" href="~/Content/styles/main.css">
<script src="~/Scripts/vendor/modernizr.js"></script>



<script src="~/Scripts/kendo/angular.min.js"></script>
<script src="~/Scripts/MyJavaScript/Module.js"></script>
<script src="~/Scripts/MyJavaScript/KasabaKIATService.js"></script>
<script src="~/Scripts/MyJavaScript/DataService.js"></script>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="https://fastcdn.org/FileSaver.js/1.1.20151003/FileSaver.min.js"></script>


<script src="~/Scripts/MyJavaScript/DataService.js"></script>
<script src="~/Scripts/MyJavaScript/LoadINN.js"></script>

<section class="content__block container" ng-controller="LoadINN">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row justify-content-center">
        <form class="row" name="myForm1" novalidate>
            <div class="custom-control-inline" style="margin-left:20px;">
                <div>
                    <p>ИНН:</p>
                    <input type="text" class="form-control col-md-6 mb-2" id="inn" ng-model="I" placeholder="ИНН" style="width:200px" />
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.I.$error.required">Выберите поле</span>
                </div>
                <div style="margin-left:100px">
                    <p>ИМЯ:</p>
                    <input type="text" required id="name" class="form-control col-md-6 mb-2" ng-model="N" placeholder="ИМЯ" style="width:200px"/>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.N.$error.required">Выберите поле</span>
                </div>
                <div style="margin-left:20px">
                    <button ng-click="LoadDATA()"  class="btn btn-blue d-block d-md-inline-block mb-2" style="margin-top:40px"> Получить</button>
                </div>
            </div>
        </form>
        <div class="table-responsive box-shadow mb-4" ng-show="showdata" id="export">
            <table class="table table__block t-hover" onscroll="yes">
                <thead>
                    <tr>
                        <th class="dropdown dropdown__table">Адрес</th>
                        <th class="dropdown dropdown__table">Названия</th>
                        <th class="dropdown dropdown__table">Названия</th>
                        <th class="dropdown dropdown__table">Инн</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in DATA" ng-click="T(item.d2,item.d4)" data-dismiss="modal">
                        <td>{{item.d1}}</td>
                        <td>{{item.d2}}</td>
                        <td>{{item.d3}}</td>
                        <td>{{item.d4}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <button ng-show="showdata" onclick="onClick();" ng-click="Tanlash()">Tanlash</button>
        <script>
                function onClick() {
                    parent.HelloFromChild(document.getElementById("inn").value, document.getElementById("name").value);
                }
        </script>
    </div>
</section>

