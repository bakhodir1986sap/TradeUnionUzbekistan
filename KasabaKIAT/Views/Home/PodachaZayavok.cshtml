
@{
    ViewBag.Title = "Подача заявок";
}
<script src="~/Scripts/MyJavaScript/PZController.js"></script>
<div id="connection" style="visibility:hidden;position:fixed;margin-left:430px;margin-top:100px">
    <img src="~/Content/Login/buffering.gif" />
</div>
<div ng-controller="PZController">
    <section class="content__block container">
        <div class="row mb-4 align-items-center">
            <div class="col-sm-6 title__block">
                <h4>Подача заявок</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Zayavok">Заяки</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Подача заявок</li>
                    </ol>
                </nav>
            </div>
            <div class="col-sm-6 text-md-right">
                <a href="#"  ng-click="AddPZDiv()" class="btn btn-blue d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#dobavit"><i class="fas fa-plus"></i> Добавить</a>
                <a href="#" class="btn btn-green d-block d-md-inline-block mb-2"><i class="fas fa-file-excel"></i> Загрузить</a>
            </div>
        </div>
        <form class="form-group  justify-content-end" name="myForm1" novalidate>
            <div class="col-md-7">
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" ng-model="ss" required ng-change="LoadSC()" name="inlineRadioOptionss" id="inlineRadios1" value="option1s" class="custom-control-input" checked="" />
                    <label for="inlineRadios1" class="custom-control-label">Санаторий</label>
                </div>
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" ng-model="ss" required ng-change="LoadSC()" name="inlineRadioOptionss" id="inlineRadios2" value="option2s" class="custom-control-input" />
                    <label for="inlineRadios2" class="custom-control-label">Дет. лагер</label>
                </div>
            </div>
        </form>
        <div ng-show="OTPdiv" class="text__block py-5 my-5">
            <p><strong>Спасибо! Заявка успешно отправлена..</strong></p>
            <p style="width:500px">Тут будет текст который будет говорить о том, что заявка успешно добавлена...можно поставить ссылки на <a href="/Home/PoiskRedaktZayavok">Поиск и редактирование заявок</a></p>
        </div>
        @*<div ng-show="OTPdiv" class="row" style="padding-top:15px;" id="result">
            <b>Спасибо! Заявка успешно отправлена..</b>
            <p>
                Ту будет текст который будет говорить о том, что заявка успешно добавлена...можно поставить<br>
                ссылки на <a href="/Home/PoiskRedaktZayavok" class="btn btn-info">Поиск и редактирование заявок</a>
            </p>
        </div>*@
                <div  ng-show="PZdiv" class="table-responsive box-shadow mb-4">
                    <table class="table table__block t-hover">
                        <thead>
                            <tr>
                                @*<th>№</th>*@
                                <th style="text-align:center">Дата подачи</th>
                                <th style="text-align:center;width:200px"><select class="custom-select form-control" ng-model="SCFilter" ng-change="LoadData()" required name="CSFilter" ng-options="item as item.value for item in CS track by item.id"></select></th>
                                @*<th style="text-align:center;width:125px"><input type="text" ng-model="INN_Filter" class="form-control" style="text-align:center" placeholder="Инн" /></th>*@
                                <th style="text-align:center;width:200px"><input type="text" ng-model="O_Filter" class="form-control" style="text-align:center" placeholder="Организация" /></th>
                                <th style="text-align:center;width:200px"><input type="text" ng-model="FN_Filter" class="form-control" style="text-align:center" placeholder="ФИО" /></th>
                                <th style="text-align:center;width:125px"><input type="text" ng-model="Position_Filter" class="form-control" style="text-align:center" placeholder="Должность" /></th>
                                <th style="text-align:center;width:100px"><input type="text" ng-model="Q_Filter" class="form-control" style="text-align:center" placeholder="Кол-во" /></th>
                                <th style="text-align:center">Месяц</th>                            
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="pz in PZ | filter:INN_Filter | filter:O_Filter | filter:FN_Filter | filter:Position_Filter | filter:Q_Filter" ng-click="editPZ(pz)" data-toggle="modal" data-target="#dobavit">
                                @*<td>{{pz.ID}}</td>*@
                                <td>{{pz.TS | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td style="text-align:center">{{pz.SC}}</td>
                                @*<td style="text-align:center">{{pz.INN}}</td>*@
                                <td style="text-align:center">{{pz.O}}</td>
                                <td style="text-align:center">{{pz.FN}}</td>
                                <td style="text-align:center">{{pz.P}}</td>
                                <td style="text-align:center">{{pz.Q}}</td>
                                <td>{{pz.ZB | jsonDate: 'dd.MM.yyyy'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-4">
                        <a href="#" ng-click="OTPpz()" class="btn btn-blue d-block d-md-inline-block mb-2">Отправить</a>
                    </div>
                </div>
               
</section>
    <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body" >
                    <div class="modal-title">
                        <h4 class="text-center mt-4 mb-4">{{Action}} заявку</h4>
                    </div>
                    <div class="row justify-content-center">
                        <form class="col-md-8"  name="myForm" novalidate>
                            <input type="hidden" style="position:absolute" ng-model="ID;" />
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">{{myVal}}:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" required name="CS" ng-model="SC" ng-options="item as item.value for item in CS track by item.id"></select>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="s&&myForm.CS.$error.required">Выберите поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Начало заезда:</label>
                                <div class="col-md-7">
                                    <input type="date" class="custom-select  form-control" ng-model="ZB" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Конец заезда:</label>
                                <div class="col-md-7">
                                    <input type="date" class="form-control" ng-model="ZE" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Инн:</label>
                                <div class="col-md-7">
                                    <input type="text" required class="form-control" name="INN" ng-minlength="9" ng-maxlength="9" ng-model="INN" ng-change="LoadINN()" />
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.INN.$error.required">заполнить поле</span>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="!myForm.INN.$error.required&&!myForm.INN.$valid">9 шт. номер</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Организация:</label>
                                <div class="col-md-7">
                                    <label name="O" ng-model="O">{{O}}</label>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">ФИО:</label>
                                <div class="col-md-7">
                                    <input type="text" class="form-control" name="FN" ng-model="FN" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.FN.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Должность:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="P" name="P" class="form-control" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.P.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Кол-во путевок:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-model="Q" disabled="disabled" name="Q" class="form-control" required>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Наличие Мед. справки:</label>
                                <div class="col-md-7">
                                    <input type="checkbox" ng-model="MOE" ng-change="MOE_ch()">
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Номер и дата выдачи справки:</label>
                                <div class="col-md-7">
                                    <input type="text" ng-disabled="!MOE" ng-model="MO" name="MO" class="form-control" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="MOE&&myForm.MO.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="mb-4 text-right">
                                <button ng-disabled="myForm.INN.$error.required||myForm.FN.$error.required||myForm.P.$error.required||(!myForm.INN.$error.required&&!myForm.INN.$valid)||O=='No Data Found'||MOE&&myForm.MO.$error.required" ng-click="AddUpdatePZ()"   data-dismiss="modal" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                <button ng-click="deletePZ(ID)"  data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</button>
                                <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

