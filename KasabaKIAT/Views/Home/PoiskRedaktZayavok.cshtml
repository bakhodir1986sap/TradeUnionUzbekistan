                                                <th style="width:200px;text-align:center">Названия</th>
                                                <th style="width:200px;text-align:center">Инн</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in DATA3" onclick="MyFunction()" ng-click="T(item.d2,item.d4)">
