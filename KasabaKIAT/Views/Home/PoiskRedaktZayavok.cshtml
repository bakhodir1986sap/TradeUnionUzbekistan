
@{
    ViewBag.Title = "Поиск и редактирование заявок";
}

<script src="~/Scripts/MyJavaScript/PRZController.js"></script>
<h2>Поиск и редактирование заявок</h2>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px">
    <img src="~/Content/Login/buffering.gif" />
</div>
<div ng-controller="PRZController">
    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title text-center" id="myModalLabel">редактировать заявку</h4>
                </div>
                <form class="modal-body" name="myForm" novalidate>
                    <input type="hidden" style="position:absolute" ng-model="ID" />
                    <br />
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>{{MyVal}}</p>
                        </div>
                        <div class="col-xs-6">
                            <select class="form-control" name="SC" required ng-model="SC" ng-options="item as item.value for item in CS track by item.id"></select>
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.SC.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Дата заезды:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="date" required class="form-control" ng-model="ZB" />
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>конец заезды:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="date" required class="form-control" ng-model="ZE" />
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Инн:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" required name="INN" ng-minlength="9" ng-maxlength="9" class="form-control" ng-model="INN" ng-change="LoadINN()" />
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.INN.$error.required">Выберите поля</span>
                            <span class="alert alert-warning" style="padding:0px" ng-show="!myForm.INN.$error.required&&!myForm.INN.$valid">9 шт. номер</span>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Организация:</p>
                        </div>
                        <div class="col-xs-6">
                            <label name="O" ng-model="O">{{O}}</label>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>ФИО:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" required class="form-control" name="FN" ng-model="FN">
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.FN.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Должность:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" required ng-model="P" name="P" class="form-control">
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.P.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Кол-во путевок:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" required ng-model="Q" name="Q" class="form-control">
                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Q.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br>

                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Наличие Мед. справки:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="checkbox" required ng-model="MOE" ng-change="MOE_ch()">
                        </div>
                    </div>
                    <br>

                    <div class="row">
                        <div class="col-xs-5 text-right">
                            <p>Номер и дата выдачи справки:</p>
                        </div>
                        <div class="col-xs-6">
                            <input type="text" required ng-disabled="!MOE" name="MO" ng-model="MO" class="form-control">
                            <span class="alert alert-warning" style="padding:0px" ng-show="MOE&&myForm.MO.$error.required">Выберите поля</span>
                        </div>
                    </div>
                    <br>
                    <div class="modal-footer">
                        <div class="col-xs-6 col-xs-offset-5">
                            <button type="button" ng-click="UpdatePRZ()" ng-disabled="myForm.INN.$error.required||myForm.FN.$error.required||myForm.P.$error.required||myForm.Q.$error.required||myForm.SC.$error.required||(!myForm.INN.$error.required&&!myForm.INN.$valid)||O=='No Data Found'||MOE&&myForm.MO.$error.required" data-dismiss="modal" class="btn btn-info"><i class="fa fa-save" aria-hidden="true"></i> сохранить</button>
                            <button type="button" class="btn btn-default" data-dismiss="modal">отмена</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- modal fade -->
    <form class="row" style="margin-top: 30px;" name="myForm1" novalidate>
        <div class="col-xs-3">
            <label class="radio-inline">
                <input type="radio" ng-model="s" required ng-click="LoadCSName()" name="inlineRadioOptions" id="inlineRadio1" value="option1"> Санаторий
            </label>
            <label class="radio-inline">
                <input type="radio" ng-model="s" required ng-click="LoadCSName()" name="inlineRadioOptions" id="inlineRadio2" value="option2"> Дет. лагер
            </label>
            <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.inlineRadioOptions.$error.required">Выберите поля</span>
        </div>
    </form>
    <div class="row" ng-show="PRZdiv">
        <table class="table table-hover table-bordered">
            <thead>
                <tr>
                    <th>
                        <input type="date" required class="form-control" ng-model="searchD0" ng-change="searchD0_CH()" />
                    </th>

                    <th style="width:200px">
                        <select class="form-control" ng-model="SCf" ng-options="sc as sc.value for sc in CS track by sc.id" ng-change="LoadSC()"></select>
                    </th>

                    <th style="width:200px">
                        <input type="text" class="form-control" ng-model="searchO" placeholder="Организация" />
                    </th>

                    <th>
                        <input type="text" class="form-control" ng-model="searchFN" placeholder="ФИО" />
                    </th>

                    <th>
                        <input type="text" ng-model="position" class="form-control" placeholder="Должность" />
                        @*<select ng-model="Pf" ng-options="p as p.value for p in Ps track by p.id" ng-change="LoadP()"  class="form-control">
                            </select>*@
                    </th>

                    <th>
                        <input type="date" required class="form-control" ng-model="searchD1" ng-change="searchD1_CH()" />
                    </th>
                    @*<th></th>*@
                </tr>
            </thead>
            <tbody>
                <tr class="poin"  ng-repeat="prz in PRZ | filter:searchFN | filter:searchO | filter:position"  ng-click="editPRZ(prz)" data-toggle="modal" data-target="#myModal">
                    <td>{{prz.TS | jsonDate: 'dd.MM.yyyy'}}</td>
                    <td>{{prz.SC}}</td>
                    <td>{{prz.O}}</td>
                    @*<td>{{prz.INN}}</td>*@
                    <td>{{prz.FN}}</td>
                    <td>{{prz.P}}</td>
                    @*<td>{{prz.Q}}</td>*@
                    <td>{{prz.ZB | jsonDate: 'dd.MM.yyyy'}}</td>
                    @*<td>{{prz.ZE | jsonDate: 'dd.MM.yyyy'}}</td>*@
                    @*<td>
                        <button type="button" ng-click="editPRZ(prz)" class="btn btn-info modal4" data-toggle="modal" data-target="#myModal"><i class="fa fa-exchange"></i> изменить</button>
                    </td>*@
                </tr>
            </tbody>
        </table>
    </div>
</div>

