                                        @*<span class="alert alert-warning" style="padding:0px" ng-show="myForm.VocationOrder.$error.required">выберите файл</span>*@
                                    </div>
                                </div>
                                <div class="form-group row align-items-center">
                                    <label class="col-md-5 col-form-label py-0">Протокол профсоюзного комитета :</label>
                                    <div class="col-md-7">
                                        <input type="file" ng-model="fPPO_Protokol" name="PPO_Protokol" class="form-control" onchange="angular.element(this).scope().UploadFilesPPO_Protokol(this.files)">
                                        <a href="#" ng-click="DownloadFile(PPO_Protokol, FilesOpdatas.PPO_Protokol)"><span ng-bind="FilesOpdatas.PPO_Protokol"></span></a>
                                        @*<span class="alert alert-warning" style="padding:0px" ng-show="myForm.PPO_Protokol.$error.required">выберите файл</span>*@
                                    </div>
                                </div>

                                <div class="mb-4 text-right">
                                    <button ng-show="IsOwn" ng-click="SaveFilesDATA()" data-dismiss="modal" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                    <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


