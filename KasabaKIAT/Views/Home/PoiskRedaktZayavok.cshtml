                                        <a href="#" ng-click="DownloadFile(LabourBook, FilesOpdatas.LabourBook)"><span ng-bind="FilesOpdatas.LabourBook"></span></a>
                                        @*<span class="alert alert-warning" style="padding:0px" ng-show="myForm.LabourBook.$error.required">выберите файл</span>*@
