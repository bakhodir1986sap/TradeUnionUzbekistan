                                        @*@Html.ActionLink("{{FilesOpdatas.Passport}}", "DownloadZayavkaFile", "Home", new { zayavkaId = "{{ID}}", OpName = "Passport" }, null)*@
                                        <a href="#" ng-click="DownloadFile(Passport, FilesOpdatas.Passport)"><span ng-bind="FilesOpdatas.Passport"></span></a>
                                        @*<span class="alert alert-warning" style="padding:0px" ng-show="myForm.Passport.$error.required" >выберите файл</span>*@
