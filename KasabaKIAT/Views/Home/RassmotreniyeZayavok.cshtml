                                            <tr>
                                                <th style="width:200px;text-align:center">Адрес</th>
                                                <th style="width:200px;text-align:center">Названия</th>
                                                <th style="width:200px;text-align:center">Названия</th>
                                                <th style="width:200px;text-align:center">Инн</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in DATA3" onclick="MyFunction()" ng-click="T(item.d2,item.d4)">
                                                <td style="width:200px">{{item.d1}}</td>
                                                <td style="width:200px">{{item.d2}}</td>
                                                <td style="width:200px">{{item.d3}}</td>
                                                <td style="width:200px">{{item.d4}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <script>
                                        function MyFunction() {
                                            $("#table tr").click(function () {
                                                $(this).addClass('selected').siblings().removeClass('selected');
                                                var value = $(this).find('td:first').html();
                                                //alert("value=" + value);
                                            });
                                        }
                                    </script>
                                </div>
                                <button ng-show="showdata" ng-click="Tanlash()" data-dismiss="modal">Выбрать</button>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal__block modal fade" id="history" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="modal-title">
                            <h4 class="mt-4 mb-4">История</h4>
                        </div>
                        <div class="modal-text mb-4">
                            <p>ФИО: <strong>{{FN}}</strong></p>
                            <p>ИНН: <strong>{{INN}}</strong></p>
                        </div>
                        <div class="table__title mb-3">
                            <p><strong>Детали заявок</strong></p>
                        </div>
                        <div class="table-responsive box-shadow mb-4">
                            <table class="table table__block">
                                <thead>
                                    <tr>
                                        <th style="width:200px">Дата реал.</th>
                                        <th style="width:200px">Санаторий</th>
                                        <th style="width:200px">Организация</th>
                                        <th style="width:200px">Должность</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><input type="date" class="form-control" disabled="disabled" ng-model="TZ" /></td>
                                        <td>{{SC.value}}</td>
                                        <td>{{O}}</td>
                                        <td>{{P}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mb-4">
                            <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2">ОК</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
