                                            <p>ИМЯ:</p>
                                            <input type="text" required id="name" class="form-control" ng-model="N" placeholder="ИМЯ" style="width:200px" />
                                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.N.$error.required">Выберите поле</span>
                                        </div>
