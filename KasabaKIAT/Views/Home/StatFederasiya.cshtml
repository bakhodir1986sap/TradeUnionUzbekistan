@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using KasabaKiat.Helpers;
@{
    ViewBag.Title = "Путевки";
    ViewBag.n = Session["role"];
    var UserId = Convert.ToInt32(User.Identity.Name);
    var userName = UserInfo.GetUserInfo(UserId);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId, true);
}

<script src="~/Scripts/MyJavaScript/Stat/StatFederasiya.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>


<section class="content__block container" ng-controller="StatFederasiya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row" style="padding-left:15px !important">
        <div class="col-md-6">
            <h4 style="color:#167f91;">Аналитика за @userName.CurKvartalYear</h4>
            <p style="">Время последнего обновления: {{ModelResult.LastChangeDate| jsonDate: 'dd.MM.yyyy'}} </p><br>
           
        </div>
        <div class="col-md-6 text-right" style="display: flex; align-items: center; justify-content:flex-end">
            <p style="padding-bottom:5px">
                <img style="height:17px;width:17px" src="~/Content/Stat/Screen6.png"> - {{ModelResult.BronCount}} брони

            </p>
            <p style="padding-bottom:5px">
                <img style="height:17px;width:17px" src="~/Content/Stat/Screen6.png"> - {{ModelResult.AktivUsers}} Активные пользователи

            </p>
        </div>
    </div>

    <h4 style="padding-left:15px">Доходы</h4>
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right: 15px">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <!--<th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>-->
                            <th class="benefits">Просмотреть</th>
                            <th>Всего доходов <br> <b>{{ModelResult.EcpIncome + ModelResult.PartialIncome + ModelResult.OtherIncome  | currency:' '}}</b> сум</th>
                            <th>ЕСП 30%<br> <b>{{ModelResult.EcpIncome  | currency:' '}}</b> сум</th>
                            <th>Частичные оплаты <br> <b>{{ModelResult.PartialIncome  | currency:' '}}</b> сум</th>
                            <th>Прочее <br> <b>{{ModelResult.OtherIncome  | currency:' '}}</b> сум</th>

                        </tr>
                       
                    </thead>
                    <tbody class="tbody" style="display:none">
                        <tr ng-repeat="model in ModelResult.IncomePerRegionList">
                            <td>{{model.RegionName}}</td>
                            <td>{{model.TotalIncome | currency:' '}}</td>
                            <td>{{model.EcpIncome | currency:' '}}</td>
                            <td>{{model.PartialIncome | currency:' '}}</td>
                            <td>{{model.OtherIncome | currency:' '}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

     <h4 style="color:red;padding-left:15px">Горящие путевки</h4>
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive box-shadow mb-4"  style="padding-left: 15px; padding-right:15px">
                <table class="table table__block t-hover table__small">
                   <thead>
                        <tr>
                            <!--<th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown"    aria-haspopup="true" aria-expanded="false"></span>
    
                            </th>-->
                            <th class="benefits2" style="width:350px">Просмотреть</th>
                            <th>Всего <br> <b>{{ModelResult.UrgentPutyovkas | currency:' '}}</b></th>
                        </tr>
                       
                    </thead>
                    <tbody class="tbody2" style="display:none">
                        <tr ng-repeat="model in ModelResult.UrgentPutyovkasRegionList">
                            <td>{{model.RegionName}}</td>
                            <td>{{model.PutyovkasCount | currency:' '}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px">Путёвки</h4>
            <p style="padding-left:15px">@userName.CurKvartalYear</p>
            <div class="table-responsive box-shadow mb-4"  style="padding-left: 15px; padding-right:15px">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <!--<th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>-->
                            <th class="benefits3">Просмотреть</th>
                            <th>План</th>
                            <th>Реализовано</th>
                            <th>Остаток</th>
                        </tr>
                    </thead>
                    <tbody class="tbody3" style="display:none">
                        <tr>
                            <td></td>
                            <td><b>{{ModelResult.PlanPutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.PlanPutyovkaAmount | currency:' '}}</b> сум</td>
                            <td><b>{{ModelResult.RealizPutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.RealizPutyovkaAmount | currency:' '}}</b> сум</td>
                            <td><b>{{ModelResult.OstatokPutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.OstatokPutyovkaAmount | currency:' '}}</b> сум</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px">Реализация</h4>
            <div class="table-responsive box-shadow mb-4"  style="padding-left: 15px; padding-right:15px">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <!--<th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>-->
                            <th class="benefits4">Просмотреть</th>
                            <th>45%</th>
                            <th>100%</th>
                            <th>Бесплатных</th>
                        </tr>
                    </thead>
                    <tbody class="tbody4" style="display:none">
                        <tr>
                            <td></td>
                            <td><b>{{ModelResult.S45PutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.S45PutyovkaAmount | currency:' '}}</b> сум</td>
                            <td><b>{{ModelResult.S100PutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.S100PutyovkaAmount | currency:' '}}</b> сум</td>
                            <td><b>{{ModelResult.S0PutyovkaCount | currency:' '}}</b> шт <b>{{ModelResult.S0PutyovkaAmount | currency:' '}}</b> сум</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px">Задолженность по частичным оплатам</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <!--@*<th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>*@-->
                            <th class="benefits5">Просмотреть</th>
                            <th>Общая сумма <b>{{ModelResult.TotalZadoljennostAmount | currency:' '}}</b> сум</th>
                        </tr>
                    </thead>
             
                    <tbody class="tbody5" style="display:none">
                        <tr ng-repeat="model in ModelResult.ZadoljennostList">
                            <td></td>
                            <td>{{model.RegionName}}</td>
                            <td>{{model.ZadoljennostAmount | currency:' '}} сум</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4" style="margin-bottom:15px">
            <h4 style="text-align:center">Организации</h4>

            <p style="text-align:center">(Платят ЕСП) Всего {{ModelResult.ProfComExists + ModelResult.ProfComNotExists | currency:' '}}</p>
            <div id="chart_div1"  style="margin-bottom:15px">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data1" chart-labels="labels1" chart-options="options"></canvas>
            </div>
            <p style="margin-left:90px"><img src="~/Content/Stat/color1.png" /> {{ModelResult.ProfComExists | currency:' '}} - Есть профком</p>
            <p style="margin-left:90px"><img src="~/Content/Stat/color2.png" /> {{ModelResult.ProfComNotExists | currency:' '}} - Нет профкома</p>
            
        </div>
        <div class="col-md-4">
            <h4 style="text-align:center">Заявки</h4>
            <p style="text-align:center">Всего {{ModelResult.ApprovedZayavka + ModelResult.RejectedZayavka + ModelResult.InProgressZayavka | currency:' '}}</p>
            <div id="chart_div2" style="margin-bottom:15px">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data2" chart-labels="labels2" chart-options="options"></canvas>
            </div>
            <p style="margin-left:90px"><img src="~/Content/Stat/color1.png" /> {{ModelResult.ApprovedZayavka | currency:' '}} - Утвержденные</p>
            <p style="margin-left:90px"><img src="~/Content/Stat/color2.png" /> {{ModelResult.RejectedZayavka | currency:' '}} - Отклонённые</p>
            <p style="margin-left:90px"><img src="~/Content/Stat/color3.png" /> {{ModelResult.InProgressZayavka | currency:' '}} - На рассмотрении</p>
        </div>
        <div class="col-md-4">
            <h4 style="text-align:center">Путевки</h4>
            <p style="text-align:center">Всего на @userName.CurKvartalYear составило : {{ModelResult.OstatokPutyovkas + ModelResult.RealizedPutyovkas + ModelResult.VozvratPutyovkas}}</p>

            <div id="chart_div3" style="margin-bottom:15px">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data3" chart-labels="labels3" chart-options="options"></canvas>
            </div>
            <p style="margin-left:90px"><img src="~/Content/Stat/color1.png" /> {{ModelResult.OstatokPutyovkas | currency:' '}} - Остаток</p>
            <p style="margin-left:90px"><img src="~/Content/Stat/color2.png" /> {{ModelResult.RealizedPutyovkas | currency:' '}} - Реализованные</p>
            <p style="margin-left:90px"><img src="~/Content/Stat/color3.png" /> {{ModelResult.VozvratPutyovkas | currency:' '}} - Возврат</p>
        </div>

    </div>
    <div id="chart_div" style="width: 900px; height: 500px;"></div>
     <script>   
        var flag = 1;
          $('.benefits').click(function(){
            var tbody = $('.tbody');
            
            if(flag == 0)
            {
                tbody.css("display" , "none");
                flag = 1;
            }  
            else
            {
                tbody.css("display", "");
                flag = 0;
            }
            });
            var flag2 = 1;
          $('.benefits2').click(function(){
            var tbody2 = $('.tbody2');
            
            if(flag2 == 0)
            {
                tbody2.css("display" , "none");
                flag2 = 1;
            }  
            else
            {
                tbody2.css("display", "");
                flag2 = 0;
            }
            });
           var flag3 = 1;
          $('.benefits3').click(function(){
            var tbody3 = $('.tbody3');
            
            if(flag3 == 0)
            {
                tbody3.css("display" , "none");
                flag3 = 1;
            }  
            else
            {
                tbody3.css("display", "");
                flag3 = 0;
            }
            });
               var flag4 = 1;
          $('.benefits4').click(function(){
            var tbody4 = $('.tbody4');
            
            if(flag4 == 0)
            {
                tbody4.css("display" , "none");
                flag4 = 1;
            }  
            else
            {
                tbody4.css("display", "");
                flag4 = 0;
            }
            });
          var flag5 = 1;
          $('.benefits5').click(function(){
            var tbody5 = $('.tbody5');
            
            if(flag5 == 0)
            {
                tbody5.css("display" , "none");
                flag5 = 1;
            }  
            else
            {
                tbody5.css("display", "");
                flag5 = 0;
            }
            });
    </script>
</section>