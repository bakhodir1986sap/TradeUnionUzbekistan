@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using KasabaKiat.Helpers;
@using Syncfusion.EJ2
@using Syncfusion.EJ2.PivotView
@{
    ViewBag.Title = "Путевки";
    ViewBag.n = Session["role"];
    var UserId = Convert.ToInt32(User.Identity.Name);
    var userName = UserInfo.GetUserInfo(UserId);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId, true);
}

<script src="~/Scripts/MyJavaScript/Stat/StatFederasiya.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>


<section ng-controller="StatFederasiya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row" style="padding-left:15px !important">
        <div class="col-md-6">
            <h3 style="color:#167f91;font-style:oblique">Аналитика</h3>
            <p style="color:black;font-style:oblique">Время последнего обновления: @ViewBag.LastChangeTime </p><br>

        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Доходы Единый социальный платеж</h4>
            <div class="table-responsive box-shadow mb-12" style="padding-left: 15px; padding-right: 15px">
                @Html.EJS().PivotView("kaznaOplata").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.DataSource).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("OblSovProvAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("FederationAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("OblSovProf").Caption("ОблСовПроф").Add(); rows.Name("Tuman").Caption("Туман").Add();  })
                .Columns(columns => { columns.Name("Year").Caption("Год").Add(); columns.Name("Quarter").Caption("Квартал").Add(); })
                .Values(values => { values.Name("FederationAmount").Caption("Сумма Федерации").Add(); values.Name("OblSovProvAmount").Caption("Сумма области").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Частичная оплата за путевки</h4>
            <div class="table-responsive box-shadow mb-12" style="padding-left: 15px; padding-right: 15px">
                @Html.EJS().PivotView("ChastichkaOplata").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.Chastichka).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("ПрофсоюзНаименование").Add(); })
                .Columns(columns => { columns.Name("year").Caption("Год").Add(); columns.Name("quarter").Caption("Квартал").Add(); })
                .Values(values => { values.Name("amount").Caption("ЧастичкаСумма").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-md-12">
            <h4 style="color:red;padding-left:15px;font-style:oblique">Горящие путевки</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("UrgentPutyovka").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.DataUrgent).ExpandAll(false).EnableSorting(true)
                //.FormatSettings(formatsettings => { formatsettings.Name("FederationAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("OblSovProvAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("Name_San").Caption("Санаторий").Add(); rows.Name("Num_Put").Caption("Номер Путевки").Add(); })
                .Columns(columns => { columns.Name("Year_Op").Caption("Год").Add(); columns.Name("Quarter").Caption("Квартал").Add(); })
                .Values(values => { values.Name("CounterU").Caption("Количество").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Путёвки</h4>
            <p style="padding-left:15px">@userName.CurKvartalYear</p>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("Putyovkas").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.DataPutyovkas).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("RealizAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("OstatokAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("Name_San").Caption("Санаторий").Add(); rows.Name("Num_Put").Caption("Номер путевки").Add(); })
                .Columns(columns => { columns.Name("YEAR_OP").Caption("Год").Add(); columns.Name("QUARTER_op").Caption("Квартал").Add(); })
                .Values(values => { values.Name("RealizCount").Caption("Кол-во Реализация").Add(); values.Name("RealizAmount").Caption("Сумма Реализация").Add(); values.Name("OstatokCount").Caption("Кол-во Остаток").Add(); values.Name("OstatokAmount").Caption("Сумма Остаток").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Реализация</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("Realization").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.RealizData).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("s45Amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("s100Amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("s0Amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("Name_San").Caption("Санаторий").Add(); rows.Name("Num_Put").Caption("Номер Путевки").Add(); })
                .Columns(columns => { columns.Name("YEAR_OP").Caption("Год").Add(); columns.Name("QUARTER_op").Caption("Квартал").Add(); })
                .Values(values => { values.Name("s45Count").Caption("45% Кол-во").Add(); values.Name("s45Amount").Caption("45% Сумма").Add(); values.Name("s100Count").Caption("100% Кол-во").Add(); values.Name("s100Amount").Caption("100% Сумма").Add(); values.Name("s0Count").Caption("Бесплатно кол-во").Add(); values.Name("s0Amount").Caption("Бесплатно Сумма").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Бронированные путевки</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("BronData").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.BronData).ExpandAll(false).EnableSorting(true)
                //.FormatSettings(formatsettings => { formatsettings.Name("BronCount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("s100Amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("s0Amount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("Name_San").Caption("Санаторий").Add(); rows.Name("Num_Put").Caption("Номер Путевки").Add(); })
                .Columns(columns => { columns.Name("YEAR_OP").Caption("Год").Add(); columns.Name("QUARTER_op").Caption("Квартал").Add(); })
                .Values(values => { values.Name("BronCount").Caption("Кол-во").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Задолженность по частичным оплатам</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("Zadoljennost").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.ZadoljennostData).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("ZadolAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("Name_Org").Caption("Организация").Add(); })
                .Columns(columns => { columns.Name("Year").Caption("Год").Add(); })
                .Values(values => { values.Name("ZadolAmount").Caption("Задолженность").Add();  })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Активные пользователи</h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("ActiveUsersData").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.ActiveUsersData).ExpandAll(false).EnableSorting(true)
                //.FormatSettings(formatsettings => { formatsettings.Name("ZadolAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("UserName").Caption("Пользователь").Add(); })
                .Columns(columns => { columns.Name("Year").Caption("Год").Add(); })
                .Values(values => { values.Name("UserCount").Caption("Кол-во").Add();  })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Мониторинг Поступления от Казначейства за последний день </h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("kaznaOplataLastDay").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.PostupleniyaLastDay).ExpandAll(false).EnableSorting(true)
                .FormatSettings(formatsettings => { formatsettings.Name("OblSovProvAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("FederationAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
                .Rows(rows => { rows.Name("OblSovProf").Caption("ОблСовПроф").Add(); rows.Name("Tuman").Caption("Туман").Add();  })
                .Columns(columns => { columns.Name("Year").Caption("Год").Add(); columns.Name("Quarter").Caption("Квартал").Add(); })
                .Values(values => { values.Name("FederationAmount").Caption("Сумма Федерации").Add(); values.Name("OblSovProvAmount").Caption("Сумма области").Add(); })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Мониторинг Перерасход по путевкам </h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("Pererasxod").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.Pererasxod).ExpandAll(false).EnableSorting(true)
              .FormatSettings(formatsettings => { formatsettings.Name("PostupleniyaZaPeriod").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("KolVoFakticheskiPoluch").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
              .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("OrganizationName").Caption("Организации").Add();  })
              .Columns(columns => { columns.Name("YEAR_OP").Caption("Год").Add(); columns.Name("QUATER_OP").Caption("Квартал").Add(); })
              .Values(values => { values.Name("PostupleniyaZaPeriod").Caption("Поступления").Add(); values.Name("KolVoMogutPoluchit").Caption("Получил Путевок").Add(); values.Name("KolVoFakticheskiPoluch").Caption("На сумму").Add();  })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h4 style="padding-left:15px;color:black;font-style:oblique">Оплаты Единого социального платежа от организаций за последний день  </h4>
            <div class="table-responsive box-shadow mb-4" style="padding-left: 15px; padding-right:15px">
                @Html.EJS().PivotView("KaznaOrg").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.OrgCurrent).ExpandAll(false).EnableSorting(true)
              .FormatSettings(formatsettings => { formatsettings.Name("FEDERATION_AMT").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); formatsettings.Name("OBLSOVPROF_AMT").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
              .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Caption("Наименование").Add(); rows.Name("SOATO_NAME").Caption("Район").Add(); rows.Name("NAME_ORG").Caption("Организация").Add(); })
              .Columns(columns => { columns.Name("BRANCH_NAME").Caption("Отрасль").Add(); })
              .Values(values => { values.Name("FEDERATION_AMT").Caption("Федерация сумма").Add(); values.Name("OBLSOVPROF_AMT").Caption("ОблСовпроф сумма").Add();  })).ShowFieldList(true).Locale("fr-CH").GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6" @*style="margin-bottom:15px"*@>
            @(Html.EJS().AccumulationChart("container1").Series(series =>
                                                                            {
                                                                                series.DataLabel(dl => dl.Visible(true).Name("text").Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside).Font(ft => ft.FontWeight("600")))
                                                                            .XName("xValue")
                                                                            .YName("yValue")
                                                                            .Name("Browser")
                                                                            .Type(Syncfusion.EJ2.Charts.AccumulationType.Pie)
                                                                            .Radius("60%")
                                                                            .StartAngle(0)
                                                                            .EndAngle(0)
                                                                            .InnerRadius("0%")
                                                                            .Explode(true)
                                                                            .DataSource(ViewBag.PieChartDataSource).Add();
                                                                            })
                                                                            .EnableAnimation(true)
                                                                            .EnableSmartLabels(true)
                                                                            .Title("Организации")
                                                                            .LegendSettings(ls => ls.Visible(true))
                                                                            .Tooltip(tp => tp.Enable(true).Format("${point.x} : <b>${point.y}%</b>"))
                                                                            .Load("load").Render())
        </div>
        <div class="col-md-6">
            @(Html.EJS().AccumulationChart("container2").Series(series =>
                                                                            {
                                                                                series.DataLabel(dl => dl.Visible(true).Name("text").Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside).Font(ft => ft.FontWeight("600")))
                                                                                    .XName("xValue")
                                                                                    .YName("yValue")
                                                                                    .Name("Browser")
                                                                                    .Type(Syncfusion.EJ2.Charts.AccumulationType.Pie)
                                                                                    .Radius("60%")
                                                                                    .StartAngle(0)
                                                                                    .EndAngle(0)
                                                                                    .InnerRadius("0%")
                                                                                    .Explode(true)
                                                                                    .DataSource(ViewBag.PieChartZayavki).Add();
                                                                            })
                                                                                .EnableAnimation(true)
                                                                                .EnableSmartLabels(true)
                                                                                .Title("Заявки")
                                                                                .LegendSettings(ls => ls.Visible(true))
                                                                                .Tooltip(tp => tp.Enable(true).Format("${point.x} : <b>${point.y}%</b>"))
                                                                                .Load("load").Render())
        </div>
        <div class="col-md-6">
            @(Html.EJS().AccumulationChart("container3").Series(series =>
                                                                            {
                                                                                series.DataLabel(dl => dl.Visible(true).Name("text").Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside).Font(ft => ft.FontWeight("600")))
                                                                                    .XName("xValue")
                                                                                    .YName("yValue")
                                                                                    .Name("Browser")
                                                                                    .Type(Syncfusion.EJ2.Charts.AccumulationType.Pie)
                                                                                    .Radius("60%")
                                                                                    .StartAngle(0)
                                                                                    .EndAngle(0)
                                                                                    .InnerRadius("0%")
                                                                                    .Explode(true)
                                                                                    .DataSource(ViewBag.PieChartPutyovki).Add();
                                                                            })
                                                                                .EnableAnimation(true)
                                                                                .EnableSmartLabels(true)
                                                                                .Title("Путевки")
                                                                                .LegendSettings(ls => ls.Visible(true))
                                                                                .Tooltip(tp => tp.Enable(true).Format("${point.x} : <b>${point.y}%</b>"))
                                                                                .Load("load").Render())
        </div>
    </div>
    <div id="chart_div" style="width: 900px; height: 500px;"></div>
    <script>
        var load = function (args) {
            var selectedTheme = location.hash.split('/')[1];
            selectedTheme = selectedTheme ? selectedTheme : 'Material';
            args.accumulation.theme = (selectedTheme.charAt(0).toUpperCase() + selectedTheme.slice(1));
            args.accumulation.series[0].explodeOffset = "10%";
            args.accumulation.series[0].explodeIndex = 0;
        }


        var flag = 1;
        $('.benefits').click(function () {
            var tbody = $('.tbody');

            if (flag == 0) {
                tbody.css("display", "none");
                flag = 1;
            }
            else {
                tbody.css("display", "");
                flag = 0;
            }
        });
        var flag2 = 1;
        $('.benefits2').click(function () {
