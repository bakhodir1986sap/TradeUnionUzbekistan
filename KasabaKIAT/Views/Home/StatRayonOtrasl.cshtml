@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using KasabaKiat.Helpers;
@{
    ViewBag.Title = "Путевки";
    ViewBag.n = Session["role"];
    var UserId = Convert.ToInt32(User.Identity.Name);
    var userName = UserInfo.GetUserInfo(UserId);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId, true);
}
<script src="~/Scripts/MyJavaScript/Stat/StatRayonOtrasl.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>


<section class="content__block container" ng-controller="StatRayonOtrasl">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row" style="padding-left:15px !important">
        <div class="col-md-6">
            <h4 style="color:#167f91;">Аналитика</h4>
            <p style="">Время последнего обновления: {{ModelResult.LastChangeDate| jsonDate: 'dd.MM.yyyy'}} </p><br>
            <p>Главная</p>
        </div>
        <div class="col-md-6" style="display: flex; align-items: center">
            <p style="padding-bottom:5px">
                <img style="height:17px;width:17px" src="~/Content/Stat/Screen6.png"> - {{ModelResult.BronCount}} брони

            </p>

        </div>
    </div>
    <h4 style="padding-left:15px">Доходы</h4>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        <div class="col-md-12">
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>
                            <th>Общий <br> <b>{{ModelResult.EcpIncome + ModelResult.PartialIncome + ModelResult.OtherIncome}}</b> сум</th>
                            <th>ЕСП <br> <b>{{ModelResult.EcpIncome}}</b> сум</th>
                            <th>Частичные оплаты <br> <b>{{ModelResult.PartialIncome}}</b> сум</th>
                            <th>Прочее <br> <b>{{ModelResult.OtherIncome}}</b> сум</th>

                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        <div class="col-md-6">
            <h4 style="color:red">Горячие путевки</h4>
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <th>Всего <br> <b>{{ModelResult.UrgentPutyovkas}}</b></th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        <div class="col-md-12">
            <h4>Путёвки</h4>
            <p>Кв 2</p>
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>
                            <th>План</th>
                            <th>Реализовано</th>
                            <th>Остаток</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td><b>{{ModelResult.PlanPutyovkaCount}}</b> шт <b>{{ModelResult.PlanPutyovkaAmount}}</b> сум</td>
                            <td><b>{{ModelResult.RealizPutyovkaCount}}</b> шт <b>{{ModelResult.RealizPutyovkaAmount}}</b> сум</td>
                            <td><b>{{ModelResult.OstatokPutyovkaCount}}</b> шт <b>{{ModelResult.OstatokPutyovkaAmount}}</b> сум</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        <div class="col-md-12">
            <h4>Реализация</h4>
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <th class="dropdown">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                            </th>
                            <th>45%</th>
                            <th>100%</th>
                            <th>Бесплатных</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td><b>{{ModelResult.S45PutyovkaCount}}</b> шт <b>{{ModelResult.S45PutyovkaAmount}}</b> сум</td>
                            <td><b>{{ModelResult.S100PutyovkaCount}}</b> шт <b>{{ModelResult.S100PutyovkaAmount}}</b> сум</td>
                            <td><b>{{ModelResult.S0PutyovkaCount}}</b> шт <b>{{ModelResult.S0PutyovkaAmount}}</b> сум</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        <div class="col-md-12">
            <h4>Задолженность по частичным оплатам</h4>
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            @*<th class="dropdown">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></span>

                                </th>*@
                            <th>Общая сумма <b>{{ModelResult.TotalZadoljennostAmount}}</b> сум</th>
                        </tr>
                    </thead>
                </table>
                @*<table class="table table__block t-hover table__small">
                    <tbody>
                        <tr ng-repeat="model in ModelResult.ZadoljennostList">
                            <td></td>
                            <td>{{model.RegionName}}</td>
                            <td>{{model.ZadoljennostAmount}} сум</td>
                        </tr>
                    </tbody>
                </table>*@
            </div>
        </div>
    </div>
    <div class="row" style="padding-left: 15px; padding-right: 15px">
        @*<div class="col-md-4">
            <h4>Организации</h4>

            <p>(Платят ЕСП) Всего {{ModelResult.ProfComExists + ModelResult.ProfComNotExists}}</p>
            <div id="chart_div1">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data1" chart-labels="labels1" chart-options="options"></canvas>
            </div>
        </div>*@
        <div class="col-md-4">
            <h4>Заявки</h4>
            <p>Всего {{ModelResult.ApprovedZayavka + ModelResult.RejectedZayavka + ModelResult.InProgressZayavka}}</p>
            <div id="chart_div2">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data2" chart-labels="labels2" chart-options="options"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <h4>Путевки</h4>
            <p>Всего на @userName.CurKvartalYear составило : {{ModelResult.OstatokPutyovkas + ModelResult.RealizedPutyovkas + ModelResult.VozvratPutyovkas}}</p>

            <div id="chart_div3">
                <canvas id="pie" class="chart chart-pie"
                        chart-data="data3" chart-labels="labels3" chart-options="options"></canvas>
            </div>
        </div>

    </div>
    <div id="chart_div" style="width: 900px; height: 500px;"></div>
</section>