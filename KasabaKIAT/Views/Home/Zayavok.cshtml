@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    FunctionalityList List = new FunctionalityList();
    ViewBag.Title = "Подача заявок";
}
<section class="main__block container-fluid">
    <div class="row no-gutters">
        @if (List.VvodZayavok)
        {
        <div class="col-6 col-sm-3">
            <a href="/Home/PodachaZayavok" class="d-block text-center item load" data-mh="main-item">
                <img src="~/Content/images/main_icon_4.png" alt="" title="" />
                <span class="d-block">Подача заявок</span>
            </a>
        </div>
        }
        @if (List.PoiskIRedaktirovaniyaZayavok)
        {
            <div class="col-6 col-sm-3">
                <a href="/Home/PoiskRedaktZayavok" class="d-block text-center item load" data-mh="main-item">
                    <img src="~/Content/images/main_icon_5.png" alt="" title="" />
                    <span class="d-block">Поиск и редактирование заявок</span>
                </a>
            </div>
        }
    </div>
</section>

