@{
    ViewBag.Title = "Login";
    Layout = "/Views/Shared/_Layout0.cshtml";
    // Layout = null;
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
@*background-image: url(../Content/Login/giphy-downsized-large.gif)*@
<div class="modal" id="myModal" role="dialog" style="background-color:white; margin-top:00px; margin-left:00px; width: 100%; height:100%;">
    <div class="modal-dialog">
        <div id="connection" style="visibility:hidden;position:absolute;margin-left:130px;margin-top:150px;z-index:9999">
            <img src="~/Content/Login/buffering.gif" />
        </div>
        <div class="modal-content" id="modelcon">
            <form class="form-horizontal">
                <span><img src="~/Content/Login/keys.ico" class="myicon" /></span>
                <div class="modal-header">
                    <div id="xabarchi"></div>
                </div>
                <br />
                <div class="form-group">
                    <label for="login" class="col-lg-3 control-label">Логин: </label>
                    <input class="j3 form-control" required type="text" name="login" id="login" placeholder="Login" />
                </div>
                <div class="form-group">
                    <label for="parol" class="col-lg-3 control-label">Пароль: </label>
                    <input class="j4 form-control" required type="password" name="parol" id="parol" placeholder="Parol" />
                </div>
                <div class="modal-footer">
                    <a href="" class="btn btn-primary pull-left RbtnMargin" style="margin-left:300px" id="lp">Войти</a>
                </div>

            </form>
        </div>
    </div>
</div>


<style>
    .modal-dialog {
        max-width: 480px;
        /*background-color: black;*/
    }


    .j3 {
        width: 60%;
        outline: none;
        border-radius: 5px;
        padding: 5px;
        font-size: 15px;
        border: 2px solid #333333;
        text-align: center;
        color: #000;
    }

        .j3:focus {
            border: 2px solid green;
            color: #000;
            background: url(../Content/Login/11.ico) no-repeat;
            background-position: 245px;
        }

    .j4 {
        width: 60%;
        outline: none;
        border-radius: 5px;
        padding: 5px;
        font-size: 15px;
        border: 2px solid #333333;
        text-align: center;
        color: #000;
    }

        .j4:focus {
            border: 2px solid green;
            color: #000;
            background: url(../Content/Login/1.ico) no-repeat;
            background-position: 245px;
        }

    .RbtnMargin {
        margin-left: 40px;
        /*background-color: white;*/
    }

        .RbtnMargin:hover {
            /*background-color: #00ff90;*/
        }

    .failed {
        text-align: center;
        font-weight: bold;
        font-family: 'Times New Roman';
        color: white;
        background-color: red;
    }

    .myicon {
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
</style>
<script>
     $(document).ready(function () {
         $("#myModal").modal({
             backdrop: 'static',
         });
     });
     $("#lp").click(function () {
         document.getElementById('connection').style.visibility = "visible";
         document.getElementById('modelcon').style.visibility = "hidden";
         var d = { login: $("#login").val(), parol: $("#parol").val() };
         $.ajax({
             url: '/Login/Login',
             type: "POST",
             data: d,
             datatype: "json",
             success: function (result)
             {
                 //alert(result);
                 console.log(result);
                 if (result.toString() == "-1")
                 {
                     document.getElementById('modelcon').className = "modal-content";
                     document.getElementById('modelcon').style.visibility = "visible";
                     document.getElementById('connection').style.visibility = "hidden";
                     $("#login").val("");
                     $("#parol").val("");
                     $("#login").focus();
                     $("#xabarchi").html('<div class="failed"> login yoki parol noto`g`ri kiritilgan </div>');
                 }
                 else {
                     if (result.toString() == "-2") {
                         document.getElementById('modelcon').className = "modal-content";
                         document.getElementById('modelcon').style.visibility = "visible";
                         document.getElementById('connection').style.visibility = "hidden";
                         $("#login").val("");
                         $("#parol").val("");
                         $("#login").focus();
                         $("#xabarchi").html('<div class="failed"> login yoki parol maydoni to`ldirilmagan! </div>');
                     } else {
                             if (result.toString() == "-9") {
                                 document.getElementById('modelcon').className = "modal-content";
                                 document.getElementById('modelcon').style.visibility = "visible";
                                 document.getElementById('connection').style.visibility = "hidden";
                                 $("#login").val("");
                                 $("#parol").val("");
                                 $("#login").focus();
                                 $("#xabarchi").html('<div class="failed"> Serverda xatolik yuz berdi! </div>');
                             }
                             else
                             {
                                 window.location.href = "/Home/Putyovki";
                                 //if (result.toString() == "8") {
                                 //    window.location.href = "/Home/Zayavok";
                                 //}
                                 //if (result.toString() == "13") {
                                 //    window.location.href = "/Home/Putyovki";
                                 //}
                             }
                        }
                 }
             },
             error: function (result)
             {
                 console.log("error : "+result);
                 $("#login").val("");
                 $("#parol").val("");
                 $("#login").focus();
                 $("#xabarchi").html('<div class="failed">' + result + 'Xatolik yuz berdi! yana urinib ko`ring...</div>');
             }
         });
     });
</script>



