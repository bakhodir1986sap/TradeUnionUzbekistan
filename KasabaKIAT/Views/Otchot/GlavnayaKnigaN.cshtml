@{
    ViewBag.Title = "Отчеты";
}

<script src="~/Scripts/MyJavaScript/GlavnayaKniga.js"></script>
<div ng-controller="GlavnayaKniga">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="col-md-6 form-group">
        <div class="row">
            <div class="col-md-4 form-group">
                <label>Год</label>
                <select class="custom-select form-control" ng-model="SelectedYear" ng-options="item as item.Year for item in Years track by item.Id" ng-change="FiltersChanged()"></select>
            </div>
            <div class="col-md-4 form-group">
                <label>Квартал</label>
                <select class="custom-select form-control" ng-model="SelectedKvartal" ng-options="item as item.Name_Kv for item in Kvartals track by item.ID" ng-change="FiltersChanged()"></select>
            </div>
        </div>
    </div>
    <div class="mb-5" style="padding-left:20px">
        <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#dobavit" ng-click="LoadDATA()">Показать</a>
        <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2">Очистить фильтр</a>
        <button ng-show="showdata" ng-click="exportData()" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0" ><i class="fas fa-file-excel"></i> Экспорт</button>
    </div>
