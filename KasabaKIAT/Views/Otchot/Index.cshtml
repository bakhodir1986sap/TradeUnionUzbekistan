@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
    ViewBag.Title = "Отчеты";
}
<section class="content__block container">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Отчеты</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    @*<li class="breadcrumb-item load"><a href="/Home/Otchot">Отчеты</a></li>*@
                    @*<li class="breadcrumb-item active" aria-current="page">Отчеты</li>*@
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="list-group r-list-group mb-4 box-shadow">
                @if (List.SvodniyOtchetPoZayavkam)
                {
                    <a href="/Otchot/SvodniyOtchot" class="list-group-item list-group-item-action load">Сводный отчет по заявкам</a>
                }
                @if (List.Talabnomalar)
                {
                    <a href="/Otchot/Talabnomlar" class="list-group-item list-group-item-action load">Талабномалар</a>
                }
                @if (List.FormaN13)
                {
                    <a href="/Otchot/Forma13" class="list-group-item list-group-item-action load">Форма №13 по получению путевок</a>
                }
                @if (List.FormaN14)
                {
                    <a href="/Otchot/Forma14" class="list-group-item list-group-item-action load">Форма №14</a>

                }
                @if (List.TablisaPoUchetuOtdixayushix)
                {
                    <a href="/Otchot/TablitsaOtdixayushix" class="list-group-item list-group-item-action load">Таблица по учету отдыхающих</a>

                }
                @if (List.JurnalniyOrder1)
                {
                    <a href="/Otchot/JurnalniyOrder" class="list-group-item list-group-item-action load">Журнальный ордер</a>

                }
                @if (List.FinansoviyKvartalniy)
                {
                    <a href="/Otchot/FinalniyOtchot" class="list-group-item list-group-item-action load">Финансовый отчет</a>

                }
                @if (List.GlavnayaKniga)
                {
                    <a href="/Otchot/GlavnayaKniga" class="list-group-item list-group-item-action load">Главная книга</a>
                }
                <a href="/Otchot/Postupleniya" class="list-group-item list-group-item-action load">Поступления</a>
                <a href="/Otchot/RazbivkaPostupleniya" class="list-group-item list-group-item-action load">Разбивка поступления</a>
                <a href="/Otchot/PostupleniyaOblastyam" class="list-group-item list-group-item-action load">Поступление По Областям</a>
                <a href="/Otchot/PostupleniyaOtrasli" class="list-group-item list-group-item-action load">Поступление По Отрасли</a>
                <a href="/Otchot/PostupleniyaOkonxu" class="list-group-item list-group-item-action load">Поступление По Оконху</a>
                <a href="/Otchot/PostupleniyaTuman" class="list-group-item list-group-item-action load">Разбивка по Областям и Районам</a>
                <a href="/Otchot/PostupleniyaOblastTumanOtraslGroup" class="list-group-item list-group-item-action load">Разбивка по Районам и отраслям</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Активность пользователя", ReportDescription = "Активность пользователя", Width = 100, Height = 650 })">Активность пользователя</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Бронь по путевкам", ReportDescription = "Бронь по путевкам", Width = 100, Height = 650 })">Бронь по путевкам</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Годовой план по отраслям", ReportDescription = "Годовой план по отраслям", Width = 100, Height = 650 })">Годовой план по отраслям</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "График Заездов Санаториев", ReportDescription = "График Заездов Санаториев", Width = 100, Height = 650 })">График Заездов Санаториев</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Количество Заявок", ReportDescription = "Количество Заявок", Width = 100, Height = 650 })">Количество Заявок</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Количество Заявок в разрезе Санаторий", ReportDescription = "Количество Заявок в разрезе Санаторий", Width = 100, Height = 650 })">Количество Заявок в разрезе Санаторий</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Область - Район - Отрасль", ReportDescription = "Область - Район - Отрасль", Width = 100, Height = 650 })">Область - Район - Отрасль</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Остатки путевок за период", ReportDescription = "Остатки путевок за период", Width = 100, Height = 650 })">Остатки путевок за период</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Поиск по номеру путевки", ReportDescription = "Поиск по номеру путевки", Width = 100, Height = 650 })">Поиск по номеру путевки</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Пользователи", ReportDescription = "Пользователи", Width = 100, Height = 650 })">Пользователи</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Приход путевок за период", ReportDescription = "Приход путевок за период", Width = 100, Height = 650 })">Приход путевок за период</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Приход путевок за период по Санаториям", ReportDescription = "Приход путевок за период по Санаториям", Width = 100, Height = 650 })">Приход путевок за период по Санаториям</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Проводки", ReportDescription = "Проводки", Width = 100, Height = 650 })">Проводки</a>
                <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Реализация путевок", ReportDescription = "Реализация путевок", Width = 100, Height = 650 })">Реализация путевок</a>
            </div>
            <div class="mb-4">
                <a href="/Buxgalter/PlanByudjetaOblasteyNoviy" class="btn btn-blue d-block d-md-inline-block mb-2">Приступить к оформлению</a>
            </div>
        </div>
    </div>
</section>
