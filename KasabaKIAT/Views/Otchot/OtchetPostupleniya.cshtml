@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using KasabaKiat.Helpers;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    var ustinfo = UserInfo.GetUserInfo(UserId);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
    ViewBag.Title = "Отчеты";
}
<section class="content__block container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Отчеты</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты главная</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Отчеты Поступления</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="list-group r-list-group mb-4 box-shadow">
                @if (ustinfo.role_id == 14)
                {
                    <a href="/Otchot/PostupleniyaN" class="list-group-item list-group-item-action load">Поступления по ИНН</a>
                    <a href="/Otchot/RazbivkaPostupleniyaN" class="list-group-item list-group-item-action load">Разбивка поступления</a>
                    <a href="/Otchot/PostupleniyaOblastyam" class="list-group-item list-group-item-action load">Поступление По Областям</a>
                    <a href="/Otchot/PostupleniyaOtrasli" class="list-group-item list-group-item-action load">Поступление По Отрасли</a>
                    <a href="/Otchot/PostupleniyaOkonxu" class="list-group-item list-group-item-action load">Поступление По Оконху</a>
                    <a href="/Otchot/PostupleniyaTuman" class="list-group-item list-group-item-action load">Разбивка по Областям и Районам</a>
                 }


                @if (ustinfo.role_id == 13)
                {
                    <a href="/Otchot/PostupleniyaN" class="list-group-item list-group-item-action load">Поступления по ИНН</a>
                    <a href="/Otchot/RazbivkaPostupleniyaN" class="list-group-item list-group-item-action load">Разбивка поступления</a>

                    //@DEPARTMENT_BASE = N'173О1' OR @DEPARTMENT_BASE = N'173Т2' OR @DEPARTMENT_BASE = N'173Н2'
                    if (ustinfo.DepartmentBase != "173О1" && ustinfo.DepartmentBase != "173Т2" && ustinfo.DepartmentBase != "173Н2")
                    {
                        <a href="/Otchot/PostupleniyaOblastyam" class="list-group-item list-group-item-action load">Поступление По Областям</a>
                        <a href="/Otchot/PostupleniyaOtrasli" class="list-group-item list-group-item-action load">Поступление По Отрасли</a>
                        <a href="/Otchot/PostupleniyaOtrasliPivod" class="list-group-item list-group-item-action load">Поступление По Отрасли Разбивка</a>

                        <a href="/Otchot/PostupleniyaOkonxu" class="list-group-item list-group-item-action load">Поступление По Оконху</a>
                        <a href="/Otchot/PostupleniyaTuman" class="list-group-item list-group-item-action load">Разбивка по Областям и Районам</a>

                        <a id="ReportUrl_Performance" class="list-group-item list-group-item-action load" href="@Url.Action("ReportTemplate", "Report",
                        new { ReportName = "Поступление по ЕСП отрасли", ReportDescription = "Поступление по ЕСП отрасли", Width = 100, Height = 650 })">Поступление по ЕСП отрасли</a>
                    }
                }
            </div>
        </div>
    </div>
</section>
