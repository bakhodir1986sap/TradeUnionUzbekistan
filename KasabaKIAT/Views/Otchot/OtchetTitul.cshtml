@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using KasabaKiat.Helpers;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    var ustinfo = UserInfo.GetUserInfo(UserId);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
    ViewBag.Title = "Отчеты";
}
<section class="content__block container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Отчеты</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb"></ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="list-group r-list-group mb-4 box-shadow">
                @if (List.SvodniyOtchetPoZayavkam)
                {
                    <a href="/Otchot/OtchetZayavki" class="list-group-item list-group-item-action load" style="font-size:large">Заявки</a>
                }
                @if (List.UpravleniyaSpravochnikami)
                {
                    <a href="/Otchot/OtchetOrganizasii" class="list-group-item list-group-item-action load" style="font-size:large">Организации</a>
                }
                @if (List.BuxUchetVvodDannix)
                {
                    <a href="/Otchot/OtchetPostupleniya" class="list-group-item list-group-item-action load" style="font-size:large">Поступление</a>
                }
                @if (List.RealizasiyaPutyovok)
                {
                    <a href="/Otchot/OtchetPutevki" class="list-group-item list-group-item-action load" style="font-size:large">Путевки</a>
                }
                @if (List.FinansoviyKvartalniy)
                {
                    <a href="/Otchot/OtchetBuxgalteriya" class="list-group-item list-group-item-action load" style="font-size:large">Бухгалтерия</a>
                }
                @if (List.JurnalniyOrder1)
                {
                    <a href="/Otchot/OtchetJurnalniyeOrdera" class="list-group-item list-group-item-action load" style="font-size:large">Журнальные Ордера</a>
                }
                @if (List.FinansoviyKvartalniy)
                {
                    <a href="/Otchot/OtchetMonitoring" class="list-group-item list-group-item-action load" style="font-size:large">Мониторинг</a>
                }

                </div>
        </div>
    </div>
</section>
