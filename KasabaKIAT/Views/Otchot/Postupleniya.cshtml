                        <td style="text-align:center">{{item.d23}}</td>
                        <td style="text-align:center">{{item.d24 | jsonDate: 'dd.MM.yyyy'}}</td>*@
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

