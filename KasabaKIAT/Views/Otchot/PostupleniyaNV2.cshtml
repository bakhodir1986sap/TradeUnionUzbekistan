@using Syncfusion.EJ2
@using Syncfusion.EJ2.Inputs
@{
    ViewBag.Title = "Поступления по ИНН";
}
<script src="~/Scripts/MyJavaScript/Postupleniya.js"></script>

<div ng-controller="Postupleniya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Поступления</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Поступления</li>
                    </ol>
                </nav>
            </div>
        </div>
        @using (Html.BeginForm("GetPostupleniyaNV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
            @Html.EJS().TextBox("inn").Placeholder("ИНН").Value((string)ViewBag.Inn).FloatLabelType(FloatLabelType.Auto).Render()
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
        <div class="table-responsive box-shadow mb-4" id="export">
            @Html.EJS().Grid("PostuplniyaN").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
       {
           col.Field("operday").HeaderText("Дата Платежа").MinWidth("10").Add();
           col.Field("inn").HeaderText("ИНН").MinWidth("9").Add();
           col.Field("clname").HeaderText("Клиент").MinWidth("30").Add();
           col.Field("postupleniya").HeaderText("Оплата_ЕСП_всего").Format("").MinWidth("10").Add();
           col.Field("obshiy01").HeaderText("0,1_%_в_Профсоюз").Format("").MinWidth("10").Add();
           col.Field("federation_amt").HeaderText("в_Федерацию").Format("").MinWidth("10").Add();
           col.Field("oblsovprof_amt").HeaderText("в_ОблсовПроф").Format("").MinWidth("10").Add();
           col.Field("purpose").HeaderText("Детали платежа").MinWidth("100").Add();
       }
            ).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
        () { "ExcelExport" }).Render()
            <script>
                function toolbarClick(args) {
                    var gridObj = document.getElementById("PostuplniyaN").ej2_instances[0];
                    if (args.item.id === 'PostuplniyaN_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
        </div>
    </section>
</div>

