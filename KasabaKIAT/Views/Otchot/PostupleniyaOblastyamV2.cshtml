@{
    ViewBag.Title = "Отчеты";
}
@using Syncfusion.EJ2
@*<script src="~/Scripts/MyJavaScript/PostupleniyaOblastyam.js"></script>*@
<div>
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Поступления по областям</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Поступления по областям</li>
                    </ol>
                </nav>
            </div>
        </div>
        @using (Html.BeginForm("GetPostupleniyaOblastyamV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
            <div class="row mb-4 align-items-center" style="padding-left:16px">
                <div>
                    <p>Период с:</p>
                    @Html.EJS().DatePicker("bg").Placeholder("Выберите Дату").Format("yyyy-MM-dd").Value(@ViewBag.BeginDate).Render()
                </div>
                <div style="margin-left:100px">
                    <p>Период по:</p>
                    @Html.EJS().DatePicker("end").Placeholder("Выберите Дату").Format("yyyy-MM-dd").Value(@ViewBag.EndDate).Render()
                </div>
            </div>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
            <div class="table-responsive box-shadow mb-4" id="export">
                @Html.EJS().Grid("PostupleniyaOblastyam").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
                {
                    col.Field("oblastName").HeaderText("Область").MinWidth("30").Add();
                    col.Field("kolvoStrok").HeaderText("Количество Строк").MinWidth("5").Add();
                    col.Field("obshiy01").HeaderText("Всего").Format("").MinWidth("30").Add();
                    col.Field("federation_amount").HeaderText("Сумма Федерации").Format("").MinWidth("30").Add();
                    col.Field("oblast_amount").HeaderText("Сумма области").Format("").MinWidth("30").Add();
                }
                ).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
                () { "ExcelExport" }).Render()
                <script>
                    function toolbarClick(args) {
                        var gridObj = document.getElementById("PostupleniyaOblastyam").ej2_instances[0];
                        if (args.item.id === 'PostupleniyaOblastyam_excelexport') {
                            gridObj.excelExport();
                        }
                    }
                </script>
            </div>
    </section>
</div>



