@{
    ViewBag.Title = "Отчеты";
}
@using Syncfusion.EJ2.DropDowns
@using Syncfusion.EJ2
@using KasabaKIAT.BusinessLogic.Utils
<script src="~/Scripts/MyJavaScript/PostupleniyaOtrasli.js"></script>
<div ng-controller="PostupleniyaOtrasli">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Поступление По Отрасли</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Поступление По Отрасли</li>
                    </ol>
                </nav>
            </div>
        </div>
        @using (Html.BeginForm("GetPostupleniyaOtrasliV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
        <div class="row">
            <div style="width:300px">
                <p>Регион:</p>
                @Html.EJS().ComboBox("region").Placeholder("Выберите регион").PopupHeight("230px").Index(0).DataSource((IEnumerable<CodeDecode>
                )ViewBag.TypeList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).CssClass("form-control").Value(@ViewBag.SelectSoato).Render()
            </div>
            <div style="margin-left:100px;width:300px">
                <p>Период с:</p>
                @Html.EJS().DatePicker("bg").Placeholder("Выберите Дату").CssClass("form-control").Value(@ViewBag.BeginDate).Format("yyyy-MM-dd").Render()
            </div>
            <div style="margin-left:100px;width:300px">
                <p>Период по:</p>
                @Html.EJS().DatePicker("end").Placeholder("Выберите Дату").CssClass("form-control").Value(@ViewBag.EndDate).Format("yyyy-MM-dd").Render()
            </div>
        </div>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
            <div class="table-responsive box-shadow mb-4" id="export">
                @Html.EJS().Grid("PostupleniyaOtrasli").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
                {
                    col.Field("oblastName").HeaderText("Область").MinWidth("30").Add();
                    col.Field("otraslName").HeaderText("Отрасль").MinWidth("30").Add();
                    col.Field("kolvoStrok").HeaderText("Количество Строк").MinWidth("10").Add();
                    col.Field("obshiy01").HeaderText("Всего").Format("").MinWidth("30").Add();
                    col.Field("federation_amount").HeaderText("Сумма Федерации").Format("").MinWidth("30").Add();
                    col.Field("oblast_amount").HeaderText("Сумма области").Format("").MinWidth("30").Add();
                }
                ).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
                () { "ExcelExport" }).Render()

                <script>
                    function toolbarClick(args) {
                        var gridObj = document.getElementById("PostupleniyaOtrasli").ej2_instances[0];
                        if (args.item.id === 'PostupleniyaOtrasli_excelexport') {
                            gridObj.excelExport();
                        }
                    }
                </script>
            </div>
    </section>
</div>



