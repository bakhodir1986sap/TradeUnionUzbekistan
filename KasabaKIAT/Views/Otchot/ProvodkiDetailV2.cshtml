@{
    ViewBag.Title = "Отчеты";
}
<script src="~/Scripts/MyJavaScript/ProvodkiDetail.js"></script>
<div ng-controller="RazbivkaPostupleniya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Проводки Детали</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Разбивка поступления</li>
                    </ol>
                </nav>
            </div>
        </div>
        @using (Html.BeginForm("GetProvodkiDetailV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
            <div class="row">
                <div style="margin-left:20px;width:300px">
                    <p>Период с:</p>
                    @Html.EJS().DatePicker("bg").Placeholder("Выберите Дату").CssClass("form-control").Value(@ViewBag.BeginDate).Format("yyyy-MM-dd").Render()
                </div>
                <div style="margin-left:100px;width:300px">
                    <p>Период по:</p>
                    @Html.EJS().DatePicker("end").Placeholder("Выберите Дату").CssClass("form-control").Value(@ViewBag.EndDate).Format("yyyy-MM-dd").Render()
                </div>
            </div>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
            <div class="table-responsive box-shadow mb-4" id="export">
                @Html.EJS().Grid("ProvodkiDetail").DataSource((IEnumerable<object>)ViewBag.DataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
           {
               col.Field("REC_ID").HeaderText("Ид").MinWidth("5").Add();
               col.Field("TRDT").HeaderText("Дата").MinWidth("15").Add();
               col.Field("DEBIT_ACCOUNT").HeaderText("Дебит").MinWidth("10").Add();
               col.Field("CREDIT_ACCOUNT").HeaderText("Кредит").MinWidth("10").Add();
               col.Field("AMOUNT").HeaderText("Сумма").Format("").MinWidth("10").Add();
               col.Field("DETALI").HeaderText("Детали").MinWidth("50").Add();
               col.Field("ADDITIONAL").HeaderText("Дополнительно").MinWidth("50").Add();
               col.Field("OPISANIYE").HeaderText("Описание").MinWidth("50").Add();
               col.Field("NAME_RU").HeaderText("ЖО").MinWidth("50").Add();
           }
                ).AllowPaging().AllowFiltering().AllowResizing().AllowSorting().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
                () { "ExcelExport" }).Render()
                <script>
                    function toolbarClick(args) {
                        var gridObj = document.getElementById("ProvodkiDetail").ej2_instances[0];
                        if (args.item.id === 'ProvodkiDetail_excelexport') {
                            gridObj.excelExport();
                        }
                    }
                </script>
            </div>
    </section>
</div>



