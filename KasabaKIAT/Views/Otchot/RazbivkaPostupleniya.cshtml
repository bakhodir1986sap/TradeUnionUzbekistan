@{
    ViewBag.Title = "Отчеты";
}
<script src="~/Scripts/MyJavaScript/RazbivkaPostupleniya.js"></script>
<div ng-controller="RazbivkaPostupleniya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Разбивка поступления</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        @*<li class="breadcrumb-item load"><a href="/Home/Otchot">Отчеты</a></li>*@
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Разбивка поступления</li>
                    </ol>
                </nav>
            </div>
        </div>
        <form name="myForm1" novalidate>
            <div class="row mb-4 align-items-center">
                <div>
                    <p>Регион:</p>
                    <select style="width:200px" ng-model="Region" name="Region" required ng-options="d as d.value for d in R track by d.id" class="custom-select form-control"></select>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.Region.$error.required">Выберите поле</span>
                </div>
                <div style="margin-left:100px">
                    <p>Отрасль:</p>
                    <select style="width:200px;" ng-model="Otrasl" required ng-options="item as item.value for item in O track by item.id" class="custom-select form-control" name="Otrasl"></select>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.Otrasl.$error.required">Выберите поле</span>
                </div>
                <div style="margin-left:100px">
                    <p>Период с:</p>
                    <input class="form-control" style="width:200px;" required type="date" ng-model="ZB" id="ZAEZD_BEGIN" name="ZAEZD_BEGIN" />
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.ZAEZD_BEGIN.$error.required">Выберите поле</span>
                </div>
                <div style="margin-left:100px">
                    <p>Период по:</p>
                    <input class="form-control" style="width:200px;" required type="date" ng-model="ZE" id="ZAEZD_END" name="ZAEZD_END" />
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.ZAEZD_END.$error.required">Выберите поле</span>
                </div>
            </div>
            <div class="row mb-4 align-items-center">
                <div>
                    <button ng-click="LoadDATA()" ng-disabled="myForm1.ZAEZD_BEGIN.$error.required||myForm1.ZAEZD_END.$error.required" class="btn btn-blue d-block d-md-inline-block mb-2"> Показать</button>
                </div>
                <div>
                    <button ng-click="Clear()" style="margin-left:200px" class="btn btn-default d-block d-md-inline-block mb-2"> ОЧИСТИТЬ ФИЛЬТР</button>
                </div>
                <div>
                    <button ng-show="showdata" ng-click="exportData()" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0" style="margin-left:500px"><i class="fas fa-file-excel"></i> Экспорт</button>
                </div>
            </div>
        </form>
        @*<form class="row mb-5" name="myForm2" novalidate>
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <input type="text" required class="custom-select form-control" name="INN" ng-model="INN" ng-maxlength="9" ng-minlength="9" ng-change="LoadINN()" placeholder="Инн" />
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm2.INN.$error.required">заполнить поле</span>
                        <span class="alert alert-warning" style="padding:0px" ng-show="!myForm2.INN.$error.required&&!myForm2.INN.$valid">9 шт. номер</span>
                    </div>
                    <div class="col-md-4 form-group">
                        <button ng-show="showdata" ng-click="exportData()" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0" style="margin-left:700px"><i class="fas fa-file-excel"></i> Экспорт</button>
                    </div>
                </div>
            </div>
        </form>*@
        <div ng-show="showdata" class="row mb-4 align-items-center">
            <div class="col-sm-6 text-md-left">
                Количество Разбивка поступления : {{q}}
            </div>
            @*<div ng-repeat="pp_sum in PP_SUM">
                Сумма путевок : {{pp_sum.P_SUM | currency:' '}}
            </div>*@
        </div>
        <div class="table-responsive box-shadow mb-4" ng-show="showdata" id="export">
            <table class="table table__block t-hover">
                <thead>
                    <tr>
                        <th>Тип строки</th>
                        <th>Банковский опердень</th>
                        <th>
                            Уникальный <br />
                            ID поступления в <br />
                            казначействе
                        </th>
                        <th>Уникальный ID банка</th>
                        <th>
                            Казначейский лицевой <br />
                            счет дохода
                        </th>
                        <th>Номер документа</th>
                        <th>Дата документа</th>
                        <th>Тип документа</th>
                        <th>Сумма документа</th>
                        <th>МФО плательщика</th>
                        <th>
                            Банковский счет <br />
                            плательщика
                        </th>
                        <th>ИНН плательщика</th>
                        <th>
                            Наименование счета <br />
                            плательщика
                        </th>
                        <th>МФО получателя</th>
                        <th>
                            Банковский счет <br />
                            получателя
                        </th>
                        <th>ИНН получателя</th>
                        <th>
                            Наименование счета <br />
                            получателя
                        </th>
                        <th>Детали платежа</th>
                        <th>
                            Код организационной <br />
                            классификации <br />
                            плательщика
                        </th>
                        <th>ОКОНХ плательщика</th>
                        <th>Файл ИД</th>
                        <th>Отчислен</th>
                        <th>Общая сумма для Профсоюза</th>
                        <th>Сумма Федерации</th>
                        <th>Сумма области</th>
                        <th>Название области</th>
                        <th>ОКОНХ</th>
                        <th>Отрасль</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="poin" ng-repeat="item in DATA">
                        <td style="text-align:center;">{{item.d1}}</td>
                        <td style="text-align:center">{{item.d2 | jsonDate: 'dd.MM.yyyy'}}</td>
                        <td style="text-align:center">{{item.d3}}</td>
                        <td style="text-align:center">{{item.d4}}</td>
                        <td style="text-align:center">{{item.d5}}</td>
                        <td style="text-align:center">{{item.d6}}</td>
                        <td style="text-align:center">{{item.d7 | jsonDate: 'dd.MM.yyyy'}}</td>
                        <td style="text-align:center">{{item.d8}}</td>
                        <td style="text-align:center">{{item.d9 | currency:' '}}</td>
                        <td style="text-align:center">{{item.d10}}</td>
                        <td style="text-align:center">{{item.d11}}</td>
                        <td style="text-align:center">{{item.d12}}</td>
                        <td style="text-align:center">{{item.d13}}</td>
                        <td style="text-align:center">{{item.d14}}</td>
                        <td style="text-align:center">{{item.d15}}</td>
                        <td style="text-align:center">{{item.d16}}</td>
                        <td style="text-align:center">{{item.d17}}</td>
                        <td style="text-align:center">{{item.d18}}</td>
                        <td style="text-align:center">{{item.d19}}</td>
                        <td style="text-align:center">{{item.d20}}</td>
                        <td style="text-align:center">{{item.d21}}</td>
                        <td style="text-align:center">{{item.d22}}</td>
                        <td style="text-align:center">{{item.d23 | currency:' '}}</td>
                        <td style="text-align:center">{{item.d24 | currency:' '}}</td>
                        <td style="text-align:center">{{item.d25 | currency:' '}}</td>
                        <td style="text-align:center">{{item.d26}}</td>
                        <td style="text-align:center">{{item.d27}}</td>
                        <td style="text-align:center">{{item.d28}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>



