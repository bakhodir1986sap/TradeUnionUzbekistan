        @using (Html.BeginForm("GetRazbivkaPostupleniyaNV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
            <div class="row mb-4 align-items-center" style="padding-left:16px">
                <div>
                    <p>Тип оплаты:</p>
                    @Html.EJS().ComboBox("payType").Placeholder("Выберите тип").PopupHeight("230px").Index(0).DataSource((IEnumerable<CodeDecode>
                    )ViewBag.TypeList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).Render()
                </div>
                <div style="margin-left:100px">
                    <p>Дата:</p>
                    @Html.EJS().DatePicker("bg").Placeholder("Выберите Дату").Render()
                </div>
            </div>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
        @*<div ng-show="showdata" class="row mb-4 align-items-center">
                <div class="col-sm-6 text-md-left">
                    Количество Разбивка поступления : {{q}}
                </div>
            </div>*@
        <div class="table-responsive box-shadow mb-4" id="export">
            @Html.EJS().Grid("RazbivkaPostupleniyaN").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
            {
                col.Field("tuman_shaxar").HeaderText("Район").Width("30").Add();
                col.Field("operday").HeaderText("Банковский опердень").Width("10").Add();
                col.Field("clacc").HeaderText("Счет").Width("20").Add();
                col.Field("inn").HeaderText("ИНН").Width("10").Add();
                col.Field("clmfo").HeaderText("МФО").Width("5").Add();
                col.Field("clname").HeaderText("Клиент").Width("10").Add();

                col.Field("postupleniya").HeaderText("Оплата_ЕСП_всего").Width("10").Add();
                col.Field("obshiy01").HeaderText("0,1_%_в_Профсоюз").Width("10").Add();
                col.Field("federation_amt").HeaderText("в_Федерацию").Width("10").Add();
                col.Field("oblsovprof_amt").HeaderText("в_ОблсовПроф").Width("50").Add();
                col.Field("purpose").HeaderText("Детали платежа").Width("60").Add();
                col.Field("okonx_name").HeaderText("ОКОНХ").Width("10").Add();
                col.Field("branch_name").HeaderText("Отрасль").Width("10").Add();

            }
            ).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
            () { "ExcelExport" }).Render()
            <script>
                function toolbarClick(args) {
                    var gridObj = document.getElementById("RazbivkaPostupleniyaN").ej2_instances[0];
                    if (args.item.id === 'RazbivkaPostupleniyaN_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
