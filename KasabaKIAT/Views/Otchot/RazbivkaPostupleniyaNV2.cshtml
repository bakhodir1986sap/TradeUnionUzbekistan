@{
    ViewBag.Title = "Отчеты";
}
@using Syncfusion.EJ2.DropDowns
@using Syncfusion.EJ2
@using KasabaKIAT.BusinessLogic.Utils
@*<script src="~/Scripts/MyJavaScript/RazbivkaPostupleniya.js"></script>*@
<div ng-controller="RazbivkaPostupleniya">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Разбивка поступления</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Разбивка поступления</li>
                    </ol>
                </nav>
            </div>
        </div>
        @using (Html.BeginForm("GetRazbivkaPostupleniyaNV2", "Otchot", new { page = 1 }, FormMethod.Get))
        {
            <div class="row mb-4 align-items-center" style="padding-left:16px">
                <div>
                    <p>Тип оплаты:</p>
                    @Html.EJS().ComboBox("payType").Placeholder("Выберите тип").PopupHeight("230px").Index(0).DataSource((IEnumerable<CodeDecode>
                    )ViewBag.TypeList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).Value(@ViewBag.SelectedValue).Render()
                </div>
                <div style="margin-left:100px">
                    <p>Дата:</p>
                    @Html.EJS().DatePicker("bg").Placeholder("Выберите Дату").Format("yyyy-MM-dd").Value(@ViewBag.SelectedDate).Render()
                </div>
            </div>
            @Html.EJS().Button("infobtn").Content("Получить").CssClass("e-info").Render()
            @Html.Raw(" ");
        }
        <div class="table-responsive box-shadow mb-4" id="export">
            @Html.EJS().Grid("RazbivkaPostupleniyaN").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=>
            {
                col.Field("tuman_shaxar").HeaderText("Район").MinWidth("30").Add();
                col.Field("operday").HeaderText("Банковский опердень").MinWidth("10").Add();
                col.Field("clacc").HeaderText("Счет").MinWidth("20").Add();
                col.Field("inn").HeaderText("ИНН").MinWidth("10").Add();
                col.Field("clmfo").HeaderText("МФО").MinWidth("5").Add();
                col.Field("clname").HeaderText("Клиент").MinWidth("100").Add();

                col.Field("postupleniya").HeaderText("Оплата_ЕСП_всего").MinWidth("10").Add();
                col.Field("obshiy01").HeaderText("0,1_%_в_Профсоюз").Format("").MinWidth("10").Add();
                col.Field("federation_amt").HeaderText("в_Федерацию").Format("").MinWidth("10").Add();
                col.Field("oblsovprof_amt").HeaderText("в_ОблсовПроф").Format("").MinWidth("10").Add();
                col.Field("purpose").HeaderText("Детали платежа").MinWidth("100").Add();
                col.Field("okonx_name").HeaderText("ОКОНХ").MinWidth("10").Add();
                col.Field("branch_name").HeaderText("Отрасль").MinWidth("10").Add();

            }
            ).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
            () { "ExcelExport" }).Render()
            <script>
                function toolbarClick(args) {
                    var gridObj = document.getElementById("RazbivkaPostupleniyaN").ej2_instances[0];
                    if (args.item.id === 'RazbivkaPostupleniyaN_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
        </div>
    </section>
</div>



