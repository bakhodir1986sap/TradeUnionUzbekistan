@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Отчеты";
}
@using Syncfusion.EJ2
@using Syncfusion.EJ2.PivotView
<script src="~/Scripts/MyJavaScript/O_SOZController.js"></script>
@if (List.SvodniyOtchetPoZayavkam)
{
    <div ng-controller="O_SOZController">
        <div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:100px;z-index:9999">
            <img src="~/Content/Login/buffering.gif" />
        </div>
        <section class="content__block container-fluid">
            <div class="row mb-4 align-items-center">
                <div class="col title__block">
                    <h4>Сводный отчет по заявкам</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb">
                            @*<li class="breadcrumb-item load"><a href="/Home/Otchot">Отчеты</a></li>*@
                            <li class="breadcrumb-item load"><a href="/Otchot/OtchetTitul">Отчеты</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Сводный отчет по заявкам</li>
                        </ol>
                    </nav>
                </div>
            </div>
            @Html.EJS().PivotView("SvodniyPoZayavkam").Width("100%").Height("300").DataSource(dataSource => dataSource.Data((IEnumerable<object>)ViewBag.DateSource).ExpandAll(false).EnableSorting(true)
            //.FormatSettings(formatsettings => { formatsettings.Name("OblSovProvAmount").MaximumSignificantDigits(10).MinimumSignificantDigits(1).UseGrouping(true).Add(); })
            .Rows(rows => { rows.Name("ProfsoyzNaimenovanie").Add(); rows.Name("NameReg").Add(); rows.Name("Name_Ot").Add(); rows.Name("Name_San").Add(); rows.Name("Name_Org").Add(); rows.Name("FULL_NAME").Add(); })
            .Columns(columns => { columns.Name("Year_q").Add(); })
            .Values(values => { values.Name("CountP").Caption("Кол-во").Add(); })).ShowFieldList(true).GridSettings(new PivotViewGridSettings { ColumnWidth = 140 }).Render()
        </section>
    </div>
}


