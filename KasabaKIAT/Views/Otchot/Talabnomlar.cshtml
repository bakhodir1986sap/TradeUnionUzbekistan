@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
@{
    ViewBag.Title = "Отчеты";
}
<script src="~/Scripts/MyJavaScript/O_TController.js"></script>
<script>
    // Change the selector if needed
    var $table = $('table.scroll'),
        $bodyCells = $table.find('tbody tr:first').children(),
        colWidth;

    // Adjust the width of thead cells when window resizes
    $(window).resize(function () {
        // Get the tbody columns width array
        colWidth = $bodyCells.map(function () {
            return $(this).width();
        }).get();

        // Set the width of thead columns
        $table.find('thead tr').children().each(function (i, v) {
            $(v).width(colWidth[i+100]);
        });
    }).resize(); // Trigger resize handler
</script>
<style>
    table.scroll {
        /* width: 100%; */ /* Optional */
        /* border-collapse: collapse; */
        border-spacing: 0;
        /*border: 2px solid black;*/
    }

        table.scroll tbody,
        table.scroll thead {
            display: block;
        }

    thead tr th {
        height: 30px;
        line-height: 30px;
        /* text-align: left; */
    }

    table.scroll tbody {
        height: 300px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    tbody {
        border-top: 2px solid black;
    }

        tbody td, thead th {
            /* width: 20%; */ /* Optional */
            /*border-right: 1px solid black;*/
            /* white-space: nowrap; */
        }

            tbody td:last-child, thead th:last-child {
                border-right: none;
            }
</style>
<style>
    td {
        border: 1px #DDD solid;
        padding: 5px;
        cursor: pointer;
    }

    .selected {
        background-color: #24c0db;
        color: #FFF;
    }
</style>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:200px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.Talabnomalar)
{
    <div ng-controller="O_TController">
        <section class="content__block container-fluid">
            <div class="row mb-4 align-items-center">
                <div class="col title__block">
                    <h4>Талабномалар</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb">
                            @*<li class="breadcrumb-item load"><a href="/Home/Otchot">Отчеты</a></li>*@
                            <li class="breadcrumb-item load"><a href="/Otchot/index">Отчеты</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Талабномалар</li>
                        </ol>
                    </nav>
                </div>
            </div>
            <form name="myForm1" novalidate>
                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <div class="form-group mb-3 mb-md-0">
                            <p>Тип отчета:</p>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" required ng-model="s" ng-change="Load()" name="inlineRadioOptions3" id="inlineRadio1" value="option1" class="custom-control-input" checked="" />
                                <label for="inlineRadio1" class="custom-control-label">По организации</label>
                            </div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" required ng-model="s" ng-change="Load()" name="inlineRadioOptions3" id="inlineRadio2" value="option2" class="custom-control-input" />
                                <label for="inlineRadio2" class="custom-control-label">По отрасли</label>
                            </div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" required ng-model="s" ng-change="Load()" name="inlineRadioOptions3" id="inlineRadio3" value="option3" class="custom-control-input" checked="" />
                                <label for="inlineRadio3" class="custom-control-label">По региону</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-4 align-items-baseline" style="padding-left:16px">
                    <div ng-show="showRegion" id="Region" style="visibility:hidden">
                        <p>Регион:</p>
                        <select style="width:200px" ng-model="Region" name="Region" required ng-options="d as d.value for d in R track by d.id" class="custom-select form-control"></select>
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.Region.$error.required">Выберите поле</span>
                    </div>
                    <div ng-show="showOtrasl" id="Otrasl" style="visibility:hidden;">
                        <p>Отрасль:</p>
                        <select style="width:200px;" ng-model="Otrasl" required ng-options="item as item.value for item in O track by item.id" class="custom-select form-control" name="Otrasl"></select>
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.Otrasl.$error.required">Выберите поле</span>
                    </div>
                    <div ng-show="showINN" id="INN" style="">
                        <p>Инн:</p>
                        <input type="text" required name="INN" ng-model="INN" class="custom-select form-control" ng-maxlength="9" ng-minlength="9" placeholder="Инн" />
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.INN.$error.required">заполнить поле</span>
                        <span class="alert alert-warning" style="padding:0px" ng-show="!myForm1.INN.$error.required&&!myForm1.INN.$valid">9 шт. номер</span>
                        <button style="position:absolute;margin-left:200px;margin-top:-38px" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0" data-toggle="modal" data-target="#dobavit2">Поиск</button>
                    </div>
                    <div style="margin-left:100px">
                        <p>Период:</p>
                        <select ng-model="zb" name="zb" class="custom-select form-control" required>
                            @for (int i = DateTime.Now.Year; i > 1991; i--)
                            {
                                <option>@(i)</option>
                            }
                        </select>
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.zb.$error.required">Выберите поле</span>
                    </div>
                </div>
                <div class="row mb-4 align-items-center" style="padding-left:294px">
                    <div>
                        @*<button ng-click="LoadDATA()" ng-disabled="s!='option1'&&s!='option2'" class="btn btn-blue d-block d-md-inline-block mb-3 mb-md-0"> Показать</button>*@
                        <button ng-click="LoadDATA()" ng-disabled="s!='option2'&&(myForm1.INN.$error.required||(!myForm1.INN.$error.required&&!myForm1.INN.$valid))" class="btn btn-blue d-block d-md-inline-block mb-3 mb-md-0"> Показать</button>
                    </div>
                    <div>
                        <a href="#" ng-click="Clear()" style="margin-left:25px" class="btn btn-default d-block d-md-inline-block mb-3 mb-md-0"> ОЧИСТИТЬ ФИЛЬТР</a>
                    </div>
                    <div>
                        <button ng-show="showdata" ng-click="exportData()" style="margin-left:25px" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0"><i class="fas fa-file-excel"></i> Экспорт</button>
                    </div>
                </div>
            </form>
            <div class="table-responsive box-shadow mb-4" id="export" ng-show="showdata">
                <table class="table table__block t-hover">
                    <thead>
                        <tr>
                            <th class="dropdown dropdown__table">Санаторий</th>
                            <th class="dropdown dropdown__table">1кв</th>
                            <th class="dropdown dropdown__table">2кв</th>
                            <th class="dropdown dropdown__table">3кв</th>
                            <th class="dropdown dropdown__table">4кв</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in O_T">
                            <td>{{item.SN}}</td>
                            <td>{{item.KV1}}</td>
                            <td>{{item.KV2}}</td>
                            <td>{{item.KV3}}</td>
                            <td>{{item.KV4}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <div class="modal__block modal fade" id="dobavit2" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-body">
                        <section class="content__block container-fluid">
                            <div id="connection2" style="visibility:hidden;position:absolute;margin-left:300px;margin-top:100px;z-index:9999">
                                <img src="~/Content/Login/buffering.gif" />
                            </div>
                            <div class="row justify-content-center">
                                <form class="row" name="myForm2" novalidate>
                                    <div class="custom-control-inline" style="margin-left:20px;">
                                        <div>
                                            <p>ИНН:</p>
                                            <input type="text" class="form-control" id="inn1" ng-model="I" placeholder="ИНН" style="width:200px" />
                                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm2.I.$error.required">Выберите поле</span>
                                        </div>
                                        <div style="margin-left:100px">
                                            <p>ИМЯ:</p>
                                            <input type="text" required id="name" class="form-control" ng-model="N" placeholder="ИМЯ" style="width:200px" />
                                            <span class="alert alert-warning" style="padding:0px" ng-show="myForm2.N.$error.required">Выберите поле</span>
                                        </div>
                                        <div style="margin-left:100px">
                                            <button ng-click="LoadDATA2()" class="btn btn-blue d-block d-md-inline-block mb-2" style="margin-top:40px"> Получить</button>
                                        </div>
                                    </div>
                                </form>
                                <div class="table-responsive box-shadow mb-4" ng-show="showdata2" id="export">
                                    @*class="table table-bordered scroll"*@
                                    <table class="scroll" id="table">
                                        <thead>
                                            <tr>
                                                <th style="width:200px;text-align:center">Адрес</th>
                                                <th style="width:200px;text-align:center">Названия</th>
                                                <th style="width:200px;text-align:center">Названия</th>
                                                <th style="width:200px;text-align:center">Инн</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in DATA3" onclick="MyFunction()" ng-click="T(item.d2,item.d4)">
                                                <td style="width:200px">{{item.d1}}</td>
                                                <td style="width:200px">{{item.d2}}</td>
                                                <td style="width:200px">{{item.d3}}</td>
                                                <td style="width:200px">{{item.d4}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <script>
                                        function MyFunction() {
                                            $("#table tr").click(function () {
                                                $(this).addClass('selected').siblings().removeClass('selected');
                                                var value = $(this).find('td:first').html();
                                                //alert("value=" + value);
                                            });
                                        }
                                    </script>
                                </div>
                                <button ng-show="showdata2" ng-click="Tanlash()" data-dismiss="modal">Выбрать</button>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

