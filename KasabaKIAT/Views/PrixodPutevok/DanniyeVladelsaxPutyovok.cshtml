@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    ViewBag.Title = "Данные о владельцах путевок";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/Ilxom/DanniyeVladelsaxPutyovok.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.ProsmotrOstatkaPutyovok)
{
    <div ng-controller="DanniyeVladelsaxPutyovok">

<section class="content__block container">
    <div class="row mb-4">
        <div class="col-sm-6 title__block">
            <h4>Учет и контроль курортно-санаторных путевок</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Учет и контроль курортно-санаторных путевок</li>
                </ol>
            </nav>
        </div>
        <div class="col-sm-6 text-md-right">
            <h5>Общее количество и сумма</h5>
            <ol class="summary-list">
                <li>Количество <span>{{TotalRes.PutyovkaCount}}</span></li>
                <li>Сумма <span>{{TotalRes.SummaNakladnix}}</span></li>
            </ol>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="row">
                <div class="col-md-4 form-group">
                    <label>Период с</label>
                    <input type="date" class="form-control" placeholder="с" ng-model="SelectedBeginDate">
                </div>
                <div class="col-md-4 form-group">
                    <label>Период по</label>
                    <input type="date" class="form-control" placeholder="по" ng-model="SelectedEndDate">
                </div>
                <div class="col-md-4 form-group">
                    <label>ИНН предприятия</label>
                    <select class="custom-select form-control" ng-model="SelectedOrganization" ng-options="item as item.Name_Org for item in OrganizationsL track by item.ID">
                    </select>
                </div>
                <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-toggle="modal" data-target="#organization">Выбрать Организацию</a>
                <a href="#" class="btn btn-green d-block d-md-inline-block mb-2" ng-click="ShowClicked()" >Показать</a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="table-responsive box-shadow mb-4">
                <table class="table table__block t-hover table__small">
                    <thead>
                        <tr>
                            <th class="dropdown dropdown__table">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Дата</span>
                                <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                </div>
                            </th>
                            <th class="dropdown dropdown__table">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">№ документа</span>
                                <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                </div>
                            </th>
                            <th class="dropdown dropdown__table">
                                <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Кол-во</span>
                                <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                </div>
                            </th>
                            <th class="dropdown dropdown__table">
                                <span> Сумма</span>
                                <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                </div>
                            </th>
                        </tr>
                    </thead>
                        <tbody>
                            <tr ng-repeat="dtl in Nakladnoys" ng-click="RowClicked(dtl)">
                                <td>{{dtl.data_post | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{dtl.num_doc}}</td>
                                <td>{{dtl.num_kol}}</td>
                                <td>{{dtl.symma}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-8">
                <div class="table-responsive box-shadow table-fixed-small mb-4">
                    <table class="table table__block table__small">
                        <thead>
                            <tr>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">№</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Санаторий</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Дата выдачи</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">№ путевки</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Процент</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Стоимость</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Примечание</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                                <th class="dropdown dropdown__table">
                                    <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Оплата</span>
                                    <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="putyovka in Putyovkas" ng-click="RowClicked(putyovka)">
                                <td>{{putyovka.id}}</td>
                                <td>{{putyovka.sanatName}}</td>
                                <td>{{putyovka.data_post | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{putyovka.num_put}}</td>
                                <td>{{putyovka.num_proc}}</td>
                                <td>{{putyovka.symma}}</td>
                                <td>{{putyovka.primechaniye}}</td>
                                <td>{{putyovka.oplata}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="row info__cards mt-20">
                    <div class="col-md-4 card">
                        <h6 class="text-center mt-20">Личные данные владельца</h6>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Фамилия:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Фамилия" ng-model="CurrentFace.lastname"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Имя:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Имя" ng-model="CurrentFace.name"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Отчество:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Отчество" ng-model="CurrentFace.firstname"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Пол:</label>
                            <div class="col-md-7">
                                <select class="custom-select form-control" ng-model="SelectedPol" ng-options="item as item.Decode for item in Pols track by item.Code">
                                </select>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Место жительства:</label>
                            <div class="col-md-7">
                                <textarea class="form-control" placeholder="Место жительства" ng-model="CurrentFace.adress"></textarea>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Место работы:</label>
                            <div class="col-md-7">
                                <textarea class="form-control" placeholder="Место работы" ng-model="CurrentFace.rabota"></textarea>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Должность:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Должность" ng-model="CurrentFace.dolj"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Основания выдачи:</label>
                            <div class="col-md-7">
                                <select class="custom-select form-control" ng-model="SelectedOsnovaniyaVidachi" ng-options="item as item.Name_Os for item in Osnovaniyas track by item.ID">
                                </select>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Тип выдачи:</label>
                            <div class="col-md-7">
                                <select class="custom-select form-control" ng-model="SelectedTipVidachi" ng-options="item as item.Name_Os for item in TipVidachies track by item.ID">
                                </select>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Ставка:</label>
                            <div class="col-md-7">
                                <select class="custom-select form-control" ng-model="SelectedProcentZaPutyovki" ng-options="item as item.Name_Proc for item in Procents track by item.ID">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 card">
                        <h6 class="text-center mt-20">Паспортные данные</h6>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Серия:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Серия" ng-model="CurrentFace.pas_ser"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Номер:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" placeholder="Номер" ng-model="CurrentFace.pas_num"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Кем выдан:</label>
                            <div class="col-md-7">
                                <textarea class="form-control" placeholder="Кем выдан" ng-model="CurrentFace.pas_kd"></textarea>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Дата выдачи:</label>
                            <div class="col-md-7">
                                <input type="date" class="form-control" ng-model="CurrentFace.pas_data"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 card">
                        <h6 class="text-center mt-20">Медицинское заключение</h6>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">№ Документа:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" ng-model="CurrentFaceMed.med_doc"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Дата выдачи:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" ng-model="CurrentFaceMed.med_data"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Рекумендуемый санаторий:</label>
                            <div class="col-md-7">
                                <select class="custom-select form-control" ng-model="SelectedRecommendedSanatory" ng-options="item as item.Name_San for item in Sanatories track by item.ID">
                                </select>
                            </div>
                        </div>
                        <h6 class="text-center mt-20">Уплата за путевки</h6>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">№ Документа:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" ng-model="CurrentFaceMed.opl_doc"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Дата оплаты:</label>
                            <div class="col-md-7">
                                <input type="date" class="form-control" ng-model="CurrentFaceMed.opl_data"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Сумма оплаты:</label>
                            <div class="col-md-7">
                                <input type="number" class="form-control" placeholder="0" ng-model="CurrentFaceMed.opl_symma"/>
                            </div>
                        </div>
                        <h6 class="text-center mt-20">Информация о талоне возврата</h6>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">№ Документа:</label>
                            <div class="col-md-7">
                                <input type="text" class="form-control" ng-model="CurrentFaceMed.tal_doc"/>
                            </div>
                        </div>
                        <div class="form-group row align-items-center">
                            <label class="col-md-5 col-form-label text-md-right py-0">Дата приезда:</label>
                            <div class="col-md-7">
                                <input type="date" class="form-control" ng-model="CurrentFaceMed.tal_data"/>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="#" class="btn btn-blue mt-20" ng-click="SaveFaceData()">Сохранить</a>
            </div>
        </div>
        </section>
        <footer class="footer">
            <div class="container">
                <p>&copy;2018</p>
            </div>
        </footer>
        <div class="modal__block modal fade" id="organization" tabindex="-1" role="dialog" aria-labelledby="organizationLabel" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-body" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                        <div class="row mb-4 align-items-center">
                            <div class="col-sm-6 title__block">
                                <h4>Справочник Организаций</h4>
                                <nav aria-label="breadcrumb" class="breadcrumb__block">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item active" aria-current="page">Справочник Организаций</li>
                                    </ol>
                                </nav>
                            </div>
                        </div>
                        <div>
                            <input type="text" placeholder="Наименование" ng-model="FilterName" />
                            <br /><input type="text" placeholder="ИНН" ng-model="FilterInn" /><br />
                            <select class="custom-select" required name="Otrasl" ng-model="FilterSelectedOtrasl" ng-options="item as item.Name_Ot for item in Otrasl track by item.ID_Ot"></select>
                            <br /><br /><button class="btn btn-green" ng-click="GetOrganizationsFilter()"><i class="btn-green"></i> Поиск</button>
                        </div>
                        <div class="table-responsive box-shadow mb-4" id="export">
                            <table class="table table__block t-hover">
                                <thead>
                                    <tr>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Выбор
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Отрасль
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">
                                            Название организации
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            ИНН
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:100px;text-align:center">
                                            Расчетный счет
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            МФО
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Банк
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            ОКОНХ
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Адрес
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Телефон
                                        </th>
                                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                            Район
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="poin" ng-repeat="org in Organizations" ng-click="editOrg(org)">
                                        <td class="custom-control custom-checkbox r-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="customCheck{{org.ID}}"
                                                   ng-model="selectedObjs"
                                                   ng-checked="obj.selected"
                                                   ng-click="toggleObjSelectionOrg($event, org.ID, org.Name_Org)">
                                            <label class="custom-control-label r-label" for="customCheck{{org.ID}}">{{org.ID}}</label>
                                        </td>
                                        <td style="text-align:center">{{org.OtraslName}}</td>
                                        <td style="text-align:center">{{org.Name_Org}}</td>
                                        <td style="text-align:center">{{org.INN     }}</td>
                                        <td style="text-align:center">{{org.RS      }}</td>
                                        <td style="text-align:center">{{org.MFO     }}</td>
                                        <td style="text-align:center">{{org.Bank    }}</td>
                                        <td style="text-align:center">{{org.OKONX   }}</td>
                                        <td style="text-align:center">{{org.Adress  }}</td>
                                        <td style="text-align:center">{{org.Telefon }}</td>
                                        <td style="text-align:center">{{org.RegionName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mb-4 text-right">
                            @*<a href="#" ng-click="SelectOrganization()" class="btn btn-blue d-block d-md-inline-block mb-2" data-dismiss="modal"><i class="fas fa-plus"></i> Выбрать</a>*@
                            <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

