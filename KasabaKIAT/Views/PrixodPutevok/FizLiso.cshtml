@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@{
    ViewBag.Title = "Организации";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/FizLisa.js"></script>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.UpravleniyaSpravochnikami)
{
<div ng-controller="FizLiso">
    <section class="content__block container-fluid">
        <div class="row mb-4 align-items-center">
            <div class="col-sm-6 title__block">
                <h4>База данных физических лиц</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active" aria-current="page">Справочник физических лиц</li>
                    </ol>
                </nav>
            </div>
            <div class="col-sm-3 text-md-right">
                <button ng-click="addOrg()" class="btn btn-red" data-toggle="modal" data-target="#dobavit"><i class="active"></i> Добавить</button>
            </div>
            <div class="col-sm-1 text-md-right">
                <button class="btn btn-green" ng-click="exportData()"><i class="fas fa-file-excel"></i> Экспорт</button>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label>Наименование</label>
                        <input class="form-control" type="text" placeholder="Наименование" ng-model="FilterName" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>ИНН</label>
                        <input class="form-control" type="text" placeholder="ИНН" ng-model="FilterInn" maxlength="9"/><br />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Паспорт серия</label>
                        <input class="form-control" type="text" placeholder="серия" ng-model="FilterSeria" /><br />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Паспорт номер</label>
                        <input class="form-control" type="text" placeholder="номер" ng-model="FilterNomer" /><br />
                    </div>

                </div>
                    <button class="btn btn-green" ng-click="GetOrganizationsFilter()"><i class="btn-green"></i> Поиск</button>
                </div>
              
        </div>
        <style> 
            .activvvv{
                border: 5px solid #24c0db;
            }
        </style>
        <div class="table-responsive box-shadow mb-4" id="export">
            <table class="table table__block t-hover">
                <thead>
                    <tr>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Отрасль
                        </th>
                        <th class="dropdown dropdown__table" style="width:200px;text-align:center">
                            ФИО
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            ИНН
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Адрес
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Телефон
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Паспорт Серия
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Паспорт Номер
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Кем выдан
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Дата выдачи
                        </th>
                        <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                            Район
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="poin" ng-repeat="org in Organizations" ng-click="editOrg(org)" data-toggle="modal" data-target="#dobavit" id="{{org.ID}}">
                        <td style="text-align:center">{{org.OtraslName}}</td>
                        <td style="text-align:center">{{org.Name_Org}}</td>
                        <td style="text-align:center">{{org.INN     }}</td>
                        <td style="text-align:center">{{org.Adress  }}</td>
                        <td style="text-align:center">{{org.Telefon }}</td>
                        <td style="text-align:center">{{org.Pas_ser }}</td>
                        <td style="text-align:center">{{org.Pas_Num }}</td>
                        <td style="text-align:center">{{org.Pas_KD }}</td>
                        <td style="text-align:center">{{org.Pas_Data | jsonDate : "dd.MM.yyyy"}}</td>
                        <td style="text-align:center">{{org.RegionName}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                    <div class="modal-title">
                        <h4 class="text-center mt-4 mb-4">{{Action}} организацию</h4>
                    </div>
                    <div class="row justify-content-center">
                        <form class="col-md-8" name="myForm" novalidate>
                            <input type="hidden" style="position:absolute" ng-model="ID;" />
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0" style="color:red">ФИО:</label>
                                <div class="col-md-7">
                                    <input maxlength="100" type="text" class="form-control" name="Org" ng-model="Organization.Name_Org" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Org.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0" style="color:red">ИНН:</label>
                                <div class="col-md-7">
                                    <input maxlength="9" type="text" class="form-control" name="INN" ng-model="Organization.INN" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.INN.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0" style="color:red">Отрасль:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" required name="Otrasl" ng-model="ModalOtraslSelected" ng-options="item as item.Name_Ot for item in Otrasl track by item.ID_Ot"></select>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Otrasl.$error.required">Выберите поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0" style="color:red">Район:</label>
                                <div class="col-md-7">
                                    <select class="custom-select form-control" required name="Region" ng-model="ModalRegionSelected" ng-options="item as item.NameReg for item in Region track by item.ID"></select>
                                    @*<span class="alert alert-warning" style="padding:0px" ng-show="myForm.Region.$error.required">Выберите поле</span>*@
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Адрес:</label>
                                <div class="col-md-7">
                                    <input maxlength="100" type="text" class="form-control" name="Adress" ng-model="Organization.Adress" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Adress.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Телефон:</label>
                                <div class="col-md-7">
                                    <input maxlength="70" type="text" class="form-control" name="Telefon" ng-model="Organization.Telefon" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Telefon.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Паспорт серия:</label>
                                <div class="col-md-7">
                                    <input maxlength="70" type="text" class="form-control" name="Pas_ser" ng-model="Organization.Pas_ser" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Pas_ser.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Паспорт номер:</label>
                                <div class="col-md-7">
                                    <input maxlength="70" type="text" class="form-control" name="Pas_ser" ng-model="Organization.Pas_Num" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Pas_Num.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label py-0">Кем выдан:</label>
                                <div class="col-md-7">
                                    <input maxlength="70" type="text" class="form-control" name="Pas_ser" ng-model="Organization.Pas_KD" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Pas_KD.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="form-group row align-items-center" style="margin-bottom:80px">
                                <label class="col-md-5 col-form-label py-0">Дата выдачи:</label>
                                <div class="col-md-7">
                                    <input maxlength="70" type="date" class="form-control" name="Pas_Data" ng-model="Organization.Pas_Data" required>
                                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm.Pas_Data.$error.required">заполнить поле</span>
                                </div>
                            </div>
                            <div class="mb-4 text-right" style="position:fixed; top:78%; right:164px">
                                <button ng-click="SaveOrganization()" data-dismiss="modal" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</button>
                                @*<button ng-click="deletePZ(ID)" ng-show="showdelete" data-dismiss="modal" class="btn btn-red d-block d-md-inline-block mb-2">Удалить</button>*@
                                <button class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal__block modal fade" id="organization" tabindex="-1" role="dialog" aria-labelledby="organizationLabel" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document" style="max-width:80%; max-height:70%">
            <div class="modal-content">
                <div class="modal-body" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                    <div class="row mb-4 align-items-center">
                        <div class="col-sm-6 title__block">
                            <h4>Справочник Организаций</h4>
                            <nav aria-label="breadcrumb" class="breadcrumb__block">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item active" aria-current="page">Справочник Организаций</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                    <div>
                    	<div class="row">
                    		<div class="col-md-3">
                       			<input class="form-control" type="text" style="margin-bottom:5px" placeholder="Наименование" ng-model="FilterName" />
                       				<br />
                       		</div>
                       		<div class="col-md-3">	
                       			<input class="form-control" type="text" style="margin-bottom:5px" placeholder="ИНН" ng-model="FilterInn" /><br />
                       		</div>
                       	</div>	
                       		<select class="custom-select" required name="Otrasl" ng-model="FilterSelectedOtrasl"ng-options="item as 		item.Name_Ot for item in Otrasl track by item.ID_Ot"></select>
                       		<br /><br />

                    </div>

                    <button class="btn btn-green" style="float:right; margin-bottom:10px" ng-click="GetOrganizationsFilter()"><i class="btn-green"></i> Поиск</button>

                    <div class="table-responsive box-shadow mb-4" id="export">
                        <table class="table table__block t-hover">
                            <thead>
                                <tr>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Выбор
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Отрасль
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:200px;text-align:center">
                                        Название организации
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        ИНН
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:100px;text-align:center">
                                        Расчетный счет
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        МФО
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Банк
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        ОКОНХ
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Адрес
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Телефон
                                    </th>
                                    <th class="dropdown dropdown__table" style="width:150px;text-align:center">
                                        Район
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="poin" ng-repeat="org in Organizations" ng-click="editOrg(org)">
                                    <td class="custom-control custom-checkbox r-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="customCheck{{org.ID}}"
                                               ng-model="selectedObjs"
                                               ng-checked="obj.selected"
                                               ng-click="toggleObjSelectionOrg($event, org.ID, org.Name_Org)" data-dismiss="modal">
                                        <label class="custom-control-label r-label" for="customCheck{{org.ID}}">{{org.ID}}</label>
                                    </td>
                                    <td style="text-align:center">{{org.OtraslName}}</td>
                                    <td style="text-align:center">{{org.Name_Org}}</td>
                                    <td style="text-align:center">{{org.INN     }}</td>
                                    <td style="text-align:center">{{org.RS      }}</td>
                                    <td style="text-align:center">{{org.MFO     }}</td>
                                    <td style="text-align:center">{{org.Bank    }}</td>
                                    <td style="text-align:center">{{org.OKONX   }}</td>
                                    <td style="text-align:center">{{org.Adress  }}</td>
                                    <td style="text-align:center">{{org.Telefon }}</td>
                                    <td style="text-align:center">{{org.RegionName}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mb-10"></div>
                    <div class="mb-4 text-right" style="position:fixed;bottom:-2%;right:5%; z-index:10">
                        <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

