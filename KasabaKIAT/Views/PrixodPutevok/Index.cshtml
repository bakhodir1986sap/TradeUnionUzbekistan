                                <th class="dropdown dropdown__table">Дата документа</th>
                                <th class="dropdown dropdown__table">Тип выдачи</th>
                                <th class="dropdown dropdown__table">Договор</th>
                                <th class="dropdown dropdown__table">За квартал</th>
                                <th class="dropdown dropdown__table">Дов.№</th>
                                <th class="dropdown dropdown__table">Дата Дов.</th>
                                <th class="dropdown dropdown__table">Кому выдан дов</th>
                                <th class="dropdown dropdown__table">Кол-во Путевок</th>
                                <th class="dropdown dropdown__table">Сумма</th>
                                @*<th class="dropdown dropdown__table">Процент Наценки</th>
