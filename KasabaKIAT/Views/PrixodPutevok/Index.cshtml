                                <td>{{item.d3}}</td>
                                <td>{{item.d4}}</td>
                                <td>{{item.d5 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d6}}</td>
                                <td>{{item.d7 | jsonDate: 'dd.MM.yyyy'}}</td>
                                <td>{{item.d8}}</td>
                                <td>{{item.d12}}</td>
                                <td>{{item.d9}}</td>
                                @*<td>{{item.d10}}</td>
                                <td>{{item.d11}}</td>*@
                                @*<td>{{item.d13}}</td>*@
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
