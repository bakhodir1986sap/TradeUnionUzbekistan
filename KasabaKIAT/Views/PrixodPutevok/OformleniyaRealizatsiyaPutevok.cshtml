
@{
    ViewBag.Title = "Путевки";
}
<script src="~/Scripts/MyJavaScript/OformleniyaRealizatsiyaPutevok.js"></script>
<div ng-controller="OformleniyaRealizatsiyaPutevok">
    <section class="content__block container">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Оформление реализации путевок</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Оформление реализации путевок</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="table__title mb-4">
            <p>Организация: <strong>Профсоюзный комитет Тошкент вилоят ИИБ</strong></p>
        </div>
        <div class="table__title mb-3">
            <h5>Детали заявок</h5>
        </div>
        <div class="table-responsive box-shadow mb-4" id="export">
            <table class="table table__block">
                <thead>
                    <tr>
                        <th>Санаторий</th>
                        <th>№Путевки</th>
                        <th>Даты</th>
                        <th>ФИО отдыхающего</th>
                        <th>Цена</th>
                        <th>Оплата</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr  class="poin" ng-repeat="item in DATA">
                        <td>Турон</td>
                        <td>{{item.serail_number}}</td>
                        <td>10.08.2018-20.08.2017</td>
                        <td>  Каюмов З.Х.</td>
                        <td>1 200 000</td>
                        <td>
                            <input class="form-control" placeholder="100%" />
                        </td>
                        <td>
                            <a href="#" class="table-link" data-toggle="modal" data-target="#zayavki">Заявки</a>
                        </td>
                    </tr>
                    @*<tr ng-repeat="item in DATA_sum">
                        <td colspan="4" class="text-right">Итого:</td>
                        <td colspan="3"><strong>{{item.d1}}</strong></td>
                    </tr>*@
                </tbody>
            </table>
        </div>
        <div class="mb-4">
            <button ng-click="save()" class="btn btn-grey d-block d-md-inline-block my-2">Сохранить</button>
        </div>
    </section>

    <div class="modal__block modal fade" id="zayavki" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="table__title my-4">
                        <p><strong>Проверка утвержденных заявок от<br /> Профсоюзный кометит Тошкент вилоят ИИБ</strong></p>
                    </div>
                    <div class="table-responsive box-shadow mb-4">
                        <table class="table table__block">
                            <thead>
                                <tr>
                                    <th>ФИО</th>
                                    <th>Санаторий</th>
                                    <th>Месяц</th>
                                    <th>Статус заявки</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" name="customRadio" class="custom-control-input" id="customRadio11">
                                            <label class="custom-control-label" for="customRadio11">Рахимов И.Е.</label>
                                        </div>
                                    </td>
                                    <td>Турон</td>
                                    <td>Август</td>
                                    <td>Утверждена</td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" name="customRadio" class="custom-control-input" id="customRadio22">
                                            <label class="custom-control-label" for="customRadio22">Хидоятов У.У.</label>
                                        </div>
                                    </td>
                                    <td>Турон</td>
                                    <td>Август</td>
                                    <td>Утверждена</td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" name="customRadio" class="custom-control-input" id="customRadio33">
                                            <label class="custom-control-label" for="customRadio33">Бабаджанов И.Е.</label>
                                        </div>
                                    </td>
                                    <td>Турон</td>
                                    <td>Август</td>
                                    <td>Утверждена</td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" name="customRadio" class="custom-control-input" id="customRadio44">
                                            <label class="custom-control-label" for="customRadio44">Матдинова У.К.</label>
                                        </div>
                                    </td>
                                    <td>Турон</td>
                                    <td>Август</td>
                                    <td>Утверждена</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mb-4">
                        <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2" data-dismiss="modal" data-toggle="modal" data-target="#history2">Подтвердить</a>
                        <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal__block modal fade" id="history2" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8 pt-5">
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-right py-0">Получатель:</label>
                                <div class="col-md-7">
                                    <input type="text" class="form-control" placeholder="Получатель" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-right py-0">Номер доверенности:</label>
                                <div class="col-md-7">
                                    <input type="text" class="form-control" placeholder="Номер доверенности" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-right py-0">Дата доверенности:</label>
                                <div class="col-md-7">
                                    <input type="text" class="form-control" placeholder="Дата доверенности" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-right py-0">Срок истечения доверенности:</label>
                                <div class="col-md-7">
                                    <input type="text" class="form-control" placeholder="Срок истечения доверенности" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center">
                                <label class="col-md-5 col-form-label text-right py-0">Доверенность .pdf:</label>
                                <div class="col-md-7">
                                    <div class="custom-file">
                                        <input type="file" class="custom-file-input" id="customFile">
                                        <label class="custom-file-label" for="customFile">Выбрать файл</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4 text-right">
                                <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2">Сохранить</a>
                                <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>