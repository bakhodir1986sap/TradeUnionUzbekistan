@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using Syncfusion.EJ2
@{
    ViewBag.Title = "Организации";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}

<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.UpravleniyaSpravochnikami)
{
    <div>
        <section class="content__block container-fluid">
            <div class="row mb-4 align-items-center">
                <div class="col-sm-6 title__block">
                    <h4>База данных организаций</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item active" aria-current="page">Справочник Организаций</li>
                        </ol>
                    </nav>
                </div>
            </div>
         @Html.EJS().Grid("organization").DataSource(dataManager => { dataManager.Url("/PrixodPutevok/GetYurLisoData").Adaptor("UrlAdaptor"); }).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=> {

        col.Field("OblSovProfName").HeaderText("Область").MinWidth("50").Add();
        col.Field("RegionName").HeaderText("Район").MinWidth("40").Add();
        col.Field("Name_Org").HeaderText("Название организации").MinWidth("80").Add();
        col.Field("INN").HeaderText("ИНН Профкома").MinWidth("9").AllowEditing(false).Add();
        col.Field("RS").HeaderText("Расчетный счет").MinWidth("20").Add();
        col.Field("MFO").HeaderText("МФО").MinWidth("5").Add();
        col.Field("Bank").HeaderText("Банк").MinWidth("40").Add();
        col.Field("OKONX").HeaderText("ОКЭД").MinWidth("9").Add();
        col.Field("Adress").HeaderText("Адрес").Width("40").Add();
        col.Field("Telefon").HeaderText("Телефон").Width("40").Add();
        col.Field("OtraslName").HeaderText("Отрасль").MinWidth("30").Add();

        }).AllowPaging().AllowResizing().AllowRowDragAndDrop().AllowSorting().AllowFiltering().Toolbar(new List<string>() { "Search" }).Render()

            <script>
                function toolbarClick(args) {
                    var gridObj = document.getElementById("organization").ej2_instances[0];
                    if (args.item.id === 'organization_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
        </section>
    </div>
}

