                </div>
            </div>
            <div class="accordion mb-4 box-shadow" id="accordion">
                <div class="card r-card"  ng-repeat="rp in RP">
                    <div class="r-card-title">
                        <p>{{rp.d2}}</p>
                    </div>
                    <div class="card-header r-card-header" id="headingOne">
                        <span class="r-header-t"><strong>{{rp.d3}} - {{rp.d4}}</strong> {{rp.d5 | jsonDate: 'dd.MM.yyyy'}} - {{rp.d6 | jsonDate: 'dd.MM.yyyy'}}</span>
                        <span class="r-header-b" ng-show="rp.d7!='0'">{{rp.d7}}</span>
                        <span class="r-header-v" ng-show="rp.d8!='0'">{{rp.d8}}</span>
                        <span  ng-click="data(rp.d1)" class="r-header-a float-right collapsed" data-toggle="collapse" data-target="#collapse{{rp.d1}}" aria-expanded="true" aria-controls="collapseOne"></span>
                    </div>
                    <div id="collapse{{rp.d1}}"  class="collapse" aria-labelledby="headingOne" data-parent="#accordion">
                        <div class="card-body r-card-body"  ng-repeat="rp2 in RP2">
                            <div class="custom-control custom-checkbox r-checkbox">
                                <input type="checkbox" class="custom-control-input" id="customCheck1">
                                <label class="custom-control-label r-label" for="customCheck1"><strong>{{rp2.d3}}</strong> ({{rp2.d4 | jsonDate: 'dd.MM.yyyy'}})<span ng-show="rp2.d5=='1'"><img src="~/Content/images/b-g.png" alt="" title="" /></span><span ng-show="rp2.d6=='1'"><img src="~/Content/images/v-r.png" alt="" title="" /></span></label>
                            </div>
                        </div>
                    </div>
                </div>
