                        <span class="r-header-v" ng-show="rp.d8!='0'">{{rp.d8}}</span>
                        <span  ng-click="data(rp.d1)" class="r-header-a float-right collapsed" data-toggle="collapse" data-target="#collapse{{rp.d1}}" aria-expanded="true" aria-controls="collapseOne"></span>
                    </div>
                    <div id="collapse{{rp.d1}}"  class="collapse" aria-labelledby="headingOne{{rp.d1}}" data-parent="#accordion">
                        <div class="card-body r-card-body"  ng-repeat="rp2 in RP2">
                            <div class="custom-control custom-checkbox r-checkbox">
                                <input type="checkbox" ng-click="BronChange(rp2.d3,rp2.d1)" class="custom-control-input" id="customCheck{{rp2.d3}}"/>
                                <label ng-class="rp2.red" class="custom-control-label r-label" for="customCheck{{rp2.d3}}"><strong>{{rp2.d3}}</strong> ({{rp2.d4 | jsonDate: 'dd.MM.yyyy'}})<span ng-show="rp2.d5=='1'"><img src="~/Content/images/b-g.png" alt="" title="" /></span><span ng-show="rp2.d6=='1'"><img src="~/Content/images/v-r.png" alt="" title="" /></span></label>
                            </div>
                        </div>
                    </div>
                </div>
