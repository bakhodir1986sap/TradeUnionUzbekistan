                    <div class="card-header r-card-header" id="headingOne">
                        <span class="r-header-t"><strong>{{rp.SB}} - {{rp.SE}}</strong> {{rp.RBD | jsonDate: 'dd.MM.yyyy'}} - {{rp.RED | jsonDate: 'dd.MM.yyyy'}}</span>
