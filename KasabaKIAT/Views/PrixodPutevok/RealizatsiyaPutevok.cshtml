<section class="content__block container" ng-controller="RealizatsiyaPutevok">
    <div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Реализация путевок</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Реализация путевок</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="r-title mb-4 row">
                <div class="col-md-6">
                    <h5>Санаторий</h5>
                </div>
                <div class="col-md-6">
                    <span><img src="~/Content/images/b-gr.png" alt="" title="" /> - бронь</span>
                    <span><img src="~/Content/images/v-gr.png" alt="" title="" /> - горящая путевка</span>
                </div>
            </div>
            <div class="accordion mb-4 box-shadow" id="accordion">
                <div class="card r-card"  ng-repeat="rp in RP">
                    <div class="r-card-title">
                        <p>{{rp.d2}}</p>
                    </div>
                    <div class="card-header r-card-header" id="headingOne{{rp.d1}}">
                        <span class="r-header-t"><strong>{{rp.d3}} - {{rp.d4}}</strong> {{rp.d5 | jsonDate: 'dd.MM.yyyy'}} - {{rp.d6 | jsonDate: 'dd.MM.yyyy'}}</span>
                        <span class="r-header-b" ng-show="rp.d7!='0'">{{rp.d7}}</span>
                        <span class="r-header-v" ng-show="rp.d8!='0'">{{rp.d8}}</span>
                        <span  ng-click="data(rp.d1)"  class="r-header-a float-right collapsed" data-toggle="collapse" data-target="#collapse{{rp.d1}}" aria-expanded="true" aria-controls="collapseOne"></span>
                    </div>
                    <div id="collapse{{rp.d1}}"  class="collapse" aria-labelledby="headingOne{{rp.d1}}" data-parent="#accordion">
                        <div class="card-body r-card-body" ng-repeat="rp2 in RP2">
                            <div class="custom-control custom-checkbox r-checkbox" id="checkbox{{rp2.d0}}">
                                <input type="checkbox"  ng-model="rp2.Checked" @*ng-change="checkinTask(rp2)"*@  class="custom-control-input" id="{{'j' + $index}}" name="{{'j' + $index}}"/>
                                <label ng-class="rp2.red"class="custom-control-label r-label"  ng-click="BronChange(rp2)" for="{{'j' + $index}}" id="{{'jG' + $index}}"><strong>{{rp2.d3}}</strong> ({{rp2.d4 | jsonDate: 'dd.MM.yyyy'}})<span ng-show="rp2.d5=='1'"><img src="~/Content/images/b-g.png" alt="" title="" /></span><span ng-show="rp2.d6=='1'"><img src="~/Content/images/v-r.png" alt="" title="" /></span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mb-4">
                <button class="btn btn-grey d-block d-md-inline-block mb-2">Отменить выбор</button>
            </div>
        </div>
        <div class="col-md-6">
            <div class="r-title mb-4">
                <h5>Отрасль</h5>
            </div>
            <div class="mb-5 box-shadow">
                <div class="custom-control custom-radio r-checkbox bgwhite">
                    <input type="radio" name="customRadio" class="custom-control-input" id="customRadio">
                    <label class="custom-control-label r-label" for="customRadio"><strong>Образование</strong> (по плану - 50, Использовано - 20)</label>
                </div>
                <div class="custom-control custom-radio r-checkbox bgwhite">
                    <input type="radio" name="customRadio" class="custom-control-input" id="customRadio1">
                    <label class="custom-control-label r-label" for="customRadio1"><strong>Медицина</strong> (по плану - 30, Использовано - 20)</label>
                </div>
                <div class="custom-control custom-radio r-checkbox bgwhite">
                    <input type="radio" name="customRadio" class="custom-control-input" id="customRadio2">
                    <label class="custom-control-label r-label" for="customRadio2"><strong>Транспорт</strong> (по плану - 100, Использовано - 10)</label>
                </div>
                <div class="custom-control custom-radio r-checkbox bgwhite">
                    <input type="radio" name="customRadio" class="custom-control-input" id="customRadio3">
                    <label class="custom-control-label r-label" for="customRadio3"><strong>Связь</strong> (по плану - 25, Использовано - 5)</label>
                </div>
            </div>
            <div class="mb-5">
                <a href="" class="btn btn-grey d-block d-md-inline-block mb-2">Отменить выбор</a>
            </div>
            <form class="pt-5 mt-5" name="myForm2" novalidate>
                @*<div class="mb-4">
                    <select class="custom-select form-control col-md-6" required ng-model="O" ng-change="LoadINN()" ng-options="d as d.value for d in OR track by d.id" name="O" id="O"></select>
                    <span class="alert alert-warning" style="padding:0px" ng-show="myForm2.O.$error.required">Выберите  </span>
                </div>*@
                <div class="mb-5">
                    <div class="custom-control-inline">
                        <input type="text" required class="custom-select form-control" name="INN" id="inn" ng-model="INN" ng-change="LoadINN()" ng-maxlength="9" ng-minlength="9"  placeholder="Инн" />
                        <span class="alert alert-warning" style="padding:0px;position:absolute;margin-top:40px" ng-show="myForm2.INN.$error.required">заполнить поле</span>
                        <span class="alert alert-warning" style="padding:0px;position:absolute;margin-top:40px" ng-show="!myForm2.INN.$error.required&&!myForm2.INN.$valid">9 шт. номер</span>
                        <button style="margin-left:20px" class="btn btn-green d-block d-md-inline-block mb-3 mb-md-0" data-toggle="modal" data-target="#dobavit">Поиск</button>
                    </div>
                </div>
                <div class="mb-5">
                    <div class="col-md-7">
                        <label  name="O" ng-model="O">{{O}}</label>
                    </div>
                </div>
                <div class="mb-5">
                    <div class="col-md-7">
                        <p id="O"></p>
                    </div>
                </div>
                <div class="r-text mb-4">
                    <p>Организации положено путевок: <strong>6</strong></p>
                    <p class="text-red">Организации выдано путевок: <strong>5</strong></p>
                </div>
                <div class="row mb-4">
                    <div class="col-md-4">
                        <button ng-click="Realiz()" @*ng-disabled="myForm2.O.$error.required"*@ ng-disabled="myForm2.INN.$error.required||!myForm2.INN.$error.required&&!myForm2.INN.$valid" data-toggle="modal" data-target="#dobavit2" class="btn btn-blue d-block mb-2">Реализовать</button>
                        <button ng-click="Bron()" class="btn btn-green d-block mb-2">Забронировать</button>
                        <button ng-click="Snyat()" class="btn btn-grey d-block mb-2">Отменить бронь</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        function INNchange() {
            document.getElementById("O").innerHTML = "";
        }
        function HelloFromChild(inn, name) {
            $('#dobavit').modal('toggle');
            document.getElementById("O").innerHTML = name;
            document.getElementById("inn").value = inn;
        }
    </script>
    <div class="modal__block modal fade" id="dobavit" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="row justify-content-center">
                        <iframe src="/Home/INN" id="youriframeid" width="800" height="800" scrolling="yes"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal__block modal fade" id="dobavit2" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="row justify-content-center">
                        <section class="content__block container">
                            @*<div class="row mb-4 align-items-center">
                                <div class="col title__block">
                                    <h4>Оформление реализации путевок</h4>
                                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                                            <li class="breadcrumb-item active" aria-current="page">Оформление реализации путевок</li>
                                        </ol>
                                    </nav>
                                </div>
                            </div>*@
                            <div class="table__title mb-4">
                                <p>Организация: <strong>Профсоюзный комитет Тошкент вилоят ИИБ</strong></p>
                            </div>
                            <div class="table__title mb-3">
                                <h5>Детали заявок</h5>
                            </div>
                            <div class="table-responsive box-shadow mb-4">
                                <table class="table table__block">
                                    <thead>
                                        <tr>
                                            <th>Санаторий</th>
                                            <th>№Путевки</th>
                                            <th>Даты</th>
                                            <th>ФИО отдыхающего</th>
                                            <th>Цена</th>
                                            <th>Оплата</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in DATA">
                                            <td>{{item.d1}}</td>
                                            <td>{{item.d2}}</td>
                                            <td>{{item.d3 | jsonDate: 'dd.MM.yyyy'}}</td>
                                            <td>{{item.d4}}</td>
                                            <td>{{item.d5}}</td>
                                            <td>
                                                <input class="form-control" ng-model="item.d6" placeholder="100%" />
                                            </td>
                                            <td>
                                                <a ng-click="LoadZ()" ng-disabled="myForm2.INN.$error.required||!myForm2.INN.$error.required&&!myForm2.INN.$valid" class="table-link" data-toggle="modal" data-target="#zayavki">Заявки</a>
                                                <button ng-click="save(item.d0,item.d6)" class="btn btn-blue d-block d-md-inline-block my-2" data-dismiss="modal">Сохранить</button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="mb-4">
                                
                            </div>
                        </section>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal__block modal fade" id="zayavki" tabindex="-1" role="dialog" aria-labelledby="dobavitLabel">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    @*<div class="table__title my-4">
                        <p><strong>Проверка утвержденных заявок от<br /> Профсоюзный кометит Тошкент вилоят ИИБ</strong></p>
                    </div>*@
                    <div class="table-responsive box-shadow mb-4">
                        <table class="table table__block">
                            <thead>
                                <tr>
                                    <th>ФИО</th>
                                    <th>Санаторий</th>
                                    <th>Месяц</th>
                                    <th>Статус заявки</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DATA2">
                                    <td>
                                        <div class="custom-control custom-radio">
                                            <input type="radio" name="customRadio{{item.d0}}" class="custom-control-input" id="customRadio{{item.d0}}">
                                            <label class="custom-control-label" for="customRadio{{item.d0}}">{{item.d1}}</label>
                                        </div>
                                    </td>
                                    <td>{{item.d2}}</td>
                                    <td>{{item.d3 | jsonDate: 'dd.MM.yyyy'}}</td>
                                    <td>{{item.d4}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mb-4">
                        <a href="#" class="btn btn-blue d-block d-md-inline-block mb-2" data-dismiss="modal" data-toggle="modal" data-target="#history2">Подтвердить</a>
                        <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" data-dismiss="modal">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
  
