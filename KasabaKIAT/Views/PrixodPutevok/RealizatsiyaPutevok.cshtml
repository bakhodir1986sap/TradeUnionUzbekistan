
@{
    ViewBag.Title = "Путевки";
}
<script src="//ajax.googleapis.com/ajax/libs/angularjs/1.5.3/angular-animate.js"></script>
<script src="//angular-ui.github.io/bootstrap/ui-bootstrap-tpls-1.3.2.js"></script>
<script src="~/Scripts/MyJavaScript/PPController.js"></script>
@*<h2 style="color:#428bca">Реализация путевок</h2>*@
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;margin-top:100px">
    <img src="~/Content/Login/buffering.gif" />
</div>

<style>
    .fa-caret-right {
        transition: all .4s ease;
    }

    .active .fa-caret-right {
        transform: rotate(90deg);
    }

    .panel {
    }

    body {
        background-color: #f5f5f5;
    }

    .panel-title a {
        text-decoration: none;
    }
</style>

    <div ng-controller="PPController">
        <section class="content__block container">
            <div class="row mb-4 align-items-center">
                <div class="col title__block">
                    <h4>Реализация путевок</h4>
                    <nav aria-label="breadcrumb" class="breadcrumb__block">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Home/Putyovki">Путевки</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Реализация путевок</li>
                        </ol>
                    </nav>
                </div>
            </div>
            <form class="form-group  justify-content-end" name="myForm1" novalidate>
                <div class="col-md-7">
                    <div class="custom-control custom-radio custom-control-inline">
                        <input type="radio" ng-model="s" required ng-change="LoadDATA()" name="RadioOptions" id="inlineRadios1" value="option1" class="custom-control-input" checked="" />
                        <label for="inlineRadios1" class="custom-control-label">Санаторий</label>
                    </div>
                    <div class="custom-control custom-radio custom-control-inline">
                        <input type="radio" ng-model="s" required ng-change="LoadDATA()" name="RadioOptions" id="inlineRadios2" value="option2" class="custom-control-input" />
                        <label for="inlineRadios2" class="custom-control-label">Дет. лагер</label>
                        <span class="alert alert-warning" style="padding:0px" ng-show="myForm1.RadioOptions.$error.required">Выберите поле</span>
                    </div>
                </div>
            </form>
            <div class="col-xs-6">
                <div class="row">
                    <div class="col-xs-6">
                        <h4>{{scname}}</h4>
                        <a href="#"><img src="/Content/icons/order_fire.png"></a>
                    </div>
                    <br />
                    <br />
                    <br />
                    <div class="scroll">
                        <div class="container">
                            <div class="panel-group" id="accordion">
                                <div class="panel panel-default" ng-repeat="rp in RP">
                                    <div class="panel-heading">
                                        <h4 class="panel-title">
                                            <a data-toggle="collapse" ng-click="data(rp.SB,rp.SE)" data-parent="#accordion" href="#collapse{{rp.SB}}">
                                                <i class="fa fa-caret-right"></i> {{rp.SC}}<br /><br />{{rp.SB}} - {{rp.SE}} {{rp.RBD | jsonDate: 'dd.MM.yyyy'}} - {{rp.RED | jsonDate: 'dd.MM.yyyy'}}
                                            </a>
                                        </h4>
                                    </div>
                                    <div id="collapse{{rp.SB}}" ng-show="accordion.current == rp.SB" class="panel-collapse collapse">
                                        <div class="panel-body">
                                            <table class="table table-striped">
                                                <tbody>
                                                    <tr ng-repeat="ar in rr">
                                                        <td style="background: #F8f9f9;">
                                                            <div class="checkbox">
                                                                <label><input type="checkbox" value="" /><p><b>{{ar}}</b>  ({{rp.RBD | jsonDate: 'dd.MM.yyyy'}} - {{rp.RED | jsonDate: 'dd.MM.yyyy'}})</p></label>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- scroll -->
                    <div class="button">
                        <a href="#"><img src="/Content/icons/cancell_button.png"></a>
                    </div>
                </div>
                <!-- row -->
            </div> <!-- colxs6#1 -->
            <div class="col-xs-6">
                <div class="row" style="margin-left: 30px;">

                    <h4>Отрасль</h4>


                    <div class="scroll1">
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="radio">
                                            <label><input type="radio" name="optradio"><p><b>Образование</b>(по плану - 50, Использовано - 20)</p></label>
                                        </div>
                                    </td>

                                </tr>
                                <tr>
                                    <td>
                                        <div class="radio">
                                            <label><input type="radio" name="optradio"><p><b>Медицина</b> (по плану - 30, Использовано - 20)</p></label>
                                        </div>
                                    </td>

                                </tr>
                                <tr>
                                    <td>
                                        <div class="radio">
                                            <label><input type="radio" name="optradio"><p> <b>Транспорт</b> (по плану - 100, Использовано - 10)</p></label>
                                        </div>
                                    </td>

                                </tr>
                                <tr>
                                    <td>
                                        <div class="radio">
                                            <label><input type="radio" name="optradio"><p><b>Связь</b> (по плану - 25, Использовано - 5)</p></label>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="button" style="margin-top:20px;">
                        <a href="#"><img src="/Content/icons/cancell_button.png"></a>
                    </div>
                    <form name="F" class="row">
                        @*<div class="col-xs-5 text-right">
                        <p>Инн:</p>
                    </div>*@
                        <div class="col-xs-6">
                            <input type="text" required class="form-control" name="INN" ng-model="INN" ng-maxlength="9" ng-minlength="9" ng-change="LoadINN()" />
                            <span class="alert alert-warning" style="padding:0px" ng-show="F.INN.$error.required">Выберите поле</span>
                            <span class="alert alert-warning" style="padding:0px" ng-show="!F.INN.$error.required&&!F.INN.$valid">9 шт. номер</span>
                        </div>
                    </form>
                    <div class="row" style="margin-top:15px; margin-left: 13px;">
                        <p style="margin-bottom:0; color: #636363">Организации положено путевок: 6</p>
                        <p style="margin-bottom:0; color: #e66344">Организации выдано путевок: 5</p>
                    </div>
                    <div style="margin-left: 13px;">
                        <p style="margin-top:30px;"><button style="background-color: #24C0DB;" type="button" id="realize" class="btn btn-default">реализовать</button></p>
                        <p><button style="background-color: #58B445;" type="button" id="realize" class="btn btn-default">забронировать</button></p>
                        <p><button type="button" style="background-color: #C7C7C7;" id="realize" class="btn btn-default">отменить выбор</button></p>
                    </div>
                </div>
            </div>
        </section>
    </div>
