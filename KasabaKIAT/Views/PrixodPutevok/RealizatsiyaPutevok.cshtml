                    <div id="collapse{{rp.SB}}"  class="collapse" aria-labelledby="headingOne" data-parent="#accordion">
                        <div class="card-body r-card-body"  ng-repeat="ar in rr">
                            <div class="custom-control custom-checkbox r-checkbox">
                                <input type="checkbox" class="custom-control-input" id="customCheck1">
                                <label class="custom-control-label r-label" for="customCheck1"><strong>{{ar}}</strong> ({{rp.RBD | jsonDate: 'dd.MM.yyyy'}} - {{rp.RED | jsonDate: 'dd.MM.yyyy'}})</label>
