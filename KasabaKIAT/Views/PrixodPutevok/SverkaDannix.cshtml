@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using KasabaKIAT.BusinessLogic.Utils.References
@using KasabaKIAT.BusinessLogic.Utils
@{
    ViewBag.Title = "Путевки";
    var UserId = Convert.ToInt32(User.Identity.Name);
    FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/SverkaDannix.js"></script>
<style>
    .highlightedText {
        background: #ff0000;
    }
</style>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.SverkaDannixPoOtdixayushim)
{
    <section class="content__block container-fluid" ng-controller="SverkaDannix">
        <div class="row mb-4 align-items-center">
            <div class="col title__block">
                <h4>Сверка данных по отдыхающим</h4>
                <nav aria-label="breadcrumb" class="breadcrumb__block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Сверка данных по отдыхающим</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label>Год</label>
                        <select class="custom-select form-control" ng-model="SelectedYear" ng-options="item as item.Year for item in Years track by item.Id"></select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Сторона загрузки</label>
                        <select class="custom-select form-control" ng-model="SelectedSide" ng-options="item as item.Decode for item in Sides track by item.Code"></select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Санаторий</label>
                        <select class="custom-select form-control" ng-model="SelectedSanatory" ng-options="item as item.Name_San for item in Sanatories track by item.ID"></select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label ng-show="SelectedSide.Code">Профсоюз</label>
                        <select class="custom-select form-control" ng-show="SelectedSide.Code" ng-model="SelectedPravsoyuz" ng-options="item as item.ProfsoyzNaimenovanie for item in Pravs track by item.MATCH_DEPARTMENTBASE"></select>
                    </div>
                </div>
            </div>
        </div>
        @Html.ActionLink("Загрузить Шаблон", "DownloadTemplate", "PrixodPutevok")<br /><br />
        <div class="col-md-5 text-md-right">
            <div class="form-inline">
                <input type="file" id="input08" name="UploadedFile" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" onchange="angular.element(this).scope().UploadFiles(this.files)" />
            </div>
            <input type="button" value="Загрузить" class="btn btn-primary" style="margin-top:-65px" ng-disabled="!SelectedFileForUpload" ng-click="SaveDATA() " />
            <input type="button" value="Очистить" class="btn btn-primary" style="margin-top:-65px" ng-click="ClearOblast()" />
        </div>
        <div class="row mb-5">
            <div class="col-lg-9">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <select class="custom-select form-control" ng-model="SelectedYear2" ng-options="item as item.Year for item in Years track by item.Id"></select>
                    </div>
                    @*<div class="col-md-4 form-group">
                            <select class="custom-select form-control" ng-model="SelectedSanatory2" ng-options="item as item.Name_San for item in Sanatories track by item.ID">
                            </select>
                        </div>*@
                    <div class="col-md-4 form-group">
                        <a href="#" ng-click="GetDifferByYearFiles()" class="btn btn-blue d-block">Показать несоответствия</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-lg-6">
                <div class="table-responsive box-shadow mb-4" id="export">
                    <table class="table table__block table-fixed">
                        <thead>
                            <tr>
                                <th>Санаторий</th>
                                <th>Номера путевок</th>
                                <th>Санаторий ФИО</th>
                                <th>Санаторий Адрес</th>
                                <th>Профсоюз ФИО</th>
                                <th>Профсоюз Адрес</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="3">
                                    <a href="#" class="btn btn-grey d-block d-md-inline-block mb-2" ng-click="exportData()">Экспорт</a>
                                    @*<a href="#" class="btn btn-grey d-block d-md-inline-block mb-2">Печать</a>*@
                                </td>
                            </tr>
                            <tr ng-repeat="item2 in DifferByYearFiles">
                                <td>{{item2.SanatName}}</td>
                                <td>{{item2.NumPut}}</td>
                                <td>{{item2.KurortFio}}</td>
                                <td>{{item2.KurortAdress}}</td>
                                <td ng-bind-html="highlight(item2.OblastFio , item2.KurortFio )">{{item2.OblastFio}}</td>
                                <td>{{item2.OblastAdress}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="table-responsive box-shadow mb-5">
            <table class="table table__block va-top t-scroll table__small table-fixed">
                <thead>
                    <tr>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">№ путевки</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Санаторий</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Дата Санатория</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Информация об отдыхающем</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Стоимость</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Место работы</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                        <th class="dropdown dropdown__table">
                            <span class="dropdown-toggle dr-link" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Адрес</span>
                            <div class="dropdown-menu dr-menu rounded-0 border-0" aria-labelledby="dropdownMenuButton">
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in SverkaDatas">
                        <td>{{item.num_put}}</td>
                        <td>{{item.sanatName}}</td>
                        <td>{{item.date_san}}</td>
                        <td>{{item.fio_otdix}}</td>
                        <td>{{item.price}}</td>
                        <td>{{item.work_place}}</td>
                        <td>{{item.adress}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
}

