@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using KasabaKIAT.BusinessLogic.Utils.References
@using KasabaKIAT.BusinessLogic.Utils
@using KasabaKIAT.BusinessLogic.Putyovki.SverkaDannix.Ruchnoy
@{
    ViewBag.Title = "Путевки";
var UserId = Convert.ToInt32(User.Identity.Name);
FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/SverkaDannix.js"></script>
<style>
    .highlightedText {
        background: #ff0000;
    }
</style>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.SverkaDannixPoOtdixayushim)
{
<section class="content__block container-fluid" ng-controller="SverkaDannix">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Сверка данных по отдыхающим</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Сверка данных по отдыхающим</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="row">
                <div class="col-md-3 form-group">
                    <label>Год</label>
                    <select class="custom-select form-control" ng-model="SelectedYear" ng-options="item as item.Year for item in Years track by item.Id"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label>Сторона загрузки</label>
                    <select class="custom-select form-control" ng-model="SelectedSide" ng-options="item as item.Decode for item in Sides track by item.Code"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label>Санаторий</label>
                    <select class="custom-select form-control" ng-model="SelectedSanatory" ng-options="item as item.Name_San for item in Sanatories track by item.ID"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label ng-show="SelectedSide.Code">Профсоюз</label>
                    <select class="custom-select form-control" ng-show="SelectedSide.Code" ng-model="SelectedPravsoyuz" ng-options="item as item.ProfsoyzNaimenovanie for item in Pravs track by item.MATCH_DEPARTMENTBASE"></select>
                </div>
            </div>
        </div>
    </div>
    @Html.ActionLink("Загрузить Шаблон", "DownloadTemplate", "PrixodPutevok")<br /><br />
    <div class="col-md-5 text-md-right">
        <div class="form-inline">
            <input type="file" id="input08" name="UploadedFile" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" onchange="angular.element(this).scope().UploadFiles(this.files)" />
        </div>
        <input type="button" value="Загрузить" class="btn btn-primary" style="margin-top:-65px" ng-disabled="!SelectedFileForUpload" ng-click="SaveDATA() " />
        <input type="button" value="Очистить" class="btn btn-primary" style="margin-top:-65px" ng-click="ClearOblast()" />
    </div>
