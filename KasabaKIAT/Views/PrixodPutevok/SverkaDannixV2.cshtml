        <div class="table-responsive box-shadow mb-5">
            @Html.EJS().Grid("sverkaLoadedData").DataSource((IEnumerable<object>)ViewBag.LoadedDataList).AllowExcelExport().ToolbarClick("toolbarClick2").Columns(col=> {
