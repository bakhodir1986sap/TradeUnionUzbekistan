@using KasabaKIAT.BusinessLogic.Security.Roles.RolePermissions;
@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using KasabaKIAT.BusinessLogic.Utils.References
@using KasabaKIAT.BusinessLogic.Utils
@using KasabaKIAT.BusinessLogic.Putyovki.SverkaDannix.Ruchnoy
@{
    ViewBag.Title = "Путевки";
var UserId = Convert.ToInt32(User.Identity.Name);
FunctionalityList List = FunctionalityAndDbDataMatch.MatchProcess(UserId);
}
<script src="~/Scripts/MyJavaScript/SverkaDannix.js"></script>
<style>
    .highlightedText {
        background: #ff0000;
    }
</style>
<div id="connection" style="visibility:hidden;position:absolute;margin-left:430px;z-index:9999">
    <img src="~/Content/Login/buffering.gif" />
</div>
@if (List.SverkaDannixPoOtdixayushim)
{
<section class="content__block container-fluid" ng-controller="SverkaDannix">
    <div class="row mb-4 align-items-center">
        <div class="col title__block">
            <h4>Сверка данных по отдыхающим</h4>
            <nav aria-label="breadcrumb" class="breadcrumb__block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item load"><a href="/Home/Putyovki">Путевки</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Сверка данных по отдыхающим</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="row">
                <div class="col-md-3 form-group">
                    <label>Год</label>
                    <select class="custom-select form-control" ng-model="SelectedYear" ng-options="item as item.Year for item in Years track by item.Id"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label>Сторона загрузки</label>
                    <select class="custom-select form-control" ng-model="SelectedSide" ng-options="item as item.Decode for item in Sides track by item.Code"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label>Санаторий</label>
                    <select class="custom-select form-control" ng-model="SelectedSanatory" ng-options="item as item.Name_San for item in Sanatories track by item.ID"></select>
                </div>
                <div class="col-md-3 form-group">
                    <label ng-show="SelectedSide.Code">Профсоюз</label>
                    <select class="custom-select form-control" ng-show="SelectedSide.Code" ng-model="SelectedPravsoyuz" ng-options="item as item.ProfsoyzNaimenovanie for item in Pravs track by item.MATCH_DEPARTMENTBASE"></select>
                </div>
            </div>
        </div>
    </div>
    @Html.ActionLink("Загрузить Шаблон", "DownloadTemplate", "PrixodPutevok")<br /><br />
    <div class="col-md-5 text-md-right">
        <div class="form-inline">
            <input type="file" id="input08" name="UploadedFile" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" onchange="angular.element(this).scope().UploadFiles(this.files)" />
        </div>
        <input type="button" value="Загрузить" class="btn btn-primary" style="margin-top:-65px" ng-disabled="!SelectedFileForUpload" ng-click="SaveDATA() " />
        <input type="button" value="Очистить" class="btn btn-primary" style="margin-top:-65px" ng-click="ClearOblast()" />
    </div>
    @using (Html.BeginForm("GetDifferByYearFilesV2", "PrixodPutevok", FormMethod.Get))
    {
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label>Год</label>
                        @Html.EJS().ComboBox("year").Placeholder("Выберите год").PopupHeight("230px").Index(0).DataSource((IEnumerable<Years>
                          )ViewBag.YearsList).Fields(new ComboBoxFieldSettings { Text = "year_id", Value = "year_str" }).Render()
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Санаторий</label>
                        @Html.EJS().ComboBox("sanatory").Placeholder("Выберите санаторий").PopupHeight("230px").Index(0).DataSource((IEnumerable<CodeDecode>
                          )ViewBag.SanatoryList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).Render()
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Профсоюз</label>
                        @Html.EJS().ComboBox("profsoyuz").Placeholder("Выберите профсоюз").PopupHeight("230px").Index(0).DataSource((IEnumerable<CodeDecode>
                          )ViewBag.ProfList).Fields(new ComboBoxFieldSettings { Text = "text", Value = "value" }).Render()
                    </div>
                    <div style="margin-left:160px">
                        <p></p>
                        @Html.EJS().Button("infobtn").Content("Показать несоответствия").CssClass("e-info").Render()
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row mb-12">
        <div class="col-lg-12">
            @Html.EJS().Grid("sverkaResult").DataSource((IEnumerable<object>)ViewBag.ResultSverka).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=> {
            col.Field("SanatName").HeaderText("Санаторий").Width("50").AllowEditing(false).Add();
            col.Field("NumPut").HeaderText("Номера путевок").Width("50").Add();
            col.Field("KurortFio").HeaderText("Санаторий ФИО").Width("50").Add();
            col.Field("KurortAdress").HeaderText("Санаторий Адрес").Width("50").Add();
            col.Field("OblastFio").HeaderText("Профсоюз ФИО").Width("50").Add();
            col.Field("OblastAdress").HeaderText("Профсоюз Адрес").Width("50").Add();
            }).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
                () { "ExcelExport" }).Render()
            <script>
                function toolbarClick(args) {
                    var gridObj = document.getElementById("sverkaResult").ej2_instances[0];
                    if (args.item.id === 'sverkaResult_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
        </div>
    </div>
    @using (Html.BeginForm("GetLoadedRowsV2", "PrixodPutevok", FormMethod.Get))
    {
        <div class="row mb-4">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label>Год</label>
                        @Html.EJS().ComboBox("year2").Placeholder("Выберите год").PopupHeight("230px").Index(0).DataSource((IEnumerable<Years>
                          )ViewBag.YearsList).Fields(new ComboBoxFieldSettings { Text = "year_id", Value = "year_str" }).Render()
                    </div>
                    <div style="margin-left:160px">
                        <p></p>
                        @Html.EJS().Button("infobtn2").Content("Показать Загруженные Данные").CssClass("e-info").Render()
                    </div>
                </div>
            </div>
        </div>
    }
        <div class="table-responsive box-shadow mb-5">
            @Html.EJS().Grid("sverkaLoadedData").DataSource((IEnumerable<object>)ViewBag.LoadedDataList).AllowExcelExport().ToolbarClick("toolbarClick2").Columns(col=> {
           col.Field("num_put").HeaderText("№ путевки").Width("10").AllowEditing(false).Add();
           col.Field("sanatName").HeaderText("Санаторий").Width("50").Add();
           col.Field("date_san").HeaderText("Дата Санатория").Width("10").Add();
           col.Field("fio_otdix").HeaderText("Информация об отдыхающем").Width("50").Add();
           col.Field("price").HeaderText("Стоимость").Width("10").Add();
           col.Field("work_place").HeaderText("Место работы").Width("50").Add();
           col.Field("adress").HeaderText("Адрес").Width("50").Add();
       }).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
        () { "ExcelExport" }).Render()
            <script>
                function toolbarClick2(args) {
                    var gridObj = document.getElementById("sverkaLoadedData").ej2_instances[0];
                    if (args.item.id === 'sverkaLoadedData_excelexport') {
                        gridObj.excelExport();
                    }
                }
            </script>
        </div>
</section>
}

