                            <a class="dropdown-item load" href="/Home/Putyovki?lang=uz"><img src="~/Content/images/Uzbekistan-icon.png" />&nbsp UZB</a>
                            <a class="dropdown-item load" href="/Home/Putyovki?lang=ru"><img src="~/Content/images/RU-Russia-Flag-icon (2).png" />&nbsp RUS</a>

