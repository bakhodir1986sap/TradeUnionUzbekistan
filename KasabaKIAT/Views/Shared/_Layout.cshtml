    <script src="~/Scripts/lib/alertify.min.js"></script>
    <script>
    function reset () {
        $("#toggleCSS").attr("href", "../Content/themes/alertify.default.css");
        alertify.set({
            labels : {
                ok     : "Да",
                cancel : "Нет"
            },
            delay : 5000,
            buttonReverse : false,
            buttonFocus   : "ok"
        });
    }
    </script>
</head>
<body>
    <div id="conn" style="visibility:hidden;position:absolute;margin-left:600px;margin-top:200px;z-index:9999">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <nav class="nav__block">
        <div class="container-fluid navbar navbar-expand-md navbar-light">
            <span class="navbar-brand d-inline-block d-md-none">Навигация</span>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    @if (List.TotalPutyovki)
                    {
                        <li class="nav-item dropdown" id="p">
                            <a id="tours1" class="nav-link" style="visibility:hidden;position:absolute;">Путевки</a>
                            <a disabled class="nav-link dropdown-toggle" href="/Home/Putyovki" id="tours" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Путевки</a>
                            <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="tours">
                                @if (List.GrafikZaezdov)
                                {
                                    <a class="dropdown-item load" href="/GrafikZaezdov/index">График заездов</a>
                                }
                                @if (List.GodovoyPlanPutyovok)
                                {
                                    <a class="dropdown-item load" href="/GodovoyPlan/index">Годовой план</a>
                                }
                                @if (List.RassmotreniyaZayavok)
                                {
                                    <a class="dropdown-item load" href="/Home/RassmotreniyeZayavok">Рассмотрение заявок</a>
                                }
                                @if (List.PrixodPutyovok)
                                {
                                    <a class="dropdown-item load" href="/PrixodPutevok/Index">Приход путевок</a>
                                }
                                @if (List.ProsmotrOstatkaPutyovok)
                                {
                                    <a class="dropdown-item load" href="/PrixodPutevok/ProsmotrOstatPutevok">Просмотр остатков путевок</a>
                                }
                                @if (List.RealizasiyaPutyovok)
                                {
                                    <a class="dropdown-item load" href="/PrixodPutevok/RealizatsiyaPutevok">Реализация путевок</a>
                                }
                                @if (List.ProsmotrRealPutyovok)
                                {
                                    <a class="dropdown-item load" href="/PrixodPutevok/ProsmotrRealzPutevok">Просмотр реализованных путевок</a>
                                }
                                @if (List.SverkaDannixPoOtdixayushim)
                                {
                                    <a class="dropdown-item load" href="/PrixodPutevok/SverkaDannix">Сверка данных по отдыхающим</a>
                                }
                            </div>
                        </li>
                    }
                    @if (List.TotalZayavki)
                    {
                        <li class="nav-item dropdown" id="z">
                            <a id="claims1" class="nav-link" style="visibility:hidden;position:absolute;">Заявки</a>
                            <a class="nav-link dropdown-toggle" href="/Home/Zayavok" id="claims" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Заявки</a>
                            <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="claims">
                                @if (List.VvodZayavok)
                                {
                                    <a class="dropdown-item load" href="/Home/PodachaZayavok">Подача заявок</a>
                                }
                                @if (List.PoiskIRedaktirovaniyaZayavok)
                                {
                                    <a class="dropdown-item load" href="/Home/PoiskRedaktZayavok">Поиск и редактирование заявок</a>
                                }
                            </div>
                        </li>
                    }
                    @if (List.TotalBuxUchet)
                    {
                        <li class="nav-item dropdown" id="b">
                            <a class="nav-link dropdown-toggle" href="/Buxgalter/Index" id="accounting" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Бухгалтерия</a>
                            <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="accounting">
                                @if (List.BuxUchetVvodDannix)
                                {
                                    <a class="dropdown-item load" href="/Buxgalter/VvodDannix">Ввод данных</a>
                                }
                                @if (List.PrasmotrDannix)
                                {
                                    <a class="dropdown-item load" href="/Buxgalter/BU_PrasmotrDannix">Просмотр</a>
                                }
                                <a class="dropdown-item load" href="/Buxgalter/OsushestvleniyeProvodki">Осуществление проводки</a>
                                @if (List.PlatejniyePorucheniya)
                                {
                                    <a class="dropdown-item load" href="/PlatejnoyePorucheniye/Index">Платежные поручения</a>
                                }
                                <a class="dropdown-item load" href="/Buxgalter/Nakladniye">Накладные</a>
                                <a class="dropdown-item load" href="/Buxgalter/PlanByudjetaOblastey">План бюджета областей</a>
                                @if (List.RaznoskaDannixPoOtraslyam)
                                {
                                    @*<a class="dropdown-item load" href="/Buxgalter/RaspredleniyeByudjeta">Распределение бюджета по отраслям</a>*@
                                }
                            </div>
                        </li>
                    }
                    @if (List.TotalReports)
                    {
                        <li class="nav-item" id="o">
                            <a class="nav-link load" href="/Otchot/index">Отчеты</a>
                        </li>

                    }
                    @if (List.TotalAdmin)
                    {
                        <li class="nav-item dropdown" id="a">
                            <a class="nav-link dropdown-toggle" href="/Home/Admin" id="administration" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Администрирование</a>
                            <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="administration">
                                @if (List.SozdaniyaUchetnixZapisey)
                                {
                                    <a class="dropdown-item load" href="/Administirirovaniye/UchetniyZapis">Пользователи</a>
                                }
                                @if (List.SozdaniyaRoley)
                                {
                                    <a class="dropdown-item load" href="/Administirirovaniye/SozdaniyeRoley">Ролей</a>
                                }
                                @if (List.SozdaniyaProvodok)
                                {
                                    <a class="dropdown-item load" href="/Administirirovaniye/SozdaniyeProvodok">Создание проводок</a>
                                }
                                @if (List.PrivyazkaProvodokkJO)
                                {
                                    <a class="dropdown-item load" href="/Administirirovaniye/PrivyazkaProvodok">Привязка проводок к ЖО</a>
                                }
                                @if (List.UpravleniyaSpravochnikami)
                                {
                                    <a class="dropdown-item load" href="/Administirirovaniye/Spravichniki">Справочники</a>
                                    <a class="dropdown-item load" href="/Administirirovaniye/SpravichnikiKurortnovoUpravleniya">Справочник СКУ</a>
                                }
                            </div>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><p style="margin-top:21px">@Session["name"]</p></li>
                    <li class="nav-item">
                        <a class="nav-link" id="ch" href="#">Выход</a>
                    </li>
                </ul>
                @*<script>
                if ("@ViewBag.Title" == "Подача заявок") {
