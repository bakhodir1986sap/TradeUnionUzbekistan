            <div class="container">
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Путевки", "Index", "Home",new { style = "color:#FFF;font-size:24px;font-family:'Times New Roman'" })</li>
                        <li>@Html.ActionLink("Заявки", "PodachaZayavok", "Home", new { style = "color:#FFF;font-size:24px;font-family:'Times New Roman'" })</li>
                        <li>@Html.ActionLink("бухгалтерия", "About", "Home", new { style = "color:#FFF;font-size:24px;font-family:'Times New Roman'" })</li>
                        <li>@Html.ActionLink("Отчеты", "Contact", "Home", new { style = "color:#FFF;font-size:24px;font-family:'Times New Roman'" })</li>
                        <li>@Html.ActionLink("Администрирование", "Admin", "Home", new { style = "color:#FFF;font-size:24px;font-family:'Times New Roman'" })</li>
