    <div class="body-content">
        @RenderBody()
        @*@(Html.EJS().ScriptManager())*@
    </div>
    <footer class="fixed-bottom">
        <div><span id="general_notification" style="color:black;font-size:15px;"></span></div>
        <div><span id="urgent_notification" style="color:red;font-size:15px; font-style:oblique"></span></div>
    </footer>
    <script>
        $(".load").on('click', function () {
            document.getElementById('conn').style.visibility = "visible";
            $("#hh").modal({
                backdrop: 'static',
                backdrop: 'static'
            });
        });
        $("#ch").on('click', function () {
            document.getElementById('conn').style.visibility = "visible";
            $("#hh").modal({
                backdrop: 'static',
                backdrop: 'static'
            });
            reset();
            alertify.set({ buttonFocus: "cancel" });
            alertify.confirm('@ContentData.XotiteViyti', function (e) {
                if (e) {
                    alertify.success('@ContentData.OperasiyaVipolnyaetsya');
                    window.location.href = "/Login/SignOut";
                } else {
                    document.getElementById('conn').style.visibility = "hidden";
                    $("#hh").modal('hide');
                    alertify.error('@ContentData.OperasiyaOtmenena');
                }
            });
            return false;
        });
    </script>
    <script src="~/Scripts/vendor.js"></script>

    <script src="~/Scripts/plugins.js"></script>

    <script src="~/Scripts/main.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.3.min.js"></script>
    <!--Ссылка на автоматически сгенерированный скрипт хаба SignalR -->
    <script src="~/signalr/hubs"></script>
    <script type="text/javascript">
        $(function () {

            var notificationhub = $.connection.notificationHub;

            notificationhub.client.displayMessage = function (message) {

                var str = message;

                var cmd = message.substr(0, 2);

                if (cmd === '99') {
                    $('#urgent_notification').html(message.substr(2, str.length - 2));
                }
                else {
                    $('#general_notification').html(message);
                }

            };

            $.connection.hub.start();

        });
    </script>
    <input id="hh" type="hidden" />
    <a href="#0" class="cd-top js-cd-top">Top</a>
    <script src="~/Scripts/MyJavaScript/ButtonUp.js"></script>
    @RenderSection("scripts", required: false)
    @Html.EJS().ScriptManager()
</body>
</html>
