                    }
                    if ("@ViewBag.Title" == "бухгалтерия") {
                        document.getElementById("b").className = "nav-item dropdown show";
                        document.getElementById("b").style = "";
                    }
                </script>*@
            </div>
        </div>
    </nav>
    <div class="body-content">
        @RenderBody()
    </div>
    <script>
                    $(".load").on('click', function () {
                        document.getElementById('conn').style.visibility = "visible";
                        $("#hh").modal({
                            backdrop: 'static',
                            backdrop: 'static'
                        });
                    });
                    $("#ch").on('click', function () {
                        document.getElementById('conn').style.visibility = "visible";
                        $("#hh").modal({
                            backdrop: 'static',
                            backdrop: 'static'
                        });
                        reset();
                        alertify.set({ buttonFocus: "cancel" });
                        alertify.confirm("Вы действительно хотите выйти?", function (e) {
                            if (e) {
                                alertify.success("Операция выполняется");
                                window.location.href = "/Login/SignOut";
                            } else {
                                document.getElementById('conn').style.visibility = "hidden";
                                $("#hh").modal('hide');
                                alertify.error("Операция отменена");
                            }
                        });
                        return false;
                    });
    </script>
    <script src="~/Scripts/vendor.js"></script>

    <script src="~/Scripts/plugins.js"></script>

    <script src="~/Scripts/main.js"></script>
    <style>
        /*.active {
            color: black;
            background-color: white;
        }*/
         .poin:hover {
            cursor: pointer;
        }
    </style>
    <input id="hh" type="hidden" />
    @*@Scripts.Render("~/bundles/jquery")*@
    @*@Scripts.Render("~/bundles/bootstrap")*@
    @RenderSection("scripts", required: false)
</body>
