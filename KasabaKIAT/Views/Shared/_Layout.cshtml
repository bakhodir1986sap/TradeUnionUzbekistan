<!DOCTYPE html>
<html ng-app="mvcCRUDApp" class="no-js" lang="">
<head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewBag.Title</title>
    @*<meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewBag.Title - My ASP.NET Application</title>*@
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link href="https://use.fontawesome.com/releases/v5.0.2/css/all.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/styles/main.css">
    <script src="~/Scripts/vendor/modernizr.js"></script>
    
    @*<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/main.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.css" rel="stylesheet" />*@

    <link href="~/Content/themes/alertify.default.css" rel="stylesheet" />
    <link href="~/Content/themes/alertify.core.css" rel="stylesheet" />
    <link href="~/Content/themes/alertify.bootstrap.css" rel="stylesheet" />
    @*<link href="~/Content/styles/kendo.common.min.css" rel="stylesheet" />
    <link href="~/Content/styles/kendo.office365.min.css" rel="stylesheet" />*@
    <script src="~/Scripts/kendo/angular.min.js"></script>
    <script src="~/Scripts/MyJavaScript/Module.js"></script>
    <script src="~/Scripts/MyJavaScript/KasabaKIATService.js"></script>
    
    @*@Styles.Render("~/Content/css")*@
    @Scripts.Render("~/bundles/modernizr")
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="https://fastcdn.org/FileSaver.js/1.1.20151003/FileSaver.min.js"></script>
    @*<script src="~/Scripts/kendo/kendo.all.min.js"></script>*@
    <script src="~/Scripts/lib/alertify.min.js"></script>
    <script>
    function reset () {
        $("#toggleCSS").attr("href", "../Content/themes/alertify.default.css");
        alertify.set({
            labels : {
                ok     : "Да",
                cancel : "Нет"
            },
            delay : 5000,
            buttonReverse : false,
            buttonFocus   : "ok"
        });
    }
    </script>
</head>
<body>
    <div id="conn" style="visibility:hidden;position:absolute;margin-left:530px;margin-top:200px">
        <img src="~/Content/Login/buffering.gif" />
    </div>
    <nav class="nav__block">
        <div class="container-fluid navbar navbar-expand-md navbar-light">
            <span class="navbar-brand d-inline-block d-md-none">Навигация</span>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item dropdown" id="p">
                        <a class="nav-link dropdown-toggle" href="tours.html" id="tours" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Путевки</a>
                        <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="tours">
                            <a class="dropdown-item" href="/GrafikZaezdov/index">График заездов</a>
                            <a class="dropdown-item" href="/GodovoyPlan/index">Годовой план</a>
                            <a class="dropdown-item" href="/PrixodPutevok/index">Приход путевок</a>
                            <a class="dropdown-item" href="/PrixodPutevok/ProsmotrOstatPutevok">Просмотр остатков путевок</a>
                            <a class="dropdown-item" href="/PrixodPutevok/RealizatsiyaPutevok">Реализация путевок</a>
                            <a class="dropdown-item" href="/Home/ProsmotrRealzPutevok">Просмотр реализованных путевок</a>
                            <a class="dropdown-item" href="/Home/SverkaDannix">Сверка данных по отдыхающим</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown" id="z">
                        <a class="nav-link dropdown-toggle" href="claims.html" id="claims" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Заяки</a>
                        <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="claims">
                            <a class="dropdown-item" href="/Home/PodachaZayavok">Подача заявок</a>
                            <a class="dropdown-item" href="/Home/PoiskRedaktZayavok">Поиск и редактирование заявок</a>
                            <a class="dropdown-item" href="/Home/RassmotreniyeZayavok">Рассмотрение заявок</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown" id="b">
                        <a class="nav-link dropdown-toggle" href="accounting.html" id="accounting" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Бухгалтерия</a>
                        <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="accounting">
                            <a class="dropdown-item" href="/Home/VvodDannix">Ввод данных</a>
                            <a class="dropdown-item" href="/Home/BU_PrasmotrDannix">Просмотр</a>
                            <a class="dropdown-item" href="/Home/OsushestvleniyeProvodki">Осуществление проводки</a>
                            <a class="dropdown-item" href="/PlatejnoyePorucheniye/Index">Платежные поручения</a>
                            <a class="dropdown-item" href="/Home/Nakladniye">Накладные</a>
                            <a class="dropdown-item" href="/Home/PlanByudjetaOblastey">План бюджета областей</a>
                            <a class="dropdown-item" href="/Home/RaspredleniyeByudjeta">Распределение бюджета по отраслям</a>
                        </div>
                    </li>
                    <li class="nav-item" id="o">
                        <a class="nav-link" href="/Home/Otchot">Отчеты</a>
                    </li>
                    <li class="nav-item dropdown" id="a">
                        <a class="nav-link dropdown-toggle" href="administration.html" id="administration" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Администрирование</a>
                        <div class="dropdown-menu rounded-0 box-shadow m-0 border-0" aria-labelledby="administration">
                            <a class="dropdown-item" href="/Administirirovaniye/UchetniyZapis">Создание учетных записей</a>
                            <a class="dropdown-item" href="/Administirirovaniye/SozdaniyeRoley">Создание ролей</a>
                            <a class="dropdown-item" href="/Administirirovaniye/SozdaniyeProvodok">Создание проводок</a>
                            <a class="dropdown-item" href="/Administirirovaniye/PrivyazkaProvodok">Привязка проводок к ЖО</a>
                            <a class="dropdown-item" href="/Administirirovaniye/Spravichniki">Справочники</a>
                            <a class="dropdown-item" href="/Administirirovaniye/SpravichnikiKurortnovoUpravleniya">Справочник с курортного управления</a>
                        </div>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><p style="margin-top:21px">@Session["name"]</p></li>
                    <li class="nav-item">
                        <a class="nav-link" id="ch" href="#">Выход</a>
                    </li>
                </ul>
                <script>
                    //$(".load").on('click', function () {
                    //    document.getElementById('conn').style.visibility = "visible";
                    //});
                        $("#ch").on('click', function () {
                        $("#hh").modal({
                            backdrop: 'static',
                            backdrop: 'static'
                        });
                        reset();
                        alertify.set({ buttonFocus: "cancel" });
                        alertify.confirm("Rostdan ham chiqmoqchimisiz?", function (e) {
                            if (e) {
                                alertify.success("Операция выполняется");
                                window.location.href = "/Login/SignOut";
                            } else {
                                $("#hh").modal('hide');
                                alertify.error("Операция отменена");
                            }
                        });
                        return false;
                    });
                </script>
                <script>
                var i = 0;
                if ("@ViewBag.Title" == "Подача заявок") {
                    document.getElementById("z").className = "nav-item dropdown show";
                    document.getElementById("z").style = "";
                    }
                        if ("@ViewBag.Title" == "Путевки") {
                            document.getElementById("p").className = "nav-item dropdown show";
                            document.getElementById("p").style = "";
                        }
                        if ("@ViewBag.Title" == "Отчеты") {
                            document.getElementById("o").className = "nav-item dropdown show";
                            document.getElementById("o").style = "";
                        }
                        if ("@ViewBag.Title" == "Администрирование") {
                            document.getElementById("a").className = "nav-item dropdown show";
                            document.getElementById("a").style = "";
                        }
                        if ("@ViewBag.Title" == "бухгалтерия") {
                            document.getElementById("b").className = "nav-item dropdown show";
                            document.getElementById("b").style = "";
                        }
                </script>
            </div>
        </div>
    </nav>
    <div class="body-content">
        @RenderBody()
    </div>
    <script src="~/Scripts/vendor.js"></script>

    <script src="~/Scripts/plugins.js"></script>

    <script src="~/Scripts/main.js"></script>
    <style>
        .active {
            color: black;
            background-color: white;
        }
         .poin:hover {
            cursor: pointer;
        }
    </style>
    <input id="hh" type="hidden" />
    @*@Scripts.Render("~/bundles/jquery")*@
    @*@Scripts.Render("~/bundles/bootstrap")*@
    @RenderSection("scripts", required: false)
</body>
</html>
