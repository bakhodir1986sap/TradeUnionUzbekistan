                        }

                        @if (userName.CurLang == "uz")
                        {
                            <a href="/Home/Putyovki?lang=uz" class="nav-link dropdown-toggle" data-toggle="dropdown" id="tourss" aria-haspopup="true" aria-expanded="false"><img src="~/Content/images/Uzbekistan-icon.png" />&nbsp UZB</a>
                        }

