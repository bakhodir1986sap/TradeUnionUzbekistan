                <script>
                    //$(".load").on('click', function () {
                    //    document.getElementById('conn').style.visibility = "visible";
                    //});
                        $("#ch").on('click', function () {
                            document.getElementById('conn').style.visibility = "visible";
                        $("#hh").modal({
                            backdrop: 'static',
                            backdrop: 'static'
                        });
                        reset();
                        alertify.set({ buttonFocus: "cancel" });
                        alertify.confirm("Rostdan ham chiqmoqchimisiz?", function (e) {
                            if (e) {
                                alertify.success("xayr!!!");
                                window.location.href = "/Login/SignOut";
                            } else {
                                $("#hh").modal('hide');
                                document.getElementById('conn').style.visibility = "hidden";
                                alertify.error("Siz chiqishni inkor qildingiz");
                            }
                        });
                        return false;
                    });
