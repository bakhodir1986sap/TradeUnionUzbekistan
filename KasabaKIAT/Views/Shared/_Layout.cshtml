    <script>
        function reset() {
            $("#toggleCSS").attr("href", "../Content/themes/alertify.default.css");
            alertify.set({
                labels: {
                    ok: "Да",
                    cancel: "Нет"
                },
                delay: 5000,
                buttonReverse: false,
                buttonFocus: "ok"
            });
        }
    </script>
</head>
<body>
