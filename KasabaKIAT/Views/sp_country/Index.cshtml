@model PagedList.IPagedList<KasabaKIAT.Models.sp_country>
@using PagedList.Mvc;
@using Syncfusion.EJ2
@*<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />*@
@{
    /**/

    ViewBag.Title = "Справочник Стран";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4>Справочник Стран</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Справочник Стран</li>
        </ol>
    </nav>
</div>

@Html.EJS().Grid("country").DataSource(dataManager => { dataManager.Url("/sp_country/UrlDatasource").InsertUrl("/sp_country/Insert").UpdateUrl("/sp_country/Update").RemoveUrl("/sp_country/Remove").Adaptor("UrlAdaptor"); }).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=> {
    col.Field("id").HeaderText("ID").Width("10").IsPrimaryKey(true).AllowEditing(false).DefaultValue("1").Add();
    col.Field("code").HeaderText("Код").Width("10").Add();
    col.Field("create_date").HeaderText("Дата создания").Width("10").AllowEditing(false).Add();
    col.Field("name_ru").HeaderText("Название_Ру").Width("40").Add();
    col.Field("name_uz").HeaderText("Название_Уз").Width("40").Add();
    col.Field("name_uzl").HeaderText("Название_Узл").Width("40").Add();
}).AllowPaging().PageSettings(page=>page.PageCount(5)).EditSettings(edit => { edit.AllowAdding(true).AllowEditing(true).AllowDeleting(true).ShowDeleteConfirmDialog(true).Mode(Syncfusion.EJ2.Grids.EditMode.Dialog);}).Toolbar(new List<string>
    () { "Add", "Edit", "Delete", "ExcelExport" }).Render()

<script>
    function toolbarClick(args) {
        var gridObj = document.getElementById("country").ej2_instances[0];
        if (args.item.id === 'country_excelexport') {
            gridObj.excelExport();
        }
    }
</script>