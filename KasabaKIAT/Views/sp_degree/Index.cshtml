@model IEnumerable<KasabaKIAT.Models.sp_degree>

@{
    ViewBag.Title = "Справочники Званий";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Справочники Званий</h2>

<p>
    @Html.ActionLink("Создать новый", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.version)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.s_comment)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.s_create)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.s_status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.name_ru)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.name_uz)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.name_uzl)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NATIVE_ID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.users.email)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.version)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.s_comment)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.s_create)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.s_status)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.name_ru)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.name_uz)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.name_uzl)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NATIVE_ID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.users.email)
        </td>
        <td>
            @Html.ActionLink("Изменить", "Edit", new { id=item.id }) |
            @Html.ActionLink("Детали", "Details", new { id=item.id }) |
            @Html.ActionLink("Удалить", "Delete", new { id=item.id })
        </td>
    </tr>
}

</table>
