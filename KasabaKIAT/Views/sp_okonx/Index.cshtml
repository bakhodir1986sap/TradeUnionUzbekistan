@model PagedList.IPagedList<KasabaKIAT.Models.sp_okonx>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
@{
    ViewBag.Title = "Справочник ОКОНХ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4 style="margin-top:15px">Справочник ОКОНХ</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Справочник ОКОНХ</li>
        </ol>
    </nav>
</div>
<style>

    td, th {
        vertical-align: middle !important;
        text-align: center;
    }
</style>
<p>
    <button style="margin:10px" class="btn btn-white">@Html.ActionLink("Добавить", "Create")</button>
</p>
<table class="table">
    <tr>
        <th>
            Версия
        </th>
        <th>
            Код
        </th>
        <th>
            Коммент
        </th>
        <th>
            Создан
        </th>
        <th>
            Статус
        </th>
        <th>
            Название_Ру
        </th>
        <th>
            Название_Уз
        </th>
        <th>
            Название_Узлат
        </th>
        <th>
            Ключи
        </th>
        <th>
            Отрасль
        </th>
        <th>
            Натив Код
        </th>
        <th>
            Пользователь
        </th>
        <th>
            Код2
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.version)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.s_comment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.s_create)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.s_status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.name_ru)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.name_uz)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.name_uzl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.keys)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.branch_code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NATIVE_ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.users.email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.sp_okonx2.code)
            </td>
            <td>
                @Html.ActionLink("Изменить", "Edit", new { id = item.id }) |
                @Html.ActionLink("Детали", "Details", new { id = item.id }) |
                @Html.ActionLink("Удалить", "Delete", new { id = item.id })
            </td>
        </tr>
    }

</table>
<br />
Страница @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) из @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { page }))