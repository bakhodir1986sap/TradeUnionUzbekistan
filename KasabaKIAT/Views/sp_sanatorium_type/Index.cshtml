@model IEnumerable<KasabaKIAT.Models.sp_sanatorium_type>
@using Syncfusion.EJ2
@{
    ViewBag.Title = "Справочник Типов санаториев";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4 style="margin-top:15px">Справочник Типов санаториев</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Справочник Типов санаторий</li>
        </ol>
    </nav>
</div>
@Html.EJS().Grid("profil").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowSorting().AllowPdfExport().ToolbarClick("toolbarClick").Columns(col=> {

    //col.Field("version").HeaderText("Версия").Width("10").Add();
    col.Field("code").HeaderText("Код").Width("10").Add();
    //col.Field("s_comment").HeaderText("Комментарий").Width("10").Add();
    col.Field("create_date").HeaderText("Дата создания").Width("10").Add();
    //col.Field("s_status").HeaderText("s_status").Width("10").Add();
    col.Field("name_ru").HeaderText("Название_Ру").Width("40").Add();
    col.Field("name_uz").HeaderText("Название_Уз").Width("40").Add();
    col.Field("name_uzl").HeaderText("Название_Узл").Width("40").Add();
    //col.Field("NATIVE_ID").HeaderText("NATIVE_ID").Width("10").Add();
    //col.Field("email").HeaderText("Юзер").Width("10").Add();
}).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).EditSettings(edit => { edit.AllowAdding(true).AllowEditing(true).AllowDeleting(true).Mode(Syncfusion.EJ2.Grids.EditMode.Dialog);}).Toolbar(new List<string>() { "Add", "Edit", "Delete", "PdfExport" }).Render()

