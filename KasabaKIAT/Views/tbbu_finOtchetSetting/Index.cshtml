@model PagedList.IPagedList<KasabaKIAT.Models.tbbu_finOtchetSetting>
@using PagedList.Mvc;
@using Syncfusion.EJ2

@{
    ViewBag.Title = "Справочник Финансового отчета";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.EJS().Grid("branch").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowSorting().AllowPdfExport().ToolbarClick("toolbarClick").Columns(col=> {
    col.Field("otchet_part").HeaderText("otchet_part").Width("10").Add();
    col.Field("code").HeaderText("code").Width("10").Add();
    col.Field("debit_side").HeaderText("debit_side").Width("10").Add();

    col.Field("credit_side").HeaderText("credit_side").Width("10").Add();
    col.Field("account_code").HeaderText("account_code").Width("10").Add();

    col.Field("data_type").HeaderText("data_type").Width("40").Add();
    col.Field("data_desc").HeaderText("data_desc").Width("40").Add();
    col.Field("department_base").HeaderText("department_base").Width("40").Add();
    //col.Field("NATIVE_ID").HeaderText("NATIVE_ID").Width("10").Add();
    //col.Field("email").HeaderText("Юзер").Width("10").Add();
}).AllowPaging().AllowFiltering().AllowResizing().PageSettings(page=>page.PageCount(5)).EditSettings(edit => { edit.AllowAdding(true).AllowEditing(true).AllowDeleting(true).Mode(Syncfusion.EJ2.Grids.EditMode.Dialog);}).Toolbar(new List<string>() { "Add", "Edit", "Delete", "PdfExport" }).Render()

<script>
        function toolbarClick(args) {
            var gridObj = document.getElementById("Grid").ej2_instances[0];
            if (args.item.id === 'Grid_pdfexport') {
                gridObj.pdfExport();
            }
        }
</script>

