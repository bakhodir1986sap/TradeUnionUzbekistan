@model PagedList.IPagedList<KasabaKIAT.Models.tblSprav_MFO>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = "Справочник Банков";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4 style="margin-top:15px">Справочник Банков</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Справочник Банков</li>
        </ol>
    </nav>
</div>
<style>

    td, th {
        vertical-align: middle !important;
    }

    ;
</style>
<p>
    <button style="margin:10px" class="btn btn-white">@Html.ActionLink("Добавить", "Create")</button>
</p>
<table class="table">
    <tr>
        <th>
            "Code_MFO"
        </th>
        <th>
            "Name_MFO"
        </th>
        <th>
            "Adres_MFO"
        </th>
        <th>
            "Data_Act"
        </th>
        <th>
            "Data_Cls"
        </th>
        <th>
            "users"
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Code_MFO)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name_MFO)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Adres_MFO)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data_Act)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data_Cls)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.users.email)
            </td>
            <td>
                @Html.ActionLink("Изменить", "Edit", new { id = item.ID }) |
                @Html.ActionLink("Детали", "Details", new { id = item.ID }) |
                @Html.ActionLink("Удалить", "Delete", new { id = item.ID })
            </td>
        </tr>
    }

</table>
Страница @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) из @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { page }))