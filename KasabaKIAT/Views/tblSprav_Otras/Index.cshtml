@model IEnumerable<KasabaKIAT.Models.tblSprav_Otras>

@{
    ViewBag.Title = "Справочники Отраслей";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Справочники Отраслей</h2>

<p>
    @Html.ActionLink("Создать новый", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.ID_Ot)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name_Ot)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Priz)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DepartmentBase)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BRANCH_CODE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.users.email)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.ID_Ot)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name_Ot)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Priz)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DepartmentBase)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BRANCH_CODE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.users.email)
        </td>
        <td>
            @Html.ActionLink("Изменить", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Детали", "Details", new { id=item.ID }) |
            @Html.ActionLink("Удалить", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
