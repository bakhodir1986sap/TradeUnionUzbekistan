@model IEnumerable<KasabaKIAT.Models.tblSprav_Reg>

@{
    ViewBag.Title = "Справочник Регионов";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4 style="margin-top:15px">Справочник Регионов</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Справочник Регионов</li>
        </ol>
    </nav>
</div>
<style>

    td, th{
        vertical-align: middle !important;
        text-align: center;
    };
    
</style>
<p>
    <button style="margin:10px" class="btn btn-white">@Html.ActionLink("Добавить", "Create")</button>
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NameReg)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CodeReg)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DepartmentBase)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.VilId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SOATO_CODE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.users.email)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NameReg)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CodeReg)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DepartmentBase)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.VilId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SOATO_CODE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.users.email)
        </td>
        <td>
            @Html.ActionLink("Изменить", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Детали", "Details", new { id=item.ID }) |
            @Html.ActionLink("Удалить", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
