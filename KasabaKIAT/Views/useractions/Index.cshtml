    <div class="table-responsive box-shadow mb-4" id="export">
        @Html.EJS().Grid("useraction").DataSource((IEnumerable<object>)ViewBag.dataSource).AllowExcelExport().ToolbarClick("toolbarClick").Columns(col=> {
        col.Field("id").HeaderText("Номер").Width("50").Add();
        col.Field("accesstime").HeaderText("Дата").Width("50").Add();
        col.Field("action").HeaderText("Действие").Width("50").Add();
        col.Field("classname").HeaderText("Модуль").Width("50").Add();
        col.Field("object_name").HeaderText("IP Адрес").Width("50").Add();
        col.Field("email").HeaderText("Пользователь").Width("50").Add();
        }).AllowPaging().AllowFiltering().AllowResizing().AllowGrouping().AllowResizing().PageSettings(page=>page.PageCount(5)).Toolbar(new List<string>
        () { "ExcelExport" }).Render()
        <script>
            function toolbarClick(args) {
                var gridObj = document.getElementById("useraction").ej2_instances[0];
                if (args.item.id === 'useraction_excelexport') {
                    gridObj.excelExport();
                }
            }
        </script>



