@model PagedList.IPagedList<KasabaKIAT.Models.useractions>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
@{
    ViewBag.Title = "Действия пользователей";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-sm-6 title__block">
    <h4 style="margin-top:15px">Действия пользователей</h4>
    <nav aria-label="breadcrumb" class="breadcrumb__block">
        <ol class="breadcrumb" style="width:1000px">
            <li class="breadcrumb-item load"><a href="/Administirirovaniye/Spravichniki">Справочник</a></li>
            <li class="breadcrumb-item active" aria-current="page">Действия пользователей</li>
        </ol>
    </nav>
</div>
    <style>
        td, th {
            vertical-align: middle !important;
            text-align: center;
        }
    </style>
    @*<p>
        <button style="margin:10px" class="btn btn-white">@Html.ActionLink("Добавить", "Create")</button>
    </p>*@
    <table class="table">
        <tr>
            <th>
                Версия
            </th>
            <th>
                Дата
            </th>
            <th>
                Действие
            </th>
            <th>
                Модуль
            </th>
            <th>
                IP Адрес
            </th>
            <th>
                Пользователь
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.version)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.accesstime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.action)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.classname)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.object_name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.users.email)
                </td>
                @*<td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.id })
                </td>*@
            </tr>
        }

    </table>
    Страница @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) из @Model.PageCount

    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))

